#!/bin/env bpftrace
/**
 * _dl_start.bt - Tracing ld linker _dl_start()
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2024-01-08	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing _dl_start, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s\n", "TIME", "PID", "COMM");
}

uprobe:/lib64/ld-linux-x86-64.so.2:_dl_start
{
	time("%H:%M:%S ");
	printf("%-8d %-16s\n", pid, comm);
}

END
{
	printf("Bye.\n");
}
