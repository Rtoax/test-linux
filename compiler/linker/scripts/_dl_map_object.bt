#!/bin/env bpftrace
/**
 * _dl_map_object.bt - Tracing ld linker _dl_map_object()
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2024-04-16	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing _dl_map_object, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s\n",
		"TIME", "PID", "COMM", "NAME");
}

uprobe:/lib64/ld-linux-x86-64.so.2:_dl_map_object
{
	$name = str(arg1);

	time("%H:%M:%S ");
	printf("%-8d %-16s %s\n", pid, comm, $name);
}

END
{
	printf("Bye.\n");
}
