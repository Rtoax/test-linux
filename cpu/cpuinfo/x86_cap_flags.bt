#!/bin/env bpftrace
/**
 * File: x86_cap_flags.bt
 * Author: Rong Tao
 * Date: 2023-04-28
 *
 */
BEGIN
{
	$flags = kaddr("x86_cap_flags");

	$i = 0;
	/* 32 * 19 = 608 */
	printf("flags: ");
	unroll (100) {
		$flag = *($flags + $i);
		if (str($flag) != "") {
			printf(" %s", str($flag));
		}

		$i++;
	}
	printf("\n");

	exit();
}

