set -e

error() {
	echo -e >&2 "${RED}ERROR: ${@}${RST}"
	exit 1
}

warning() {
	echo -e >&2 "${RED}WARNING: ${@}${RST}"
}

readonly prog=pytorch-compile
declare -a cmake_args cmake_build_args
declare flags_deps flags_cmake flags_build flags_wheel
declare nr_jobs
declare dry_run
declare verbose

readonly ID=$(grep -oP '(?<=^ID=).+' /etc/os-release | tr -d '"')
readonly VERSION_ID=$(grep -oP '(?<=^VERSION_ID=).+' /etc/os-release | tr -d '"')

readonly CUDA_MAJOR="$(nvcc --version | grep -oE 'V[1-9]+' | tr -d V || true)"
readonly CLANG_MAJOR="$(clang -dumpversion | grep -oE '^[0-9]+' || true)"

__usage__()
{
	echo -e "
NAME
	${prog} - Compile pytorch

SYNOPSIS
	${prog} [--config] [--build] [--help] [--verbose]

DESCRIPTION
	Compile pytorch.

ARGUMENT
	-d, --deps              execute depends installation
	-c, --config            execute configuration to generate Makefile
	-b, --build             execute the build
	-w, --wheel             generate pip wheel

	-j, --jobs [N]          set number of jobs
	-u, --dry-run           do nothing except show commands
	-v, --verbose           run with verbose mode
	-h, --help              show this info

EXAMPLES
	$ ./compile -d -c -b -w

LINKS
	https://github.com/pytorch/pytorch/

SEE ALSO
"
	exit ${1-0}
}

_eval()
{
	if [[ -z ${dry_run} ]]; then
		echo >&2 -e "\033[1;32mStartup: $@\033[m"
		eval "$@"
		echo >&2 -e "\033[1;33mDone: $@\033[m"
	else
		echo "$@"
	fi
}

_eval_s()
{
	_eval sudo "$@"
}

TEMP_ARGS=$(getopt --options cdbwj:uvh \
	--long deps \
	--long cmake \
	--long wheel \
	--long jobs: \
	--long verbose \
	--long dry-run \
	--long help \
	--name ${prog} -- "$@")

test $? != 0 && __usage__ 1

eval set -- "$TEMP_ARGS"

while true; do
	case $1 in
	-d | --deps)
		shift
		flags_deps=YES
		;;
	-c | --cmake)
		shift
		flags_cmake=YES
		;;
	-b | --build)
		shift
		flags_build=YES
		;;
	-w | --wheel)
		shift
		flags_wheel=YES
		;;
	-j | --jobs)
		shift
		nr_jobs=$1
		shift
		;;
	-u | --dry-run)
		shift
		dry_run=YES
		;;
	-v | --verbose)
		shift
		verbose=YES
		;;
	-h | --help)
		shift
		__usage__
		;;
	--)
		shift
		break
		;;
	esac
done

if [[ -z ${dry_run} ]] && [[ ${verbose} ]]; then
	export PS4='+${BASH_SOURCE}:${LINENO}:${FUNCNAME[0]}: '
	set -x
fi

_root=$PWD
if [[ ! -e ${_root}/version.txt ]]; then
	if [[ -e ${_root}/../version.txt ]]; then
		_root=$(realpath ${_root}/../)
	elif [[ -e ${_root}/../../version.txt ]]; then
		_root=$(realpath ${_root}/../../)
	elif [[ ${flags_cmake} ]] || \
	     [[ ${flags_build} ]] || \
	     [[ ${flags_wheel} ]]; then
		error "you are not in pytorch git repositry"
	fi
	_root=""
fi

readonly PYTORCH_ROOT=${_root}

# see pytorch/.ci/docker/common/install_base.sh
install_apt_base() {
	local ccache_deps="asciidoc docbook-xml docbook-xsl xsltproc"
	local deploy_deps="libffi-dev libbz2-dev libreadline-dev libncurses5-dev libncursesw5-dev libgdbm-dev libsqlite3-dev uuid-dev tk-dev"
	local numpy_deps="gfortran"

	if [[ " ubuntu " =~ " ${ID} " ]]; then
		_eval_s apt install -y \
			$ccache_deps \
			$numpy_deps \
			$deploy_deps \
			cmake \
			apt-transport-https \
			autoconf \
			autoconf \
			automake \
			build-essential \
			ca-certificates \
			curl \
			git \
			libatlas-base-dev \
			libc6-dbg \
			libyaml-dev \
			libz-dev \
			libjemalloc2 \
			libjpeg-dev \
			libasound2-dev \
			libsndfile-dev \
			protobuf-compiler \
			software-properties-common \
			wget \
			sudo \
			vim \
			jq \
			libtool \
			vim \
			unzip \
			gpg-agent \
			gdb \
			bc

	elif [[ " debian " =~ " ${ID} " ]]; then
		_eval_s apt install -y cmake make ninja-build
		_eval_s apt install -y ccache libfp16-dev libasmjit-dev \
			libcpuinfo-dev libcufile-dev libeigen3-dev \
			libfmt-dev libfxdiv-dev libonnx-dev \
			libsleef-dev protobuf-compiler
	fi

	_eval_s apt install -y \
		libcpuinfo-dev libfp16-dev libonnx-dev libsleef-dev

}

# see pytorch/.ci/docker/common/install_clang.sh
install_apt_clang() {
	local clang_deps
	if [[ ${CLANG_MAJOR} -ge 18 ]]; then
		clang_deps+=" libomp-${CLANG_MAJOR}-dev"
		clang_deps+=" libclang-rt-${CLANG_MAJOR}-dev"
		clang_deps+=" clang-$CLANG_MAJOR"
		clang_deps+=" llvm-$CLANG_MAJOR"
	else
		error "not support clang ${CLANG_MAJOR}"
	fi

	if [[ " ubuntu " =~ " ${ID} " ]]; then
		_eval_s apt install -y ${clang_deps}
	fi
}

# see pytorch/.ci/docker/common/install_docs_reqs.sh
install_apt_docs_reqs() {
	_eval_s apt install -y doxygen
	if [[ " ubuntu " =~ " ${ID} " ]]; then
		_eval_s apt install -y yarn
		#_eval_s yarn global add katex --prefix /usr/local
	fi
}

install_apt_cuda() {
	local cuda_deps
	case ${CUDA_MAJOR} in
	13)
		cuda_deps+=" libcufile-${CUDA_MAJOR}-0"
		;;
	*)
		;;
	esac

	if [[ " ubuntu " =~ " ${ID} " ]]; then
		_eval_s apt install -y ${cuda_deps}
	fi
}

install_deps() {
	if [[ " debian ubuntu " =~ " ${ID} " ]]; then
		install_apt_base
		install_apt_clang
		install_apt_docs_reqs
	else
		_eval_s dnf install -y cpuinfo-devel
	fi
}

cmake_args+=(
	-DBUILD_CUSTOM_PROTOBUF=OFF
	-DBUILD_NVFUSER=OFF
	-DBUILD_SHARED_LIBS=ON
	-DBUILD_TEST=OFF
	-DCMAKE_BUILD_TYPE=RelWithDebInfo
	-DCMAKE_FIND_PACKAGE_PREFER_CONFIG=ON
	-DCAFFE2_LINK_LOCAL_PROTOBUF=OFF
	-DINTERN_BUILD_MOBILE=OFF
	-DUSE_DISTRIBUTED=OFF
	-DUSE_FBGEMM=OFF
	-DUSE_FLASH_ATTENTION=OFF
	-DUSE_GLOO=OFF
	-DUSE_ITT=OFF
	-DUSE_KINETO=OFF
	-DUSE_KLEIDIAI=OFF
	-DUSE_LITE_INTERPRETER_PROFILER=OFF
	-DUSE_LITE_PROTO=OFF
	-DUSE_MAGMA=OFF
	-DUSE_MEM_EFF_ATTENTION=OFF
	-DUSE_MKLDNN=OFF
	-DUSE_MPI=OFF
	-DUSE_NCCL=OFF
	-DUSE_NNPACK=OFF
	-DUSE_NUMPY=ON
	-DUSE_OPENMP=ON
	-DUSE_PYTORCH_QNNPACK=OFF
	-DUSE_ROCM=OFF
	-DUSE_SYSTEM_SLEEF=ON
	-DUSE_SYSTEM_EIGEN_INSTALL=ON
	-DUSE_SYSTEM_ONNX=ON
	-DUSE_SYSTEM_PYBIND11=OFF
	-DUSE_SYSTEM_LIBS=OFF
	-DUSE_SYSTEM_NCCL=OFF
	-DUSE_TENSORPIPE=OFF
	-DUSE_XNNPACK=OFF
	-DUSE_XPU=OFF
	-DUSE_SYSTEM_PTHREADPOOL=ON
	-DUSE_SYSTEM_CPUINFO=ON
	-DUSE_SYSTEM_FP16=ON
	-DUSE_SYSTEM_FXDIV=ON
	-DUSE_SYSTEM_PSIMD=ON
	-DUSE_SYSTEM_XNNPACK=OFF
)

CUDA_TOOLKIT_ROOT_DIR=
if [[ -e /usr/local/cuda/bin/nvcc ]]; then
	CUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda/
elif [[ -e /usr/bin/nvcc ]]; then
	CUDA_TOOLKIT_ROOT_DIR=/usr/
fi

if [[ ${CUDA_TOOLKIT_ROOT_DIR} ]]; then
	cmake_args+=( -DUSE_CUDA=ON )
	cmake_args+=( -DCUDA_TOOLKIT_ROOT_DIR=${CUDA_TOOLKIT_ROOT_DIR} )
	cmake_args+=( -DCMAKE_CUDA_COMPILER=${CUDA_TOOLKIT_ROOT_DIR}/bin/nvcc )
	# see pytorch/cmake/Modules_CUDA_fix/upstream/FindCUDA/select_compute_arch.cmake
	# CUDA_ARCH_LIST=[All|Common|Auto]
	cmake_args+=( -DTORCH_CUDA_ARCH_LIST=Auto )
	# You could install cudnn:
	# debian: $ sudo apt install -y nvidia-cudnn
	cmake_args+=( -DCUDNN_INCLUDE_DIR=/usr/include )
	cmake_args+=( -DCUDNN_LIBRARY=/usr/lib64/libcudnn.so )
else
	warning "Not found CUDA Toolkit"
fi

# Use third_party/cpuinfo first instead use system library if compile newest,
# see commit cd15f7275858 ("pytorch: compile: use third_party/cpuinfo first")
if [[ -e ${PYTORCH_ROOT}/third_party/cpuinfo/README.md ]]; then
	cmake_args+=( -DUSE_SYSTEM_CPUINFO=OFF )
fi

# If use submodule onnx, need to install protobuf-compiler
if [[ -e ${PYTORCH_ROOT}/third_party/onnx/README.md ]]; then
	cmake_args+=( -DUSE_SYSTEM_ONNX=OFF )
fi

HIPCONFIG=$(which hipconfig 2>/dev/null || :)
if [[ ! -z "${HIPCONFIG}" ]]; then
	cmake_args+=( -DUSE_ROCM=ON )
	cmake_args+=( -DUSE_ROCM_CK=OFF )
	cmake_args+=( -DUSE_MAGMA=ON )
	cmake_args+=( -DHIP_PATH=$(${HIPCONFIG} -p) )
	cmake_args+=( -DROCM_PATH=$(${HIPCONFIG} -R) )

	export PYTORCH_ROCM_ARCH="gfx900;gfx906:xnack-;gfx908:xnack-;gfx90a:xnack+;gfx90a:xnack-;gfx942;gfx950;gfx1010;gfx1012;gfx1030;gfx1031;gfx1035;gfx1100;gfx1101;gfx1102;gfx1103;gfx1150;gfx1151;gfx1152;gfx1153;gfx1200;gfx1201"
	cmake_args+=( -DPYTORCH_ROCM_ARCH="'${PYTORCH_ROCM_ARCH}'" )
fi
cmake_args+=( -DPython_EXECUTABLE=$(which python3) )
cmake_args+=( -DCMAKE_INSTALL_PREFIX=$PWD/pytorch-install )
cmake_args+=( -G Ninja )

if [[ ${nr_jobs} ]]; then
	cmake_build_args+=( --parallel ${nr_jobs} )
	export MAX_JOBS=${nr_jobs}
else
	export MAX_JOBS=1
fi

if [[ ${flags_deps} ]]; then
	install_deps
fi

if [[ ${flags_cmake} ]]; then
	_eval_s cmake .. "${cmake_args[@]}"
fi

if [[ ${flags_build} ]]; then
	_eval_s cmake --build . "${cmake_build_args[@]}"
fi

if [[ ${flags_wheel} ]]; then
	_eval pushd ${PYTORCH_ROOT}
	_eval_s python3 setup.py bdist_wheel
	_eval popd
fi
