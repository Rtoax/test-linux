#!/bin/env bpftrace

#define PF_UNSPEC	0	/* Unspecified.  */
#define PF_LOCAL	1	/* Local to host (pipes and file-domain).  */
#define PF_UNIX		PF_LOCAL /* POSIX name for PF_LOCAL.  */
#define PF_FILE		PF_LOCAL /* Another non-standard name for PF_LOCAL.  */
#define PF_INET		2	/* IP protocol family.  */
#define PF_AX25		3	/* Amateur Radio AX.25.  */
#define PF_IPX		4	/* Novell Internet Protocol.  */
#define PF_APPLETALK	5	/* Appletalk DDP.  */
#define PF_NETROM	6	/* Amateur radio NetROM.  */
#define PF_BRIDGE	7	/* Multiprotocol bridge.  */
#define PF_ATMPVC	8	/* ATM PVCs.  */
#define PF_X25		9	/* Reserved for X.25 project.  */
#define PF_INET6	10	/* IP version 6.  */
#define PF_ROSE		11	/* Amateur Radio X.25 PLP.  */
#define PF_DECnet	12	/* Reserved for DECnet project.  */
#define PF_NETBEUI	13	/* Reserved for 802.2LLC project.  */
#define PF_SECURITY	14	/* Security callback pseudo AF.  */
#define PF_KEY		15	/* PF_KEY key management API.  */
#define PF_NETLINK	16
#define PF_ROUTE	PF_NETLINK /* Alias to emulate 4.4BSD.  */
#define PF_PACKET	17	/* Packet family.  */
#define PF_ASH		18	/* Ash.  */
#define PF_ECONET	19	/* Acorn Econet.  */
#define PF_ATMSVC	20	/* ATM SVCs.  */
#define PF_RDS		21	/* RDS sockets.  */
#define PF_SNA		22	/* Linux SNA Project */
#define PF_IRDA		23	/* IRDA sockets.  */
#define PF_PPPOX	24	/* PPPoX sockets.  */
#define PF_WANPIPE	25	/* Wanpipe API sockets.  */
#define PF_LLC		26	/* Linux LLC.  */
#define PF_IB		27	/* Native InfiniBand address.  */
#define PF_MPLS		28	/* MPLS.  */
#define PF_CAN		29	/* Controller Area Network.  */
#define PF_TIPC		30	/* TIPC sockets.  */
#define PF_BLUETOOTH	31	/* Bluetooth sockets.  */
#define PF_IUCV		32	/* IUCV sockets.  */
#define PF_RXRPC	33	/* RxRPC sockets.  */
#define PF_ISDN		34	/* mISDN sockets.  */
#define PF_PHONET	35	/* Phonet sockets.  */
#define PF_IEEE802154	36	/* IEEE 802.15.4 sockets.  */
#define PF_CAIF		37	/* CAIF sockets.  */
#define PF_ALG		38	/* Algorithm sockets.  */
#define PF_NFC		39	/* NFC sockets.  */
#define PF_VSOCK	40	/* vSockets.  */
#define PF_KCM		41	/* Kernel Connection Multiplexor.  */
#define PF_QIPCRTR	42	/* Qualcomm IPC Router.  */
#define PF_SMC		43	/* SMC sockets.  */
#define PF_XDP		44	/* XDP sockets.  */
#define PF_MCTP		45	/* Management component transport protocol.  */

#define SOCK_STREAM	1
#define SOCK_DGRAM	2
#define SOCK_RAW	3
#define SOCK_RDM	4
#define SOCK_SEQPACKET	5
#define SOCK_DCCP	6
#define SOCK_PACKET	10
#define SOCK_TYPE_MASK	0xf

#define SOCK_CLOEXEC	02000000

#define NETLINK_KOBJECT_UEVENT	15

BEGIN
{
	@FAMILY[PF_UNSPEC] = "UNSPEC";
	@FAMILY[PF_LOCAL] = "LOCAL|UNIX|FILE";
	@FAMILY[PF_INET] = "INET";
	@FAMILY[PF_AX25] = "AX25";
	@FAMILY[PF_IPX] = "IPX";
	@FAMILY[PF_APPLETALK] = "APPLETALK";
	@FAMILY[PF_NETROM] = "NETROM";
	@FAMILY[PF_BRIDGE] = "BRIDGE";
	@FAMILY[PF_ATMPVC] = "ATMPVC";
	@FAMILY[PF_X25] = "X25";
	@FAMILY[PF_INET6] = "INET6";
	@FAMILY[PF_ROSE] = "ROSE";
	@FAMILY[PF_DECnet] = "DECnet";
	@FAMILY[PF_NETBEUI] = "NETBEUI";
	@FAMILY[PF_SECURITY] = "SECURITY";
	@FAMILY[PF_KEY] = "KEY";
	@FAMILY[PF_NETLINK] = "NETLINK|ROUTE";
	@FAMILY[PF_PACKET] = "PACKET";
	@FAMILY[PF_ASH] = "ASH";
	@FAMILY[PF_ECONET] = "ECONET";
	@FAMILY[PF_ATMSVC] = "ATMSVC";
	@FAMILY[PF_RDS] = "RDS";
	@FAMILY[PF_SNA] = "SNA";
	@FAMILY[PF_IRDA] = "IRDA";
	@FAMILY[PF_PPPOX] = "PPPOX";
	@FAMILY[PF_WANPIPE] = "WANPIPE";
	@FAMILY[PF_LLC] = "LLC";
	@FAMILY[PF_IB] = "IB";
	@FAMILY[PF_MPLS] = "MPLS";
	@FAMILY[PF_CAN] = "CAN";
	@FAMILY[PF_TIPC] = "TIPC";
	@FAMILY[PF_BLUETOOTH] = "BLUETOOTH";
	@FAMILY[PF_IUCV] = "IUCV";
	@FAMILY[PF_RXRPC] = "RXRPC";
	@FAMILY[PF_ISDN] = "ISDN";
	@FAMILY[PF_PHONET] = "PHONET";
	@FAMILY[PF_IEEE802154] = "IEEE802154";
	@FAMILY[PF_CAIF] = "CAIF";
	@FAMILY[PF_ALG] = "ALG";
	@FAMILY[PF_NFC] = "NFC";
	@FAMILY[PF_VSOCK] = "VSOCK";
	@FAMILY[PF_KCM] = "KCM";
	@FAMILY[PF_QIPCRTR] = "QIPCRTR";
	@FAMILY[PF_SMC] = "SMC";
	@FAMILY[PF_XDP] = "XDP";
	@FAMILY[PF_MCTP] = "MCTP";

	@TYPE[SOCK_STREAM] = "STREAM";
	@TYPE[SOCK_DGRAM] = "DGRAM";
	@TYPE[SOCK_RAW] = "RAW";
	@TYPE[SOCK_RDM] = "RDM";
	@TYPE[SOCK_SEQPACKET] = "SEQPACKET";
	@TYPE[SOCK_DCCP] = "DCCP";
	@TYPE[SOCK_PACKET] = "PACKET";

	@PROTOCOL[0] = "0";
	@PROTOCOL[NETLINK_KOBJECT_UEVENT] = "NETLINK_KOBJECT_UEVENT";

	printf("Tracing socket(2), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-16s %-16s %-16s %-4s\n", "TIME", "PID",
		"COMM", "FAMILY", "TYPE", "PROTOCOL", "FD");
}

tracepoint:syscalls:sys_enter_socket
{
	@family[tid] = args->family;
	@type[tid] = args->type;
	@protocol[tid] = args->protocol;
}

tracepoint:syscalls:sys_exit_socket
/ @family[tid] /
{
	$family = @family[tid];
	$type = @type[tid];
	$protocol = @protocol[tid];

	time("%H:%M:%S ");
	printf("%-8d %-16s", pid, comm);
	if (@FAMILY[$family] != "") {
		printf(" %-16s", @FAMILY[$family])
	} else {
		printf(" %-16ld", $family)
	}
	if (@TYPE[$type & SOCK_TYPE_MASK] != "") {
		printf(" %-16s", @TYPE[$type & SOCK_TYPE_MASK])
	} else {
		printf(" %-16ld", $type)
	}
	if (@PROTOCOL[$protocol] != "") {
		printf(" %-16s", @PROTOCOL[$protocol])
	} else {
		printf(" %-16ld", $protocol)
	}
	printf(" %-4d\n", args->ret);

	delete(@family[tid]);
	delete(@type[tid]);
	delete(@protocol[tid]);
}

END
{
	clear(@family);
	clear(@type);
	clear(@protocol);
	clear(@FAMILY);
	clear(@TYPE);
	clear(@PROTOCOL);
	printf("Bye.\n");
}
