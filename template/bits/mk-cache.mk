ifndef _BITS_MK_CACHE_MK
_BITS_MK_CACHE_MK = 1

include shell.mk

# Generate cache file
# $1: cache file
# $2: orignal file (optional)
define mkcache_generate
$(shell rm -f ${1} && echo > ${1})
$(shell sed -i "1i# Generated in $$(date '+%Y/%m/%d %H:%M:%S')" ${1})
$(if ${2}, \
  $(shell sed -i "1i# Origin file ${2}" ${1}) \
)
$(shell sed -i "1i# Cache file ${1}" ${1})
$(shell sed -i "1i# This file was generated by test-linux, do not modify it" ${1})
endef

# Append makefile variable to file and export it, better call
# mkcache_generate() first to create cache file.
#
# $1: variable append to cache file
# $2: cache file name
define mkcache_append
$(eval $(shell echo "export ${1} := ${${1}}" >> ${2}))
endef

endif
