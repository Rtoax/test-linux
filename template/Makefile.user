
TARGETS= \
	a.out \
	b.out

build: ${TARGETS}
	@echo
	@echo -e " \033[1;33m xxx \033[m"
	@echo -e " \033[1;33m xxx \033[m"

%.d: %.c
	@echo -e "Generate \033[1m$(@)\033[m"
	@$(CC) $(CFLAGS) -MM -MF "$@" -MG -MP -MT"$@" -MT"$(<:.c=.o)" $(<)

%.out: %.c %.d
	@echo -e "Compile  \033[1m$(<)\033[m to \033[1;31m$(@)\033[m"
	@$(CC) $(CFLAGS) -o $(@) $(<)

clean:
	rm -f ${TARGETS} *.o *.d
