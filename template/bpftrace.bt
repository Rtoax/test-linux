#!/bin/env bpftrace
/**
 * File:
 * Author:
 * Date:
 *
 * Description:
 * Ref:
 */
#include <linux/sched.h>

BEGIN
{
	printf("Tracing xxx, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

/* kprobe/kretprobe/kfunc/kretfunc/tracepoint/usdt/uprobe/uretprobe, etc. */
interval:s:1
{
	time("%H:%M:%S ");
	printf("%-8d %-8s\n", pid, comm);
}

END
{
	printf("Bye.\n");
}
