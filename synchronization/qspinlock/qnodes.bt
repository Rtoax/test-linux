#!/bin/env bpftrace
/**
 * qnodes.bt - Pre-CPU struct qnode print
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2023-10-26	Rong Tao	Create this.
 */
struct mcs_spinlock {
	struct mcs_spinlock *next;
	int locked;
	int count;
};
struct qnode {
	struct mcs_spinlock mcs;
}

interval:s:1
{
	$qnodes = (struct qnode *)kaddr("qnodes");
	$i = 0;

	/* 4: task, softirq, hardirq, nmi */
	unroll(4) {
		$qnode = $qnodes + $i;
		printf("%d locked %d, count %d\n", $i, $qnode->mcs.locked, $qnode->mcs.count);
		$i++;
	}
}

