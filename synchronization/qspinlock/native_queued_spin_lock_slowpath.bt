#!/bin/env bpftrace
/**
 * native_queued_spin_lock_slowpath.bt - Tracing qspinlock slowpath latency
 *
 * Copyright (C) Rong Tao 2022-2023
 *
 * 2023-10-25	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing qspinlock slowpath latency, hit ctrl-c to end.\n");
}

kprobe:native_queued_spin_lock_slowpath
{
	@start[tid] = nsecs;
}

kretprobe:native_queued_spin_lock_slowpath
/@start[tid]/
{
	$ns = (nsecs - @start[tid]);
	delete(@start[tid]);
	@hist_ns = hist($ns);
}

interval:s:1
{
	print(@hist_ns);
}

END
{
	clear(@start);
	printf("Bye.\n");
}

