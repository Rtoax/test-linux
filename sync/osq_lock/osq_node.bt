#!/bin/env bpftrace
/**
 * osq_node.bt - Pre-CPU optimistic_spin_node print
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2023-10-25	Rong Tao	Create this.
 */
//#include <linux/osq_lock.h>
struct optimistic_spin_node {
    struct optimistic_spin_node *next, *prev;
    int locked;
    int cpu;
};

BEGIN
{
	/**
	 * osq_node is per-CPU variable
	 *
	 * static DEFINE_PER_CPU_SHARED_ALIGNED(struct optimistic_spin_node, osq_node);
	 */
	$osq_node = (struct optimistic_spin_node *)kaddr("osq_node");

	printf("%-8d %-8d\n", $osq_node->cpu, $osq_node->locked);
	exit();
}

