#!/bin/env bpftrace
/**
 * devdeny.bt - check cgroup-v1 devices.deny
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2023-08-17	Rong Tao	Create this.
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/cgroup-defs.h>
#include <linux/kernfs.h>
#endif

#define DEVCG_ALLOW 1
#define DEVCG_DENY 2
#define DEVCG_LIST 3

struct dev_cgroup {
	struct cgroup_subsys_state css;
	/* more field */
};


BEGIN
{
	@FILETYPE[DEVCG_ALLOW] = "allow";
	@FILETYPE[DEVCG_DENY] = "deny";
	@FILETYPE[DEVCG_LIST] = "list";

	printf("Tracing devices.deny, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-12s %-8s %-32s\n",
		"TIME", "PID", "COMM", "FTYPE", "BUFFER", "CGROUP");
}

kprobe:devcgroup_update_access
{
	$devcgroup = (struct dev_cgroup *)arg0;
	$cgroup = $devcgroup->css.cgroup;
	$kernfs_node = $cgroup->kn;

	$filetype = arg1;
	$buffer = str(arg2);

	time("%H:%M:%S ");
	printf("%-8d %-16s ", pid, comm);
	printf("%-8s %-12s %-32s\n",
		@FILETYPE[$filetype], $buffer, str($kernfs_node->name));
}

END
{
	clear(@FILETYPE);
	printf("Bye.\n");
}
