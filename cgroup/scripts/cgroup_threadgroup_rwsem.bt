#!/usr/bin/env bpftrace 

BEGIN
{
	printf("Tracing cgroup_threadgroup_rwsem, Hit Ctrl+C end.\n");
}

profile:hz:99
{
	$sem = (struct percpu_rw_semaphore *)kaddr("cgroup_threadgroup_rwsem");

	$read_count = $sem->read_count;
	$writer = $sem->writer.task;
	$block = $sem->block.counter;

	if ($writer != 0) {
		time("%H:%M:%S ");
		printf("read_count %d, comm '%s' pid %d tgid %d, block %d\n",
			$read_count,
			$writer->comm, $writer->pid, $writer->tgid,
			$block);

		@count[$writer->tgid, $writer->comm] = count();
	}
}

END{
	printf("Bye.\n");
}
