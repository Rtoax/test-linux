#!/usr/bin/env bpftrace
/**
 * cpuset_rwsem.bt
 *
 * Tracing sem cpuset_rwsem write hold
 *
 * kernel 5.10 ~ 5.15.67
 *
 * 2024-09-05  Rong Tao        Create this.
 */

BEGIN
{
	printf("Tracing cpuset_rwsem, Hit Ctrl+C end.\n");
}

profile:hz:99
{
	$sem = (struct percpu_rw_semaphore *)kaddr("cpuset_rwsem");

	$read_count = $sem->read_count;
	$writer = $sem->writer.task;
	$block = $sem->block.counter;

	if ($writer != 0) {
		time("%H:%M:%S ");
		printf("held: read_count %d, comm '%s' pid %d tgid %d, block %d, cpu %d\n",
			$read_count,
			$writer->comm, $writer->pid, $writer->tgid,
			$block, cpu);

		@count[$writer->tgid, $writer->comm] = count();
	}
}

/* Who hold write handle */
kprobe:percpu_down_write
{
	$sem = (struct percpu_rw_semaphore *)arg0;
	$cgrp_sem = (struct percpu_rw_semaphore *)kaddr("cpuset_rwsem");
	if ($sem == $cgrp_sem) {
		@start[tid] = nsecs;
		@start_down[tid] = nsecs;
		@read_count[tid] = $sem->read_count;
		@writer[tid] = $sem->writer.task;
		@task[tid] = curtask;
		@stack[tid] = kstack;
	}
}

kretprobe:percpu_down_write
/ @start_down[tid] /
{
	$task = @task[tid];
	$writer = @writer[tid];
	$down_stack = @stack[tid];
	$us = (nsecs - @start_down[tid]) / 1000;
	@latency_us_down = hist($us);
	if ($us > 1000000) {
		@hold_wr_down_ge_1s[$task->comm, $task->pid, $down_stack, kstack] = count();
		printf("\033[31mdown: read_count %d, %s %d (writer %s %d) %ld us, cpu %d\033[m\n",
			@read_count[tid],
			$task->comm, $task->pid, $writer->comm, $writer->pid, $us, cpu);
	}
	delete(@start_down[tid]);
	delete(@read_count[tid]);
	delete(@writer[tid]);
}

kprobe:percpu_up_write
/ @start[tid] /
{
	$sem = (struct percpu_rw_semaphore *)arg0;
	$cgrp_sem = (struct percpu_rw_semaphore *)kaddr("cpuset_rwsem");
	if ($sem == $cgrp_sem) {
		$task = @task[tid];
		$down_stack = @stack[tid];
		$us = (nsecs - @start[tid]) / 1000;
		@latency_us = hist($us);
		delete(@start[tid]);
		delete(@task[tid]);
		delete(@stack[tid]);

		/* Record all task who was held sem write handle */
		@hold[$task->comm, $task->pid] = count();
		@hold_time_us[$task->comm, $task->pid] += $us;

		/* Hold sem write handle too much time */
		if ($us > 1000000) {
			@hold_wr_ge_1s[$task->comm, $task->pid, $down_stack, kstack] = count();
			printf("\033[32mdown->up: %s pid %d, %ld us, cpu %d\033[m\n",
				$task->comm, $task->pid, $us, cpu);
		}
	}
}

END
{
	clear(@start);
	clear(@start_down);
	clear(@read_count);
	clear(@task);
	clear(@writer);
	clear(@stack);
	printf("Bye.\n");
}
