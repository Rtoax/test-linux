#!/usr/bin/env bpftrace
/**
 * cgroup_attach_task.bt
 *
 * Tracing cgroup_attach_task
 *
 * Test with: $ docker run -ti centos /bin/bash
 */
BEGIN
{
	printf("Tracing cgroup_attach_task, hit ctrl-C to end.\n");
	printf("%-6s %-6s %-8s %-8s %-8s\n", "DST_ID", "DST_LV", "PID", "COMM", "DST_PATH");
}

tracepoint:cgroup:cgroup_attach_task
{
	$dst_id = args->dst_id;
	$dst_level = args->dst_level;
	$pid = args->pid;
	$dst_path = args->dst_path;
	$comm = args->comm;

	printf("%-6d %-6d %-8d %-8s %s\n",
		$dst_id, $dst_level, $pid, str($comm), str($dst_path));
}

kprobe:cgroup_attach_task
{
	@start[tid] = nsecs;
}

kretprobe:cgroup_attach_task
/ @start[tid] /
{
	$us = (nsecs - @start[tid]) / 1000;
	@latency_us = hist($us);

	/* Recording big latency */
	if ($us > 1000000) {
		@latency_ge_1s[comm, pid] = count();
	}

	delete(@start[tid]);
}

END
{
	clear(@start);
	printf("Bye.\n");
}

