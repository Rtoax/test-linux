#!/usr/bin/env bpftrace
/**
 * cgroup_attach_task.bt
 *
 * Tracing cgroup_attach_task
 *
 * Test with: $ docker run -ti centos /bin/bash
 */
BEGIN
{
	printf("Tracing cgroup_attach_task, hit ctrl-C to end.\n");
	printf("%-6s %-6s %-8s %-8s %-8s\n", "DST_ID", "DST_LV", "PID", "COMM", "DST_PATH");
}

tracepoint:cgroup:cgroup_attach_task
{
	$dst_id = args->dst_id;
	$dst_level = args->dst_level;
	$pid = args->pid;
	$dst_path = args->dst_path;
	$comm = args->comm;

	@dst_path[tid] = $dst_path;

	printf("%-6d %-6d %-8d %-8s %s\n",
		$dst_id, $dst_level, $pid, str($comm), str($dst_path));
}

kprobe:cgroup_attach_task
{
	@start[tid] = nsecs;
}

kretprobe:cgroup_attach_task
/ @start[tid] /
{
	$us = (nsecs - @start[tid]) / 1000;
	@latency_us = hist($us);

	/* Recording big latency */
	if ($us > 1000000) {
		@latency_ge_1s[comm, pid] = count();
		printf("LAT: \033[31m%s %d : %s %ld us\033[m\n",
			comm, pid, str(@dst_path[tid]), $us);
	}

	delete(@start[tid]);
	delete(@dst_path[tid]);
}

/**
 * Called by cgroup_attach_task()
 */
kprobe:cgroup_migrate_prepare_dst
/ @start[tid] /
{
	@start_1[tid] = nsecs;
}

kretprobe:cgroup_migrate_prepare_dst
/ @start_1[tid] /
{
	$us = (nsecs - @start_1[tid]) / 1000;
	@latency_us_1 = hist($us);

	/* Recording big latency */
	if ($us > 1000000) {
		printf("LAT_1: \033[31m%s %d : %s %ld us\033[m\n",
			comm, pid, str(@dst_path[tid]), $us);
	}

	delete(@start_1[tid]);
}

/**
 * Called by cgroup_attach_task()
 */
kprobe:cgroup_migrate
/ @start[tid] /
{
	@start_2[tid] = nsecs;
}

kretprobe:cgroup_migrate
/ @start_2[tid] /
{
	$us = (nsecs - @start_2[tid]) / 1000;
	@latency_us_1 = hist($us);

	/* Recording big latency */
	if ($us > 1000000) {
		printf("LAT_2: \033[31m%s %d : %s %ld us\033[m\n",
			comm, pid, str(@dst_path[tid]), $us);
	}

	delete(@start_2[tid]);
}

/**
 * Called by cgroup_migrate()
 */
kprobe:cgroup_migrate_execute
/ @start[tid] /
{
	@start_3[tid] = nsecs;
}

kretprobe:cgroup_migrate_execute
/ @start_3[tid] /
{
	$us = (nsecs - @start_3[tid]) / 1000;
	@latency_us_2 = hist($us);

	/* Recording big latency */
	if ($us > 1000000) {
		printf("LAT_3: \033[31m%s %d : %s %ld us\033[m\n",
			comm, pid, str(@dst_path[tid]), $us);
	}

	delete(@start_3[tid]);
}

/**
 * Called by cgroup_migrate_execute()
 */
kprobe:cgroup_freezer_migrate_task
/ @start[tid] /
{
	@start_4[tid] = nsecs;
}

kretprobe:cgroup_freezer_migrate_task
/ @start_4[tid] /
{
	$us = (nsecs - @start_4[tid]) / 1000;
	@latency_us_3 = hist($us);

	/* Recording big latency */
	if ($us > 1000000) {
		printf("LAT_4: \033[31m%s %d : %s %ld us\033[m\n",
			comm, pid, str(@dst_path[tid]), $us);
	}

	delete(@start_4[tid]);
}

END
{
	clear(@start);
	clear(@start_1);
	clear(@start_2);
	clear(@start_3);
	clear(@start_4);
	clear(@dst_path);
	printf("Bye.\n");
}

