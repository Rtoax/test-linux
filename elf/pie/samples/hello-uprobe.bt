#!/bin/bpftrace --unsafe
/**
 * uprobe.bt - description
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2024-02-26	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing hello{,-pie}, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-16s %s\n",
		"TIME", "PID", "COMM", "IP", "PROBE");
}

uprobe:./hello:*,
uprobe:./hello-pie:*,
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-016lx %s\n", pid, comm, reg("ip"), probe);
}

uprobe:./hello:readline,
uprobe:./hello-pie:readline
{
	printf("PS1: %s\n", str(*uaddr("ps1_prompt")));
	printf("readline: 0x%lx\n", uaddr("readline"));
}

END
{
	printf("Bye.\n");
}
