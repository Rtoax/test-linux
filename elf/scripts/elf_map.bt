#!/bin/env bpftrace
/**
 * elf_map.bt - Tracing elf map
 *
 * elf_map() only mmap /usr/lib64/ld-linux-x86-64.so.2 and 'SELF'
 *
 * 2022-09-23	Rong Tao	Create this.
 * 2024-01-06	Rong Tao	Print total size and fix arg error.
 */

BEGIN
{
	printf("Tracing xxx, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-16s %-16s %-8s\n",
		"TIME", "PID", "ADDR", "TOTAL_SIZE", "MAP ADDR", "COMM");
}

kprobe:elf_map
{
	time("%H:%M:%S ");
	printf("%-8d %-16lx %-016lx", pid, arg1, arg5);
}

kretprobe:elf_map
{
	printf("%-16lx %-8s\n", retval, comm);
}

