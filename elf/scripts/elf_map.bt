#!/bin/env bpftrace
/**
 * elf_map.bt - Tracing elf map
 *
 * elf_map() only mmap /usr/lib64/ld-linux-x86-64.so.2 and 'SELF'
 *
 * 2022-09-23	Rong Tao	Create this.
 * 2024-01-06	Rong Tao	Print total size and fix arg error.
 */
#define PROT_READ	0x1		/* page can be read */
#define PROT_WRITE	0x2		/* page can be written */
#define PROT_EXEC	0x4		/* page can be executed */

BEGIN
{
	printf("Tracing xxx, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s %-4s ",
		"TIME", "PID", "ADDR", "SIZE(e)", "PROT");
	printf("%-8s %-16s %-16s %-8s\n",
		"SIZE(m)", "OFF", "MAP ADDR", "COMM");
}

kprobe:elf_map
{
	$addr = arg1;
	$prot = arg3;
	$total_size = arg5;

	time("%H:%M:%S ");
	printf("%-8d %-16lx %-08lx %s%s%s- ", pid, $addr, $total_size,
		$prot & PROT_READ ? "r" : "-",
		$prot & PROT_WRITE ? "w" : "-",
		$prot & PROT_EXEC ? "x" : "-");

	@elf_map_start[tid] = nsecs;
}

/* elf_map() call vm_mmap() */
kprobe:vm_mmap
/ @elf_map_start[tid] /
{
	$size = arg2;
	$off = arg5;

	printf("%-8lx %-16lx", $size, $off);

	@vm_mmap_start[tid] = nsecs;
}

kretprobe:elf_map
/ @elf_map_start[tid] && @vm_mmap_start[tid] /
{
	$map_addr = retval;

	printf("%-16lx %-8s\n", $map_addr, comm);

	delete(@elf_map_start[tid]);
	delete(@vm_mmap_start[tid]);
}

