#!/bin/env bpftrace
/**
 * init_module.bt
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2024-02-04	Rong Tao	Create this.
 * 2024-11-05	Rong Tao	Display uargs.
 * 2025-04-24	Rong Tao	Display ret value.
 */
BEGIN
{
	printf("Tracing (f)init_module(2), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s %-16s %s\n",
		"TIME", "PID", "COMM", "PPID", "PCOMM", "UARGS (RET)");
}

tracepoint:syscalls:sys_enter_finit_module,
tracepoint:syscalls:sys_enter_init_module
{
	$parent = (struct task_struct *)curtask->real_parent;
	$ppid = $parent->tgid;
	$pcomm = $parent->comm;
	$uargs = str(args->uargs);
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8d %-16s %s", pid, comm, $ppid, $pcomm, $uargs);
}

tracepoint:syscalls:sys_exit_finit_module,
tracepoint:syscalls:sys_exit_init_module
{
	printf(" (ret %d)\n", args->ret);
}

kprobe:load_module
{
	$info = (struct load_info *)arg0;
	@infos[tid] = $info;
}

kretprobe:load_module
/ @infos[tid] /
{
	$info = @infos[tid];
	// printf("name = %s\n", str($info->name));
	// TODO
	delete(@infos[tid]);
}

END
{
	clear(@infos);
	printf("Bye.\n");
}
