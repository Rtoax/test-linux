#!/bin/env bpftrace
/**
 * module_alloc.bt - Tracing module_alloc() on aarch64
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2024-04-17	Rong Tao	Create this.
 * 2025-04-07	Rong Tao	Display size.
 */
BEGIN
{
	printf("Tracing module_alloc() on aarch64, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s %-16s %-16s %-16s\n",
		"TIME", "PID", "COMM", "PPID", "PCOMM", "ADDRESS", "SIZE(B,MB)");
}

kprobe:module_alloc
{
	@sizes[tid] = arg0;
}

kretprobe:module_alloc
/ @sizes[tid] /
{
	$parent = (struct task_struct *)curtask->real_parent;
	$ppid = $parent->tgid;
	$pcomm = $parent->comm;
	$addr = retval;

	time("%H:%M:%S ");
	printf("%-8d %-16s %-8d %-16s", pid, comm, $ppid, $pcomm);

	if ($addr == 0) {
		printf(" %-16s", "NULL");
	} else {
		printf(" %-16lx", $addr);
	}
	printf(" 0x%08lx,%-4ldMB\n", @sizes[tid], @sizes[tid] / 1024 / 1024);

	delete(@sizes[tid]);
}

END
{
	clear(@sizes);
	printf("Bye.\n");
}
