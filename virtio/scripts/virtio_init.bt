#!/bin/env bpftrace
/**
 * File: virtio_init.bt
 * Author: Rong Tao
 * Date: 2022.06.18
 *
 */
BEGIN
{
	printf("Tracing virtio_init, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s %-8s\n", "TIME", "PID", "COMM", "DEVICE");
}

/* void virtio_init(VirtIODevice *vdev, const char *name,
					uint16_t device_id, size_t config_size) */
uprobe:/usr/libexec/qemu-kvm:virtio_init
{
	/**
	 * For example:
	 * virtio-serial,virtio-blk,virtio-net,virtio-balloon,virtio-rng
	 */
	$name = arg1;
	time("%H:%M:%S ");
	printf("%-8d %-8s %-8s\n", pid, comm, str($name));
}

END
{
	printf("Bye.\n");
}
