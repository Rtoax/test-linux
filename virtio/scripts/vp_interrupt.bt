#!/bin/env bpftrace
/**
 * File: vp_interrupt.bt
 * Author: Rong Tao <rtoax@foxmail.com>
 * Date: 2022.06.19
 *
 */
BEGIN
{
	printf("Tracing vp_interrupt, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s %-8s\n", "TIME", "PID", "COMM", "IRQ");
}

/**
 * Guest OS VM 接收到中断后，
 * virtio 驱动负责处理这个中断，该中断在驱动初始化时 使用 request_irq()
 * 申请中断资源，并把中断函数设置为 vp_interrupt().
 *
 */
kprobe:vp_interrupt
{
	$irq = arg0;
	time("%H:%M:%S ");
	printf("%-8d %-8s %-8d\n", pid, comm, $irq);
}

END
{
	printf("Bye.\n");
}
