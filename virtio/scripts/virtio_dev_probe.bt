#!/bin/env bpftrace
/**
 * virtio_dev_probe.bt
 *
 * Copyright (C) Rong Tao 2024
 */
#include <linux/virtio.h>

BEGIN
{
	printf("Tracing virtio_dev_probe(), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s\n", "TIME", "PID", "COMM", "NAME");
}

kprobe:virtio_dev_probe
{
	$dev = (struct device *)arg0;

	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s\n", pid, comm, str($dev->kobj.name));

	@kstacks[kstack] = count();
}

END
{
	printf("Bye.\n");
}
