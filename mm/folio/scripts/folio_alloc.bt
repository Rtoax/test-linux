#!/bin/env bpftrace
/**
 * folio_alloc.bt - Tracing folio_alloc
 *
 * Support folio since 5.16
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2023-11-17	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing folio_alloc, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s\n", "TIME", "PID", "COMM", "ORDER");
}

kprobe:folio_alloc,
kprobe:__folio_alloc
{
	$order = arg1;
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8d\n", pid, comm, $order);
}

END
{
	printf("Bye.\n");
}
