#!/bin/env bpftrace
/**
 * mmap.bt - Tracing mmap(2) syscall
 */
#include <linux/mman.h>

BEGIN
{
	printf("Tracing mmap(2), hit ctrl-c to end.\n");

	printf("flags: MAP_PRIVATE(P), MAP_SHARED(S), MAP_SHARED_VALIDATE(s)\n");
	printf("       MAP_ANONYMOUS(A), MAP_TYPE(T), MAP_FILE(F), MAP_FIXED(X)\n");

	printf("%-8s %-8s %-16s %-8s %-5s %-16s %-8s %-8s %-16s\n",
		"TIME", "PID", "COMM", "LEN(KB)", "PROT", "FLAGS", "FD", "OFF",
		"RETURN");
}

tracepoint:syscalls:sys_enter_mmap
{
	$prot = args->prot;
	$flags = args->flags;
	$fd = args->fd;
	$off = args->off;

	time("%H:%M:%S ");
	printf("%-8d %-16s %-8lx ", pid, comm, args->len / 1024);
	printf("%s%s%s%s ",
		$flags & MAP_PRIVATE ? "p" : ($flags & MAP_SHARED ? "s" : "-"),
		$prot & PROT_READ ? "r" : "-",
		$prot & PROT_WRITE ? "w" : "-",
		$prot & PROT_EXEC ? "x" : "-");
	printf(" %s", $flags & MAP_PRIVATE ? "P" : "-");
	printf("%s", $flags & MAP_SHARED ? "S" : "-");
	printf("%s", $flags & MAP_SHARED_VALIDATE ? "s" : "-");
	printf("%s", $flags & MAP_ANONYMOUS ? "A" : "-");
	printf("%s", $flags & MAP_TYPE ? "T" : "-");
	printf("%s", $flags & MAP_FILE ? "F" : "-");
	printf("%s", $flags & MAP_FIXED ? "X" : "-");
	printf("%9s", "");
	printf("%-8d %-8lx", $fd, $off);

	@start[tid] = nsecs;
}

tracepoint:syscalls:sys_exit_mmap
/ @start[tid] /
{
	printf(" %-16lx\n", args->ret);
	@hist_us = hist((nsecs - @start[tid]) / 1000);
	delete(@start[tid]);
}

tracepoint:syscalls:sys_enter_munmap
{
	$addr = args->addr;
	$len = args->len;

	time("%H:%M:%S ");
	printf("%-8d %-16s %-8lx %4s %7s %9s %8s %8s %-16lx <munmap>\n",
		pid, comm, $len / 1024, "", "", "", "", "", $addr);
}

END
{
	clear(@start);
	printf("Bye.\n");
}
