#!/bin/env bpftrace
/**
 * mmap.bt - Tracing mmap(2) syscall
 */
#include <linux/mman.h>

BEGIN
{
	printf("Tracing mmap(2), hit ctrl-c to end.\n");

	printf("flags: MAP_PRIVATE(P), MAP_SHARED(S), MAP_SHARED_VALIDATE(s)\n");
	printf("       MAP_ANONYMOUS(A), MAP_TYPE(T), MAP_FILE(F), MAP_FIXED(X)\n");

	printf("%-8s %-8s %-16s %-8s %-5s %-16s %-16s\n",
		"TIME", "PID", "COMM", "LEN(KB)", "PROT", "FLAGS", "RETURN");
}

tracepoint:syscalls:sys_enter_mmap
{
	$prot = args->prot;
	$flags = args->flags;

	time("%H:%M:%S ");
	printf("%-8d %-16s %-8lx %s%s%s%s ", pid, comm, args->len / 1024,
		$flags & MAP_PRIVATE ? "p" : ($flags & MAP_SHARED ? "s" : "-"),
		$prot & PROT_READ ? "r" : "-",
		$prot & PROT_WRITE ? "w" : "-",
		$prot & PROT_EXEC ? "x" : "-");
	printf(" %s%s%s%s%s%s%s%9s",
		$flags & MAP_PRIVATE ? "P" : "-",
		$flags & MAP_SHARED ? "S" : "-",
		$flags & MAP_SHARED_VALIDATE ? "s" : "-",
		$flags & MAP_ANONYMOUS ? "A" : "-",
		$flags & MAP_TYPE ? "T" : "-",
		$flags & MAP_FILE ? "F" : "-",
		$flags & MAP_FIXED ? "X" : "-",
		"");

	@start[tid] = nsecs;
}

tracepoint:syscalls:sys_exit_mmap
/ @start[tid] /
{
	printf(" %-16lx\n", args->ret);
	@hist_us = hist((nsecs - @start[tid]) / 1000);
	delete(@start[tid]);
}

END
{
	printf("Bye.\n");
}
