#!/bin/env bpftrace
/**
 * khugepaged_scan.bt
 *
 * Copyright (C) Rong Tao 2022-2025
 */
#include <linux/mm.h>

struct khugepaged_scan {
	struct list_head mm_head;
	void *mm_slot;
	unsigned long address;
};

BEGIN
{
	printf("Hit ctrl-c to end.\n");
	printf("%-8s %-16s\n", "TIME", "ADDRESS");
}

interval:s:1
{
	$scan = (struct khugepaged_scan *)kaddr("khugepaged_scan");

	time("%H:%M:%S ");
	printf("%-16lx\n", $scan->address);
}

END
{
	printf("Bye.\n");
}
