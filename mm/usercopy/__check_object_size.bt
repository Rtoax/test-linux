#!/bin/env bpftrace
/**
 * kprobe:__check_object_size.bt -
 *
 * see CONFIG_HARDENED_USERCOPY
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2023-08-06	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing __check_object_size, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s %-8s %-8s\n",
		"TIME", "PID", "COMM", "SIZE", "TO_USER");
}

kprobe:kvm_stats_read
{
	@kvm_stats_read[tid] = nsecs;
}

kprobe:__check_object_size
{
	$n = arg1;
	$to_user = arg2;

	if (@kvm_stats_read[tid]) {
		time("%H:%M:%S ");
		printf("%-8d %-8s %-8d %-8d\n", pid, comm, $n, $to_user);
		delete(@kvm_stats_read[tid]);
	}
}

END
{
	clear(@kvm_stats_read);
	printf("Bye.\n");
}
