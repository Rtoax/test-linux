#!/bin/bpftrace --unsafe
BEGIN
{
	printf("Tracing vmalloc() memory leak, end with ctrl-c\n");
}

/**
 * void *__vmalloc(unsigned long size, gfp_t gfp_mask);
 * void *vmalloc(unsigned long size);
 * void *vzalloc(unsigned long size);
 * void *vmalloc_user(unsigned long size);
 * void *vmalloc_node(unsigned long size, int node);
 * void *vzalloc_node(unsigned long size, int node);
 * void *vmalloc_32(unsigned long size);
 * void *vmalloc_32_user(unsigned long size);
 */
kprobe:__vmalloc,
kprobe:vmalloc,
kprobe:vzalloc,
kprobe:vmalloc_user,
kprobe:vmalloc_node,
kprobe:vzalloc_node,
kprobe:vmalloc_32,
kprobe:vmalloc_32_user
{
	@alloc_size[tid] = arg0;
}

/**
 * void *vmap(struct page **pages, unsigned int count, unsigned long flags, pgprot_t prot);
 */
kprobe:vmap
{
	$count = arg1;
	@alloc_size[tid] = $count << 12;
}

kretprobe:__vmalloc,
kretprobe:vmalloc,
kretprobe:vzalloc,
kretprobe:vmalloc_user,
kretprobe:vmalloc_node,
kretprobe:vzalloc_node,
kretprobe:vmalloc_32,
kretprobe:vmalloc_32_user,
kretprobe:vmap
/ @alloc_size[tid] && retval /
{
	@vmalloc_total[tid, comm] += @alloc_size[tid];
	@addr_size[retval] = @alloc_size[tid];
	@addr_comm[retval] = comm;
	@addr_tid[retval] = tid;
	//printf("%s alloc %ld\n", comm, @addr_size[retval]);
	delete(@alloc_size[tid]);
}

/**
 * void vfree(const void *addr);
 * void vunmap(const void *addr);
 */
kprobe:vfree,
kprobe:vunmap
/ @addr_size[arg0] /
{
	//printf("%s(%s) freed %ld\n", comm, @addr_comm[arg0], @addr_size[arg0]);
	@vmalloc_total[@addr_tid[arg0], @addr_comm[arg0]] -= @addr_size[arg0];
	if (@vmalloc_total[@addr_tid[arg0], @addr_comm[arg0]] == 0) {
		delete(@vmalloc_total[@addr_tid[arg0], @addr_comm[arg0]]);
	}
	delete(@addr_size[arg0]);
	delete(@addr_comm[arg0]);
	delete(@addr_tid[arg0]);
}

i:s:5
{
	printf("\033[32m");
	system("grep ^VmallocUsed: /proc/meminfo");
	printf("\033[31m");
	print(@vmalloc_total, 10);
	printf("\033[m");
}

END
{
	clear(@addr_size);
	clear(@alloc_size);
}
