#ifndef BPFTRACE_HAVE_BTF
#include <linux/mm.h>
#endif
BEGIN
{
	printf("Tracing vm_area_alloc(), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s\n", "TIME", "PID", "COMM");
}

kprobe:vm_area_alloc
{
	time("%H:%M:%S ");
	printf("%-8d %-16s\n", pid, comm);
}

