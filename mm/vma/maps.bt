#!/bin/env bpftrace
/**
 * maps.bt - Get /proc/self/maps
 *
 * sudo bpftrace -e 'iter:task_vma {$p = ctx->vma->vm_file->f_path; printf("%s\n", path($p));}'
 *
 * Copyright (C) Rong Tao 2022-2023
 *
 * 2023-08-25	Rong Tao	Create this.
 */
#include <linux/sched.h>
#include <linux/fs.h>
#include <linux/mm.h>

iter:task_vma
{
	$path = ctx->vma->vm_file->f_path;
	printf("%s\n", path($path));
}

