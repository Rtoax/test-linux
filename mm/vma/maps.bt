#!/bin/env bpftrace
/**
 * maps.bt - Get /proc/self/maps
 *
 * sudo bpftrace -e 'iter:task_vma {$p = ctx->vma->vm_file->f_path; printf("%s\n", path($p));}'
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2023-08-25	Rong Tao	Create this.
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#include <linux/fs.h>
#include <linux/mm.h>
#endif

iter:task_vma
{
	$vma = ctx->vma;

	$vm_start = $vma->vm_start;
	$vm_end = $vma->vm_end;
	$vm_pgoff = $vma->vm_pgoff;
	$path = $vma->vm_file->f_path;

	printf("%-16lx-%-16lx %-16lx %s\n", $vm_start, $vm_end, $vm_pgoff,
		path($path));
}

