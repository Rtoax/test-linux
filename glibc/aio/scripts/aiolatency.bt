#include <uapi/linux/aio_abi.h>

BEGIN
{
	printf("Tracing aio submit-getevent latency, hit ctrl-c to end.\n");
}

tracepoint:syscalls:sys_enter_io_submit
{
	$nr = args->nr;
	if ($nr > 1) {
		printf("\033[31msubmit: Number of submit bigger than 1, drop it.\033[m\n");
	}
	$iocb = (struct iocb *)args->iocbpp[0];
	@start[$iocb] = nsecs;
}

tracepoint:syscalls:sys_enter_io_getevents
{
	$io_event = (struct io_event *)args->events;
	$iocb = (struct iocb *)$io_event->obj;

	if (@start[$iocb]) {
		$latency = nsecs - @start[$iocb];
		@hist_ns = hist($latency);
		delete(@start[$iocb]);
	}
}

tracepoint:syscalls:sys_exit_io_getevents
{
	$nr = args->ret;
	if ($nr > 1) {
		printf("\033[31mgetevents: Number of submit bigger than 1, drop it.\033[m\n");
	}
}

i:s:1
{
	print(@hist_ns);
}

END
{
	clear(@start);
	printf("Bye.\n");
}
