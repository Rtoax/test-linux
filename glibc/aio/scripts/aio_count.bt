#!/bin/env bpftrace
/**
 * aio_count.bt - description
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2023-11-06	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing aio, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-32s %-8s %-8s\n", "TIME", "PID", "COMM", "AIO", "NR");
}

tracepoint:syscalls:sys_enter_io_submit
{
	$nr = args->nr;
	time("%H:%M:%S ");
	printf("%-8d %-32s %-8s %-8d\n", pid, comm, "SUBMIT", $nr);
}

tracepoint:syscalls:sys_enter_io_getevents,
tracepoint:syscalls:sys_enter_io_pgetevents
{
	$nr = args->nr;
	time("%H:%M:%S ");
	printf("%-8d %-32s %-8s %-8d\n", pid, comm, "GETEVT", $nr);
}
