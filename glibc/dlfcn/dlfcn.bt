#!/bin/env bpftrace
/**
 * dflcn.bt - Tracing dlopen/dlsym, etc.
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2024-01-17	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing dlfcn, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s %-16s %-8s\n",
		"TIME", "PID", "COMM", "OPERATE", "RESULT", "FUNC/LIB");
}

uprobe:libc:dlopen
{
	$file = arg0;
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s %-16s %s\n",
		pid, comm, "DLOPEN", "-", str($file));
}

uprobe:libc:dlsym
{
	$symbol = arg1;
	@symbols[tid] = $symbol;
}

uretprobe:libc:dlsym
/ @symbols[tid] /
{
	$ret = retval;
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s %-8lx %s\n",
		pid, comm, "DLSYM", $ret, str(@symbols[tid]));
	delete(@symbols[tid]);
}

END
{
	printf("Bye.\n");
}
