#!/bin/env bpftrace
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing pthread_create, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s\n", "TIME", "PID", "COMM", "LAT(us)");
}

uprobe:libc:pthread_create
{
	@start[tid] = nsecs;
	@comm[tid] = comm;
}

uretprobe:libc:pthread_create
/ @start[tid] /
{
	$us = (nsecs - @start[tid]) / 1000;
	@latency_us = hist($us);

	time("%H:%M:%S ");
	printf("%-8d %-16s %-8d\n", pid, @comm[tid], $us);
	delete(@start[tid]);
}

END
{
	clear(@start);
	clear(@comm);
	printf("Bye.\n");
}
