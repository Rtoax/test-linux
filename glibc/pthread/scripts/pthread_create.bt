#!/bin/env bpftrace
/**
 * File: pthread_create.bt
 * Author: Rong Tao <rongtao@cestc.cn>
 * Date: 2022.06.08
 *
 */
BEGIN
{
	printf("Tracing pthread_create(), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

uprobe:/lib64/libpthread.so:pthread_create
{
	time("%H:%M:%S ");
	printf("%-8d %-8s\n", pid, comm);
}

