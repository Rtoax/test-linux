#!/bin/env bpftrace
/**
 * File: pthread_create.bt
 * Author: Rong Tao <rtoax@foxmail.com>
 * Date: 2022.06.08
 *
 * Ref: /usr/share/bpftrace/tools/threadsnoop.bt
 */
BEGIN
{
	printf("Tracing pthread_create(), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s\n", "TIME", "PID", "COMM", "FUNC");
}

/* glibc 2.34, pthread apis move to libc.so */
uprobe:libc:pthread_create
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %s\n", pid, comm, usym(arg2));
}

