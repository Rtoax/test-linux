#!/bin/env bpftrace
/**
 * File: __libc_start_main.bt
 * Author: Rong Tao <rongtao@cestc.cn>
 * Date: 2022.06.08
 *
 */
BEGIN
{
	printf("Tracing __libc_start_main(), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

uprobe:/lib64/libc.so.6:__libc_start_main
{
	time("%H:%M:%S ");
	printf("%-8d %-8s\n", pid, comm);
}

