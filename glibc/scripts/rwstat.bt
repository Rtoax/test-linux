#!/usr/bin/env bpftrace
/**
 * File: rwstat.bt
 * Author: Rong Tao <rtoax@foxmail.com>
 * Date: 2022.06.08
 *
 */

BEGIN
{
	printf("Tracing GLibc read/write... Hit Ctrl-C to end.\n");

}

uprobe:libc:write,
uprobe:libc:read
{
	@[func] = count();
}

interval:s:1
{
	time();
	print(@);
	clear(@);
}

END
{
	clear(@);
}
