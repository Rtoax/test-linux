#!/usr/bin/env bpftrace
/**
 * File: frwstat.bt
 * Author: Rong Tao <rtoax@foxmail.com>
 * Date: 2022.06.08
 *
 */

BEGIN
{
	printf("Tracing GLibc file read/write... Hit Ctrl-C to end.\n");

}

uprobe:libc:fwrite,
uprobe:libc:fwrite_unlocked,
uprobe:libc:fread,
uprobe:libc:fread_unlocked
{
	@[func] = count();
}

interval:s:1
{
	time();
	print(@);
	clear(@);
}

END
{
	clear(@);
}
