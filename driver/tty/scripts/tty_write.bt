#!/bin/env bpftrace
/**
 * tty_write.bt
 *
 * Copyright (C) 2023-2026 Rong Tao
 */
BEGIN
{
	printf("Tracing tty_write, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

kprobe:tty_write
{
	$from = (struct iov_iter *)arg1;
	$kvec = $from->kvec;

	$iter_type = $from->iter_type;

	$data_source = $from->data_source;
	$iov_len = $kvec->iov_len;

	$bio_vec = $from->bvec;
	$bv_len = $bio_vec->bv_len;

	$iovec = $from->iov;
	$iov_len2 = $iovec->iov_len;

	$count = $from->count;
	$ubuf = $from->ubuf;

	time("%H:%M:%S ");
	printf("%-8d %-8s %-8d %-8d %-8d %-8d %-8d %-8d %016lx\n",
		pid, comm, $iter_type, $data_source, $iov_len,
		$bv_len, $iov_len2, $count, $ubuf);
}

END
{
	printf("Bye.\n");
}
