#!/bin/env bpftrace
/**
 * tty_init_dev.bt
 *
 * Copyright (C) 2023-2026 Rong Tao
 */
BEGIN
{
	printf("Tracing tty_init_dev, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

kprobe:tty_init_dev
{
	$idx = arg1;

	time("%H:%M:%S ");
	printf("%-8d %-8s %-8d\n", pid, comm, $idx);
}

END
{
	printf("Bye.\n");
}
