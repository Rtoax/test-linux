#!/usr/bin/env bpftrace
/**
 * kvm_inj_virq.bt
 *
 * 2024-07-22	Rong Tao	Create this.
 */

BEGIN
{
	printf("Tracing KVM tracepoint:kvm:kvm_inj_virq, ctrl-C to end.\n");
	printf("%-8s %-8s %-16s %-8s\n",
		"TIME", "PID", "COMM", "VECTOR");
}

/**
 * svm: svm_set_irq()
 * vmx: vmx_inject_irq()
 */
tracepoint:kvm:kvm_inj_virq
{
	$vector = args->vector;

	time("%H:%M:%S ");
	printf("%-8d %-16s %-8d\n", pid, comm, $vector);

	@vectors[$vector] = count();
	@stack[kstack] = count();
}

END
{
	printf("Bye.\n");
}
