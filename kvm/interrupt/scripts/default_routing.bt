#!/bin/env bpftrace
/**
 * File: default_routing.bt
 * Author: Rong Tao <rongtao@cestc.cn>
 * Date: 2022.06.09
 *
 * Description:
 * Ref:
 *   linux:arch/x86/kvm/irq_comm.c
