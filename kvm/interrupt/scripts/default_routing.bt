#include <uapi/linux/kvm.h>

BEGIN
{
	printf("Tracing KVM default_routing, hit ctrl-c to end.\n");

	/**
	 * see arch/x86/kvm/irq_comm.c
	 */
	$routing = (struct kvm_irq_routing_entry *)kaddr("default_routing");
}
