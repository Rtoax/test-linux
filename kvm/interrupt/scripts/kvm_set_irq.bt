#!/usr/bin/env bpftrace
/**
 * kvm_set_irq.bt
 *
 * 2022.01.07	Rong Tao	Create this
 */

BEGIN
{
	printf("Tracing KVM kvm_set_irq, ctrl-C to end.\n");
	printf("%-8s %-8s %-16s %-8s %-8s %-8s %-8s\n",
		"TIME", "PID", "COMM", "SRC_ID", "IRQ", "LEVEL", "STATUS");
}

/**
 * kvm_set_irq: Trigger interrupt
 *
 * This function called during VM Startup.
 *
 * linux-5.10.13
 * int kvm_set_irq(struct kvm *kvm, int irq_source_id, u32 irq, int level,
 *                 bool line_status)
 *
 * Qemu has same name api
 *  int kvm_set_irq(KVMState *s, int irq, int level)
 *  {
 *    kvm_vm_ioctl(s, KVM_IRQ_LINE_STATUS, &event);
 *  }
 */
kprobe:kvm_set_irq
{
	$irq_source_id = arg1;
	$irq = arg2;
	$level = arg3;
	$line_status = arg4;

	time("%H:%M:%S ");
	printf("%-8d %-16s %-8d %-8d %-8d %-8d\n", pid, comm, $irq_source_id,
		$irq, $level, $line_status);

	@kstack[kstack] = count();
	@irq[$irq, $level] = count();
}

END
{
	printf("Bye.\n");
}
