#!/bin/env bpftrace
/**
 * File: handle_ept_violation.bt
 *
 * Author: Rong Tao <rongtao@cestc.cn>
 * Date: 2023-04-09
 *
 * Description:
 *  When EPT page fault happen, handle_ept_violation called.
 *  TDP: Two Dimission Page
 */
BEGIN
{
	printf("Tracing handle_ept_violation, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

/**
 * Both VM creation and VM running call this function.
 *
 * Example stack:
 *
 *     handle_ept_violation+5
 *     vmx_handle_exit+301
 *     kvm_arch_vcpu_ioctl_run+3186
 *     kvm_vcpu_ioctl+409
 *     __x64_sys_ioctl+148
 *     do_syscall_64+93
 *     entry_SYSCALL_64_after_hwframe+110
 */
kprobe:handle_ept_violation
{
	time("%H:%M:%S ");
	printf("%-8d %-8s\n", pid, comm);
	@stack[kstack] = count();
}

END
{
	printf("Bye.\n");
}
