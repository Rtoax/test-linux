#!/bin/env bpftrace
/**
 * alloc_loaded_vmcs.bt
 *
 * Copyright (C) Rong Tao 2022-2025
 */
struct vmcs_hdr {
	u32 revision_id:31;
	u32 shadow_vmcs:1;
};

struct vmcs {
	struct vmcs_hdr hdr;
	u32 abort;
	char data[];
};

struct loaded_vmcs {
	struct vmcs *vmcs;
	struct vmcs *shadow_vmcs;
	int cpu;
	bool launched;
	bool nmi_known_unmasked;
	bool hv_timer_soft_disabled;
	/* Support for vnmi-less CPUs */
	int soft_vnmi_blocked;
	ktime_t entry_time;
	s64 vnmi_blocked_time;
	unsigned long *msr_bitmap;
	struct list_head loaded_vmcss_on_cpu_link;
	//struct vmcs_host_state host_state;
	//struct vmcs_controls_shadow controls_shadow;
};

BEGIN
{
	printf("Tracing alloc_loaded_vmcs(), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-4s\n", "TIME", "PID", "COMM", "vCPU");
}

kprobe:alloc_loaded_vmcs
{
	$__loaded_vmcs = (struct loaded_vmcs *)arg0;

	time("%H:%M:%S ");
	printf("%-8d %-16s %-4d\n", pid, comm, $__loaded_vmcs->cpu);
}

END
{
	printf("Bye.\n");
}
