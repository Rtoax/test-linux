#!/bin/env bpftrace
/**
 * __kvm_set_xcr.bt
 *
 * 2024-07-24	Rong Tao	Create this.
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/kvm_host.h>
#endif

/**
 * See arch/x86/include/asm/fpu/types.h
 */
#define XFEATURE_MASK_FP	(1 << 0)
#define XFEATURE_MASK_SSE	(1 << 1)
#define XFEATURE_MASK_YMM	(1 << 2)
#define XFEATURE_MASK_OPMASK	(1 << 5)
#define XFEATURE_MASK_ZMM_Hi256	(1 << 6)
#define XFEATURE_MASK_Hi16_ZMM	(1 << 7)
#define XFEATURE_MASK_PKRU	(1 << 9)

#define XFEATURE_MASK_FPSSE	(XFEATURE_MASK_FP | XFEATURE_MASK_SSE)
#define XFEATURE_MASK_AVX512	(XFEATURE_MASK_OPMASK | XFEATURE_MASK_ZMM_Hi256 | XFEATURE_MASK_Hi16_ZMM)


BEGIN
{
	printf("XFEATURE_MASK_PKRU = %lx\n", XFEATURE_MASK_PKRU);
	printf("XFEATURE_MASK_AVX512 = %lx\n", XFEATURE_MASK_AVX512);
	printf("Tracing __kvm_set_xcr(), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-16s %-16s %-4s\n",
		"TIME", "INDEX", "XCR", "GUEST_SUPPORT", "GUEST", "RET");
}

kprobe:__kvm_set_xcr
{
	$vcpu = (struct kvm_vcpu *)arg0;
	$index = arg1;
	$xcr = arg2;
	$guest_supported_xcr0 = $vcpu->arch.guest_supported_xcr0;

	@vcpus[tid] = $vcpu;

	time("%H:%M:%S ");
	printf("%-8d %-16lx %-16lx ", $index, $xcr, $guest_supported_xcr0);
}

kretprobe:__kvm_set_xcr
/ @vcpus[tid] /
{
	$vcpu = (struct kvm_vcpu *)@vcpus[tid];

	printf("%-16lx %-4ld\n", $vcpu->arch.xcr0, retval);

	delete(@vcpus[tid]);
}

END
{
}
