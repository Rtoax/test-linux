#!/bin/env bpftrace
/**
 * kvm_cpuid.tp.bt
 *
 * Copyright (C) Rong Tao 2022-2025
 */
BEGIN
{
	printf("Tracing tracepoint:kvm:kvm_cpuid, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s %-8s\n", "TIME", "PID", "COMM", "INDEX");
}

tracepoint:kvm:kvm_cpuid
{
	time("%H:%M:%S ");
	printf("%-8d %-8s 0x%8x\n", pid, comm, args->index);
	@[comm] = count();
	@stack[kstack] = count();
}

END
{
	printf("Bye.\n");
}
