#!/bin/env bpftrace
/**
 * kvm_emulate_cpuid.bt
 *
 * Copyright (C) Rong Tao 2022-2025
 */
BEGIN
{
	printf("Tracing kvm_emulate_cpuid(), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

kprobe:kvm_emulate_cpuid
{
	time("%H:%M:%S ");
	printf("%-8d %-8s\n", pid, comm);
}

END
{
	printf("Bye.\n");
}
