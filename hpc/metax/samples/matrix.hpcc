// SPDX-License-Identifier: GPL-3.0
/**
 * Using GPU to perform matrix multiplication, and this program not use any
 * library(like BLAS), only use pure-C to test matrix.
 *
 * - commit 2506e482755d ("hpc: matrix-mul: Nvidia Tesla T4 vs MetaX ???")
 * - commit 0528d8ab981f ("hpc: matrix-mul: Compare Nvidia H800 & Mars X203 (Metax)")
 */
#include <argp.h>
#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <malloc.h>
#include <time.h>
#if defined(HAVE_HCCL)
# include <hccl.h>
# include <hc_runtime.h>
# include "hpcc_helpers.h"
#  if defined(TEST_FP16)
#   include <hpcc_fp16.h>
#  endif
# define __gpu_global__	__global__
# include "cuda2hccl.h"
/* Use some macros, _must_ include after cuda2hccl.h */
# include "cuda_call.h"
#elif defined(HAVE_CUDA)
# include <cuda_runtime.h>
# include "cuda_helpers.h"
# define __gpu_global__	__global__
#else
# define __gpu_global__
# define gpu_name(b, bl)	({ strncpy(b, "CPU", bl); b; })
#endif

#ifndef gpu_init
# define gpu_init(dev)
#endif

#if defined(TEST_DOUBLE)
# define TYPE	double
# define TFMT	"%.2lf"
# define TVAL(v)	(v)
# define TNAME	"double"
# define TRVALUE(v)	(v * 1.0)
#elif defined(TEST_INT8)
# define TYPE	int8_t
# define TFMT	"%d"
# define TVAL(v)	(v)
# define TNAME	"int8_t"
# define TRVALUE(v)	(v)
#elif defined(TEST_FP16)
# define TYPE	half
# define TFMT	"%.2f"
# define TVAL(v)	__half2float(v)
# define TNAME	"half"
# define TRVALUE(v)	__float2half(v)
#else
# define TYPE	float
# define TFMT	"%.2f"
# define TVAL(v)	(v)
# define TNAME	"float"
# define TRVALUE(v)	(v * 1.0f)
#endif

#define NS2US	1000UL
#define MAX(x, y)	(x > y ? x : y)

struct {
	union {
		int gpu;
		int cpu;
	};
	bool verbose;
	unsigned long m, k, n;
	bool vector;
	unsigned long nloop;
	bool set_value;
	unsigned int value;
	unsigned int unit_time;
} env = {
	.gpu = 0,
	.verbose = false,
	.m = 2,
	.k = 3,
	.n = 2,
	.vector = false,
	.nloop = 1,
	.set_value = false,
	.value = 0,
	.unit_time = NS2US,
};

const char *version = "v1.0.0 "
#if defined(HAVE_HCCL)
	"(GPU MetaX)"
#elif defined(HAVE_CUDA)
	"(GPU Nvidia)"
#else
	"(CPU)"
#endif
;

const char argp_prog_doc[] =
	"USAGE: [-m <NUM>] [-n <NUM>] [--nloop|-N <NUM>] [-i <VAL>] [-v]\n"
	"\n"
	"Examples:\n"
	" $ time ./matrix-mul -m200 -n200 -N10000 -i2";

static const struct argp_option opts[] = {
	{ "gpu", 'g', "GPU", 0, "Running on GPU" },
	{ "vector", 'z', NULL, 1, "Call vector instead of matrix" },
	{ "m-num", 'm', "M_NUM", 0, "Matrix M number" },
	{ "k-num", 'k', "K_NUM", 0, "Matrix K number" },
	{ "n-num", 'n', "N_NUM", 0, "Matrix N number" },
	{ "nloop", 'N', "NLOOP", 0, "Test loop number" },
	{ "init-val", 'i', "INIT_VAL", 0, "Set matrix values" },
	{ "verbose", 'v', NULL, 1, "Display detail" },
	{ "version", 'V', NULL, 1, "Display version" },
	{},
};

static error_t parse_arg(int key, char *arg, struct argp_state *state)
{
	switch (key) {
	case 'g':
		env.gpu = strtoul(arg, NULL, 10);
		break;
	case 'm':
		env.m = strtoul(arg, NULL, 10);
		break;
	case 'k':
		env.k = strtoul(arg, NULL, 10);
		break;
	case 'n':
		env.n = strtoul(arg, NULL, 10);
		break;
	case 'N':
		env.nloop = strtoul(arg, NULL, 10);
		break;
	case 'i':
		env.set_value = true;
		env.value = atoi(arg);
		break;
	case 'z':
		env.vector = true;
		break;
	case 'v':
		env.verbose = true;
		break;
	case 'V':
		printf("%s\n", version);
		exit(EXIT_SUCCESS);
		break;
	case ARGP_KEY_ARG:
		break;
	case ARGP_KEY_END:
		break;
	default:
		return ARGP_ERR_UNKNOWN;
	}
	return 0;
}

static const struct argp argp = {
	.options = opts,
	.parser = parse_arg,
	.doc = argp_prog_doc,
};

static inline unsigned long nsecs(void)
{
	struct timespec ts;
	clock_gettime(CLOCK_MONOTONIC, &ts);
	return ts.tv_sec * 1000000000UL + ts.tv_nsec;
}

/**
 * A[m*k] * B[k*n] = C[m*n]
 *
 * m=2,k=3,n=2
 *             ┌     ┐
 * ┌       ┐   │ 1 2 │   ┌       ┐
 * │ 1 2 3 │   │     │   │ 22 28 │
 * │       │ * │ 3 4 │ = │       │
 * │ 4 5 6 │   │     │   │ 49 64 │
 * └       ┘   │ 5 6 │   └       ┘
 *             └     ┘
 */
__gpu_global__ void matrix_mul(TYPE *A, TYPE *B, TYPE *C, unsigned long m,
			       unsigned long k, unsigned long n)
{
	unsigned long ia, ib, ic, icx, icy, ik;

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	ic = threadIdx.x + blockDim.x * blockIdx.x;
	if (ic >= m * n)
		return;
#else /* Running on CPU */
	for (ic = 0; ic < m * n; ic++)
#endif
	{
		icx = ic % n;
		icy = ic / n;

		C[ic] = TRVALUE(0.0f);

		for (ik = 0; ik < k; ik++) {
			ia = icy * k + ik;
			ib = ik * n + icx;
#if defined(TEST_FP16)
			C[ic] = __hadd(C[ic], __hmul(A[ia], B[ib]));
#else
			C[ic] += A[ia] * B[ib];
#endif
		}
	}
}

static double matrix_mul_FLOPS(unsigned long ns)
{
	/**
	 * 2.0: plus and multi
	 * 1e9: nanoseconds to seconds
	 */
	return 2.0 * env.m * env.k * env.n * env.nloop * 1e9 / ns;
}

__gpu_global__ void vector_mul(TYPE *A, TYPE *B, TYPE *C, unsigned long N)
{
	unsigned long i;

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	i = threadIdx.x + blockDim.x * blockIdx.x;
	if (i >= N)
		return;
#else
	for (i = 0; i < N; i++)
#endif
	{
#if defined(TEST_FP16)
		C[i] = __hmul(A[i], B[i]);
#else
		C[i] = A[i] * B[i];
#endif
	}
}

static double vector_mul_FLOPS(unsigned long ns)
{
	/**
	 * 1e9: nanoseconds to seconds
	 */
	return env.m * env.k * env.nloop * 1e9 / ns;
}

void init_matrix(TYPE *p, unsigned long n, bool zero, bool set_val, TYPE val)
{
	int i;
	for (i = 0; i < n; i++) {
		if (zero)
			p[i] = TRVALUE(0.0f);
		else if (set_val)
			p[i] = TRVALUE(val);
		else
			p[i] = TRVALUE(i + 1);
#ifdef DEBUG
		printf("p[%d] = " TFMT "\n", i, TVAL(p[i]));
#endif
	}
}

void print_matrix(TYPE *p, unsigned long x, unsigned long y)
{
	int i, j;
	for (j = 0; j < y; j++) {
		for (i = 0; i < x; i++) {
#ifdef DEBUG2
			printf("[%d,%d] = " TFMT "\n", i, j, TVAL(p[j * x + i]));
#else
			printf(TFMT"\t", TVAL(p[j * x + i]));
#endif
		}
		printf("\n");
	}
}

int main(int argc, char *argv[])
{
	unsigned long iloop, i;
	unsigned long start, cal_ns, total_ns;
	int err = 0;
	double flops;
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	unsigned long malloc_ns, h2d_ns, d2h_ns;
	TYPE *dev_A, *dev_B, *dev_C;
	cudaEvent_t ev_start, ev_stop;
#endif
	TYPE *host_A, *host_B, *host_C;

	err = argp_parse(&argp, argc, argv, 0, NULL, NULL);
	if (err) {
		fprintf(stderr, "argp_parse return %d\n", err);
		return -err;
	}

	if (env.vector) {
		unsigned long _i = MAX(env.n, MAX(env.m, env.k));
		env.k = env.n = env.m = _i;
	}

	if (env.verbose) {
		char buf[64];
		fprintf(stderr, "Version %s\n", version);
		fprintf(stderr, "Running on %s %d\n", gpu_name(buf, sizeof(buf)), env.gpu);
		fprintf(stderr, "size of TYPE(%s) %ld\n", TNAME, sizeof(TYPE));
		fprintf(stderr, "M = %ld, N = %ld, NLOOP = %ld\n",
			env.m, env.n, env.nloop);
		if (env.set_value)
			fprintf(stderr, "Matrix values set to %d\n", env.value);
		if (env.vector)
			fprintf(stderr, "Test vector instead of matrix\n");
	}

	gpu_init(env.gpu);

	host_A = (TYPE *)malloc(sizeof(TYPE) * env.m * env.k);
	host_B = (TYPE *)malloc(sizeof(TYPE) * env.k * env.n);
	host_C = (TYPE *)malloc(sizeof(TYPE) * env.m * env.n);
	if (!host_A || !host_B || !host_C)
		goto Malloc_failed;

	init_matrix(host_A, env.m * env.k, false, env.set_value, env.value);
	init_matrix(host_B, env.k * env.n, false, env.set_value, env.value);
	init_matrix(host_C, env.m * env.n, true, false, -1);

#ifdef DEBUG
	print_matrix(host_A, env.k, env.m);
	print_matrix(host_B, env.n, env.k);
#endif

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	cudaEventCreate(&ev_start);
	cudaEventCreate(&ev_stop);

	start = nsecs();

	CUDA_BUG_CALL(cudaMalloc(&dev_A, sizeof(TYPE) * env.m * env.k), goto Malloc_failed)
	CUDA_BUG_CALL(cudaMalloc(&dev_B, sizeof(TYPE) * env.k * env.n), goto Malloc_failed);
	CUDA_BUG_CALL(cudaMalloc(&dev_C, sizeof(TYPE) * env.m * env.n), goto Malloc_failed);

	cudaMemset(dev_A, 0, sizeof(TYPE) * env.m * env.k);
	cudaMemset(dev_B, 0, sizeof(TYPE) * env.k * env.n);
	cudaMemset(dev_C, 0, sizeof(TYPE) * env.m * env.n);

	malloc_ns = nsecs() - start;

	start = nsecs();
	cudaMemcpy(dev_A, host_A, sizeof(TYPE) * env.m * env.k, cudaMemcpyHostToDevice);
	cudaMemcpy(dev_B, host_B, sizeof(TYPE) * env.k * env.n, cudaMemcpyHostToDevice);
	h2d_ns = nsecs() - start;
#endif

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	cudaEventRecord(ev_start);
#else
	start = nsecs();
#endif
	/* Stress test */
	for (iloop = 0; iloop < env.nloop; iloop++) {
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
# define GPU_DIM <<<(env.m * env.n + 511) / 512, 512>>>
#else
# define GPU_DIM
#endif
		if (env.vector)
			vector_mul GPU_DIM (host_A, host_B, host_C, env.m * env.n);
		else
			matrix_mul GPU_DIM (host_A, host_B, host_C, env.m, env.k, env.n);
#undef GPU_DIM
	}
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	cudaEventRecord(ev_stop);
	cudaEventSynchronize(ev_stop);
	float t_ms;
	cudaEventElapsedTime(&t_ms, ev_start, ev_stop);
	cal_ns = t_ms * 1e6;
#else
	cal_ns = nsecs() - start;
#endif

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	start = nsecs();
	cudaMemcpy(host_C, dev_C, sizeof(TYPE) * env.m * env.n, cudaMemcpyDeviceToHost);
	d2h_ns = nsecs() - start;
#endif

#ifdef DEBUG
	print_matrix(host_C, env.n, env.m);
#endif

	/**
	 * If a fixed value is set, we can easily judge the accuracy of the
	 * calculation result.
	 */
	if (env.set_value) {
		TYPE correct_val = TRVALUE(env.value * env.value * env.k);
		for (i = 0; i < env.m * env.n; i++) {
			if (TVAL(host_C[i]) != TVAL(correct_val)) {
				fprintf(stderr, "ERROR: cal matrix mul failed.\n");
				err = -1;
				break;
			}
		}
	}

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	cudaFree(dev_A);
	cudaFree(dev_B);
	cudaFree(dev_C);

	cudaEventDestroy(ev_start);
	cudaEventDestroy(ev_stop);
#endif
	free(host_A);
	free(host_B);
	free(host_C);

	if (env.verbose) {
		printf("%-4s %-4s %-4s %-8s ", "M", "K", "N", "NLOOP");
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
		printf("%-8s %-8s ", "ALLOC", "H2D");
#endif
		printf("%-12s ", "KERNEL");
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
		printf("%-12s ", "D2H");
#endif
		printf("%-12s %-8s\n", "TOTAL", "GFLOPS");
	}

	total_ns = 0;
	printf("%-4ld %-4ld %-4ld %-8ld ", env.m, env.k, env.n, env.nloop);
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	total_ns += malloc_ns + h2d_ns;
	printf("%-8ld %-8ld ", malloc_ns / env.unit_time, h2d_ns / env.unit_time);
#endif
	total_ns += cal_ns;
	printf("%-12ld ", cal_ns / env.unit_time);
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	total_ns += d2h_ns;
	printf("%-12ld ", d2h_ns / env.unit_time);
#endif
	printf("%-12ld ", total_ns / env.unit_time);

	if (env.vector)
		flops = vector_mul_FLOPS(cal_ns);
	else
		flops = matrix_mul_FLOPS(cal_ns);
	printf("%-8.2lf\n", flops / 1e9);

	return 0;

Malloc_failed:
	fprintf(stderr, "ERROR: Malloc failed.\n");
	return err;
}
