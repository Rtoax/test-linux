#include <stdio.h>
#include <hccl.h>
#include "hpcc_helpers.h"


void hc_init(int dev_id)
{
	/* same as cudaSetDevice() */
	hcError_t err = hcSetDevice(dev_id);
	if (err != hcSuccess) {
		printf("Device init failed: %s\n", hcGetErrorString(err));
		exit(1);
	}
}
