#include <stdio.h>
#include <string.h>
#include <hccl.h>
#include "hpcc_helpers.h"


void gpu_init(int dev_id)
{
	int deviceId;
	hcError_t err;

	/* same as cudaSetDevice() */
	err = hcSetDevice(dev_id);
	if (err != hcSuccess) {
		fprintf(stderr, "Device init failed: %s\n", hcGetErrorString(err));
		exit(1);
	}

	err = hcGetDevice(&deviceId);
	if (deviceId != dev_id) {
		fprintf(stderr, "Set Device failed: %s\n", hcGetErrorString(err));
		exit(1);
	}
}

const char *gpu_name(char *buf, int buf_len)
{
	hcDeviceProp_t prop;
	hcError_t err = hcGetDeviceProperties(&prop, 0);
	if (err != hcSuccess) {
		return NULL;
	}
	strncpy(buf, prop.name, buf_len);
	return buf;
}
