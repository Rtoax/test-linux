/**
 * BLAS (Basic Linear Algebra Subprograms)
 *
 * refs:
 * - https://docs.nvidia.com/cuda/cublas/index.html
 */
#include <assert.h>
#include <argp.h>
#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <malloc.h>
#include <time.h>
#if defined(HAVE_HCCL)
# include <hc_runtime.h>
# include <hcblas/hcblas.h>
# include "hpcc_helpers.h"
# include "cuda2hccl.h"
# define NAME	"MetaX BLAS"
#elif defined(HAVE_CUDA)
# include <cuda_runtime.h>
# include <cublas_v2.h>
# include "cuda_helpers.h"
# define NAME	"CUDA BLAS"
#else
# error "Must define one of HAVE_HCCL, HAVE_CUDA"
#endif

#if defined(TEST_DOUBLE)
# define TYPE	double
# define TFMT	"%.2lf"
# define TVAL(v)	(v)
# define TNAME	"double"
# define TRVALUE(v)	(v * 1.0)
#else
# define TYPE	float
# define TFMT	"%.2f"
# define TVAL(v)	(v)
# define TNAME	"float"
# define TRVALUE(v)	(v * 1.0f)
#endif

#define IDX2C(i, j, ld)	(((j) * (ld)) + (i))

enum test_type {
	TEST_SCAL,
	TEST_AXPY,
	TEST_COPY,
	TEST_DOT,
	TEST_NRM2,
#if 0
	TEST_ROT,	/* TODO */
	TEST_ROTG,	/* TODO */
	TEST_ROTM,	/* TODO */
#endif
	TEST_GEMM,
#define TEST_LIST	"scal|axpy|copy|dot|nrm2|gemm"
};

struct {
	int gpu;
	/**
	 * Use m, n first, then, use k (see cublasSgemm()). and m used as rows,
	 * n used as columns.
	 */
	unsigned long m, n, k;
	int alpha, beta;
	unsigned long nloop;
	enum test_type test_type;
	bool set_value;
	unsigned int value;
	bool verbose;
} env = {
	.gpu = 0,
	.m = 6,
	.n = 5,
	.k = 1,
	.alpha = 2,
	.beta = 2,
	.nloop = 1,
	.test_type = TEST_SCAL,
	.set_value = false,
	.value = 0,
	.verbose = false,
};

const char *version = "v0.0.3 (" NAME ")";

const char argp_prog_doc[] =
	"USAGE: [-g <GPU>] [-v] [=t=<" TEST_LIST ">]\n"
	"\n"
	"Examples:\n"
	" $ time ./blas -m10 -n10\n"
	" $ time ./blas -t scal\n";

static const struct argp_option opts[] = {
	{ "gpu", 'g', "GPU", 0, "Running on GPU" },
	{ NULL, 'm', "M", 0, "M number" },
	{ NULL, 'n', "N", 0, "N number" },
	{ NULL, 'k', "K", 0, "K number" },
	{ "alpha", 'A', "ALPHA", 0, "Set alpha value" },
	{ "beta", 'B', "BETA", 0, "Set beta value" },
	{ "type", 't', "TYPE", 0, "set test type" },
	{ "init-val", 'i', "INIT_VAL", 0, "Set matrix values" },
	{ "nloop", 'N', "NLOOP", 0, "Test loop number" },
	{ "verbose", 'v', NULL, 1, "Display detail" },
	{ "version", 'V', NULL, 1, "Display version" },
	{},
};

static void print_blas_version(void)
{
	int major, minor, patch;
	cublasGetProperty(MAJOR_VERSION, &major);
	cublasGetProperty(MINOR_VERSION, &minor);
	cublasGetProperty(PATCH_LEVEL, &patch);
	printf("%s %d.%d.%d\n", NAME, major, minor, patch);
}

static void print_version(void)
{
	print_blas_version();
	printf("test %s\n", version);
}

static inline unsigned long nsecs(void)
{
	struct timespec ts;
	clock_gettime(CLOCK_MONOTONIC, &ts);
	return ts.tv_sec * 1000000000UL + ts.tv_nsec;
}

static error_t parse_arg(int key, char *arg, struct argp_state *state)
{
	switch (key) {
	case 'g':
		env.gpu = strtoul(arg, NULL, 10);
		break;
	case 'm':
		env.m = strtoul(arg, NULL, 10);
		break;
	case 'n':
		env.n = strtoul(arg, NULL, 10);
		break;
	case 'k':
		env.k = strtoul(arg, NULL, 10);
		break;
	case 'A':
		env.alpha = strtoul(arg, NULL, 10);
		break;
	case 'B':
		env.beta = strtoul(arg, NULL, 10);
		break;
	case 't':
		if (!strcmp(arg, "scal"))
			env.test_type = TEST_SCAL;
		else if (!strcmp(arg, "axpy"))
			env.test_type = TEST_AXPY;
		else if (!strcmp(arg, "copy"))
			env.test_type = TEST_COPY;
		else if (!strcmp(arg, "dot"))
			env.test_type = TEST_DOT;
		else if (!strcmp(arg, "nrm2"))
			env.test_type = TEST_NRM2;
		else if (!strcmp(arg, "gemm"))
			env.test_type = TEST_GEMM;
		else {
			fprintf(stderr, "Support TEST TYPE: " TEST_LIST "\n");
			exit(-EINVAL);
		}
		break;
	case 'i':
		env.set_value = true;
		env.value = atoi(arg);
		break;
	case 'N':
		env.nloop = strtoul(arg, NULL, 10);
		break;
	case 'v':
		env.verbose = true;
		break;
	case 'V':
		print_version();
		exit(EXIT_SUCCESS);
		break;
	case ARGP_KEY_ARG:
		break;
	case ARGP_KEY_END:
		break;
	default:
		return ARGP_ERR_UNKNOWN;
	}
	return 0;
}

static const struct argp argp = {
	.options = opts,
	.parser = parse_arg,
	.doc = argp_prog_doc,
};

struct test_operations {
	const char *name;
	cublasHandle_t handle;

	TYPE *host_A, *host_B, *host_C;
	TYPE *dev_A, *dev_B, *dev_C;
	union {
		float f32;
		double f64;
		TYPE result;
	};

	/* operations */
	struct {
		unsigned long start, end;
	} create, prepare, run, display, free, destroy;
	int (*create_blas)(struct test_operations *test);
	int (*prepare_data)(struct test_operations *test);
	int (*run_blas)(struct test_operations *test);
	int (*display_data)(struct test_operations *test);
	int (*free_data)(struct test_operations *test);
	int (*destroy_blas)(struct test_operations *test);
};

int default_create_blas(struct test_operations *test)
{
	int version;
	cublasStatus_t status;

	status = cublasCreate(&test->handle);
	if (status != CUBLAS_STATUS_SUCCESS) {
		fprintf(stderr, "ERROR: Create blas handle failed.\n");
		return -1;
	}

	cublasGetVersion(test->handle, &version);
	if (env.verbose)
		printf("BLAS version %d\n", version);

	return 0;
}

#define __ALLOC_MATRIX_PAIR_FLOAT(type, host, dev, x, y) ({			\
	int i, j, err = 0;							\
	cudaError_t cuerr;							\
	cublasStatus_t status;							\
										\
	*host = (TYPE *)malloc(x * y * sizeof(type));				\
	assert(*host && "Malloc failed");					\
										\
	for (j = 0; j < y; j++) {						\
		for (i = 0; i < x; i++) {					\
			(*host)[IDX2C(i, j, x)] = env.set_value ?		\
						(type)env.value :		\
						(type)(i * y + j + 1);		\
		}								\
	}									\
										\
	cuerr = cudaMalloc(dev, x * y * sizeof(type));				\
	if (cuerr != cudaSuccess) {						\
		fprintf(stderr, "cudaMalloc failed\n");				\
		err = -ENOMEM;							\
	}									\
										\
	status = cublasSetMatrix(x, y, sizeof(type), *host, x, *dev, x);	\
	if (status != CUBLAS_STATUS_SUCCESS) {					\
		fprintf(stderr, "set matrix failed.\n");			\
		err = -1;							\
	}									\
	err;									\
})

int prepare_data_matrix_A(struct test_operations *test)
{
	return __ALLOC_MATRIX_PAIR_FLOAT(TYPE, &test->host_A, &test->dev_A, env.n, env.m);
}

int prepare_data_matrix_sameAB(struct test_operations *test)
{
	int err = 0;
	err += __ALLOC_MATRIX_PAIR_FLOAT(TYPE, &test->host_A, &test->dev_A, env.n, env.m);
	err += __ALLOC_MATRIX_PAIR_FLOAT(TYPE, &test->host_B, &test->dev_B, env.n, env.m);
	return err;
}

int prepare_data_matrix_Gemm(struct test_operations *test)
{
	extern int display_data_Gemm(struct test_operations *test);

	int err = 0;
	err += __ALLOC_MATRIX_PAIR_FLOAT(TYPE, &test->host_A, &test->dev_A, env.k, env.m);
	err += __ALLOC_MATRIX_PAIR_FLOAT(TYPE, &test->host_B, &test->dev_B, env.n, env.k);
	err += __ALLOC_MATRIX_PAIR_FLOAT(TYPE, &test->host_C, &test->dev_C, env.n, env.m);
	err += display_data_Gemm(test);
	return err;
}

/**
 * A[j] = alpha * A[j]
 */
int run_blas_scal(struct test_operations *test)
{
	TYPE alpha = TRVALUE(env.alpha);
#if defined(TEST_DOUBLE)
	cublasDscal(test->handle, env.m * env.n, &alpha, test->dev_A, 1);
#else
	cublasSscal(test->handle, env.m * env.n, &alpha, test->dev_A, 1);
#endif
	return 0;
}

/**
 * B[j] = alpha x A[k] + B[j]
 */
int run_blas_axpy(struct test_operations *test)
{
	TYPE alpha = TRVALUE(env.alpha);
#if defined(TEST_DOUBLE)
	cublasDaxpy(test->handle, env.m * env.n, &alpha, test->dev_A, 1, test->dev_B, 1);
#else
	cublasSaxpy(test->handle, env.m * env.n, &alpha, test->dev_A, 1, test->dev_B, 1);
#endif
	return 0;
}

/**
 * B[j] = A[k]
 */
int run_blas_copy(struct test_operations *test)
{
#if defined(TEST_DOUBLE)
	cublasDcopy(test->handle, env.m * env.n, test->dev_A, 1, test->dev_B, 1);
#else
	cublasScopy(test->handle, env.m * env.n, test->dev_A, 1, test->dev_B, 1);
#endif
	return 0;
}

int run_blas_dot(struct test_operations *test)
{
#if defined(TEST_DOUBLE)
	cublasDdot(test->handle, env.m * env.n, test->dev_A, 1, test->dev_B, 1, &test->result);
#else
	cublasSdot(test->handle, env.m * env.n, test->dev_A, 1, test->dev_B, 1, &test->result);
#endif
	return 0;
}

int run_blas_nrm2(struct test_operations *test)
{
#if defined(TEST_DOUBLE)
	cublasDnrm2(test->handle, env.m * env.n, test->dev_A, 1, &test->result);
#else
	cublasSnrm2(test->handle, env.m * env.n, test->dev_A, 1, &test->result);
#endif
	return 0;
}

int run_blas_Gemm(struct test_operations *test)
{
	cublasStatus_t status;
	TYPE alpha = TRVALUE(env.alpha);
	TYPE beta = TRVALUE(env.beta);

	/**
	 * C^T = B^T * A^T equal to C = A * B
	 */
	status =
#if defined(TEST_DOUBLE)
		cublasDgemm(test->handle, CUBLAS_OP_T, CUBLAS_OP_T,
				env.m, env.n, env.k,
				&alpha,
				test->dev_A, env.k,
				test->dev_B, env.n,
				&beta,
				test->dev_C, env.m);
#else
		cublasSgemm(test->handle, CUBLAS_OP_T, CUBLAS_OP_T,
				env.m, env.n, env.k,
				&alpha,
				test->dev_A, env.k,
				test->dev_B, env.n,
				&beta,
				test->dev_C, env.m);
#endif
	if (status != CUBLAS_STATUS_SUCCESS) {
		fprintf(stderr, "ERROR: cublasSgemm(): %s.\n",
			cublasGetStatusString(status));
		return -status;
	}
	return 0;
}

int __display_matrix_pair(const char *pfx, struct test_operations *test,
			  TYPE *host, TYPE *dev, int x, int y)
{
	cublasStatus_t status;
	int i, j;
	int idx_max, idx_min;
	TYPE sum = 0.0;

#if defined(TEST_DOUBLE)
	cublasIdamax(test->handle, y * x, dev, 1, &idx_max);
	cublasIdamin(test->handle, y * x, dev, 1, &idx_min);
	cublasDasum(test->handle, y * x, dev, 1, &sum);
#else
	cublasIsamax(test->handle, y * x, dev, 1, &idx_max);
	cublasIsamin(test->handle, y * x, dev, 1, &idx_min);
	cublasSasum(test->handle, y * x, dev, 1, &sum);
#endif

	printf("%s>> Device index min %d, index max %d, sum %.2f\n", pfx,
		idx_min, idx_max, sum);

	status = cublasGetMatrix(x, y, sizeof(TYPE), dev, x, host, x);
	if (status != CUBLAS_STATUS_SUCCESS) {
		fprintf(stderr, "get matrix failed.\n");
		return -1;
	}

	sum = 0;

	for (j = 0; j < y; j++) {
		printf("%s>> ", pfx);
		for (i = 0; i < x; i++) {
			sum += host[IDX2C(i, j, x)];
			printf("%7.0f", host[IDX2C(i, j, x)]);
		}
		printf("\n");
	}
	printf("%s>> Host sum %.2lf\n", pfx, sum);
	return 0;
}

int display_data_A(struct test_operations *test)
{
	return __display_matrix_pair("A", test, test->host_A, test->dev_A, env.n, env.m);
}

int display_data_AB(struct test_operations *test)
{
	int err = 0;
	err += __display_matrix_pair("A", test, test->host_A, test->dev_A, env.n, env.m);
	err += __display_matrix_pair("B", test, test->host_B, test->dev_B, env.n, env.m);
	return err;
}

int display_data_dot(struct test_operations *test)
{
	int err = 0;
	err += display_data_AB(test);
	printf("Result %.2f\n", test->result);
	return err;
}

int display_data_nrm2(struct test_operations *test)
{
	int err = 0;
	err += display_data_A(test);
	printf("Result %.2f\n", test->result);
	return err;
}

int display_data_Gemm(struct test_operations *test)
{
	int err = 0;
	err += __display_matrix_pair("A", test, test->host_A, test->dev_A, env.k, env.m);
	err += __display_matrix_pair("B", test, test->host_B, test->dev_B, env.n, env.k);
	err += __display_matrix_pair("C", test, test->host_C, test->dev_C, env.n, env.m);
	return err;
}

int free_data_matrix_A(struct test_operations *test)
{
	cudaFree(test->dev_A);
	free(test->host_A);
	return 0;
}

int free_data_matrix_AB(struct test_operations *test)
{
	cudaFree(test->dev_A);
	cudaFree(test->dev_B);
	free(test->host_A);
	free(test->host_B);
	return 0;
}

int free_data_matrix_ABC(struct test_operations *test)
{
	cudaFree(test->dev_A);
	cudaFree(test->dev_B);
	cudaFree(test->dev_C);
	free(test->host_A);
	free(test->host_B);
	free(test->host_C);
	return 0;
}

int default_destroy_blas(struct test_operations *test)
{
	cublasDestroy(test->handle);
	return 0;
}

struct test_operations testScal = {
	.name = "SCAL",
	.create_blas = default_create_blas,
	.prepare_data = prepare_data_matrix_A,
	.run_blas = run_blas_scal,
	.display_data = display_data_A,
	.free_data = free_data_matrix_A,
	.destroy_blas = default_destroy_blas,
};

struct test_operations testAxpy = {
	.name = "AXPY",
	.create_blas = default_create_blas,
	.prepare_data = prepare_data_matrix_sameAB,
	.run_blas = run_blas_axpy,
	.display_data = display_data_AB,
	.free_data = free_data_matrix_AB,
	.destroy_blas = default_destroy_blas,
};

struct test_operations testCopy = {
	.name = "COPY",
	.create_blas = default_create_blas,
	.prepare_data = prepare_data_matrix_sameAB,
	.run_blas = run_blas_copy,
	.display_data = display_data_AB,
	.free_data = free_data_matrix_AB,
	.destroy_blas = default_destroy_blas,
};

struct test_operations testDot = {
	.name = "DOT",
	.create_blas = default_create_blas,
	.prepare_data = prepare_data_matrix_sameAB,
	.run_blas = run_blas_dot,
	.display_data = display_data_dot,
	.free_data = free_data_matrix_AB,
	.destroy_blas = default_destroy_blas,
};

struct test_operations testNrm2 = {
	.name = "NRM2",
	.create_blas = default_create_blas,
	.prepare_data = prepare_data_matrix_A,
	.run_blas = run_blas_nrm2,
	.display_data = display_data_nrm2,
	.free_data = free_data_matrix_A,
	.destroy_blas = default_destroy_blas,
};

struct test_operations testGemm = {
	.name = "GEMM",
	.create_blas = default_create_blas,
	.prepare_data = prepare_data_matrix_Gemm,
	.run_blas = run_blas_Gemm,
	.display_data = display_data_Gemm,
	.free_data = free_data_matrix_ABC,
	.destroy_blas = default_destroy_blas,
};

int main(int argc, char *argv[])
{
	int err = 0;
	unsigned long n;
	struct test_operations *test = &testScal;

	err = argp_parse(&argp, argc, argv, 0, NULL, NULL);
	if (err) {
		fprintf(stderr, "argp_parse return %d\n", err);
		return -err;
	}

	gpu_init(0);

	if (env.verbose) {
		print_version();
		printf("M = %ld, N = %ld\n", env.m, env.n);
	}

	switch (env.test_type) {
	case TEST_SCAL:
		test = &testScal;
		break;
	case TEST_AXPY:
		test = &testAxpy;
		break;
	case TEST_COPY:
		test = &testCopy;
		break;
	case TEST_DOT:
		test = &testDot;
		break;
	case TEST_NRM2:
		test = &testNrm2;
		break;
	case TEST_GEMM:
		test = &testGemm;
		assert("Not support gemm yet!!!!!");
		break;
	}

	printf("Testing %s for %s (size of %ld)\n", test->name, TNAME, sizeof(TYPE));

	test->create.start = nsecs();
	test->create_blas(test);
	test->create.end = nsecs();

	test->prepare.start = nsecs();
	test->prepare_data(test);
	test->prepare.end = nsecs();

	test->run.start = nsecs();
	for (n = 0; n < env.nloop; n++)
		test->run_blas(test);
	test->run.end = nsecs();

	test->display.start = nsecs();
	test->display_data(test);
	test->display.end = nsecs();

	test->free.start = nsecs();
	test->free_data(test);
	test->free.end = nsecs();

	test->destroy.start = nsecs();
	test->destroy_blas(test);
	test->destroy.end = nsecs();

#define LAT(n) (test->n.end - test->n.start)
	printf("%ld %ld %ld %ld %ld %ld\n", LAT(create), LAT(prepare), LAT(run),
		LAT(display), LAT(free), LAT(destroy));
#undef LAT

	return 0;
}
