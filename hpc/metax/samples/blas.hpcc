// SPDX-License-Identifier: GPL-3.0
/**
 * BLAS (Basic Linear Algebra Subprograms)
 *
 * refs:
 * - https://docs.nvidia.com/cuda/cublas/index.html
 */
#include <assert.h>
#include <argp.h>
#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <malloc.h>
#if defined(HAVE_HCCL)
#include <hc_runtime.h>
#include <hcblas/hcblas.h>
#include "hpcc_helpers.h"
#include "cuda2hccl.h"
#define NAME	"MetaX BLAS"
#elif defined(HAVE_CUDA)
#include <cuda_runtime.h>
#include <cublas_v2.h>
#include "cuda_helpers.h"
#define NAME	"CUDA BLAS"
#else
# error "Must define one of HAVE_HCCL, HAVE_CUDA"
#endif

#define IDX2C(i, j, ld)	(((j) * (ld)) + (i))

struct {
	int gpu;
	unsigned long x;
	unsigned long y;
	bool verbose;
} env = {
	.gpu = 0,
	.x = 6,
	.y = 5,
	.verbose = false,
};

const char *version = "v0.0.2 (" NAME ")";

const char argp_prog_doc[] =
	"USAGE: [-g <GPU>] [-v]\n"
	"\n"
	"Examples:\n"
	" $ time ./blas -x10 -y10";

static const struct argp_option opts[] = {
	{ "gpu", 'g', "GPU", 0, "Running on GPU" },
	{ NULL, 'x', "X", 0, "X number" },
	{ NULL, 'y', "Y", 0, "Y number" },
	{ "verbose", 'v', NULL, 1, "Display detail" },
	{ "version", 'V', NULL, 1, "Display version" },
	{},
};

static void print_blas_version(void)
{
	int major, minor, patch;
	cublasGetProperty(MAJOR_VERSION, &major);
	cublasGetProperty(MINOR_VERSION, &minor);
	cublasGetProperty(PATCH_LEVEL, &patch);
	printf("%s %d.%d.%d\n", NAME, major, minor, patch);
}

static void print_version(void)
{
	print_blas_version();
	printf("test %s\n", version);
}

static error_t parse_arg(int key, char *arg, struct argp_state *state)
{
	switch (key) {
	case 'g':
		env.gpu = strtoul(arg, NULL, 10);
		break;
	case 'x':
		env.x = strtoul(arg, NULL, 10);
		break;
	case 'y':
		env.y = strtoul(arg, NULL, 10);
		break;
	case 'v':
		env.verbose = true;
		break;
	case 'V':
		print_version();
		exit(EXIT_SUCCESS);
		break;
	case ARGP_KEY_ARG:
		break;
	case ARGP_KEY_END:
		break;
	default:
		return ARGP_ERR_UNKNOWN;
	}
	return 0;
}

static const struct argp argp = {
	.options = opts,
	.parser = parse_arg,
	.doc = argp_prog_doc,
};

int main(int argc, char *argv[])
{
	int i, j, blasversion, err = 0;
	cudaError_t cuerr;
	cublasStatus_t status;
	cublasHandle_t blashandle;
	float *dev_A;
	float *host_A;
	float sum, alpha;
	int idx_max, idx_min;

	err = argp_parse(&argp, argc, argv, 0, NULL, NULL);
	if (err) {
		fprintf(stderr, "argp_parse return %d\n", err);
		return -err;
	}

	gpu_init(0);

	if (env.verbose) {
		print_version();
		printf("M = %ld, N = %ld\n", env.x, env.y);
	}

	status = cublasCreate(&blashandle);
	if (status != CUBLAS_STATUS_SUCCESS) {
		fprintf(stderr, "ERROR: Create blas handle failed.\n");
		return -1;
	}

	cublasGetVersion(blashandle, &blasversion);
	if (env.verbose)
		printf("BLAS version %d\n", blasversion);

	host_A = (float *)malloc(env.x * env.y * sizeof(float));
	assert(host_A);

	for (j = 0; j < env.y; j++) {
		for (i = 0; i < env.x; i++) {
			host_A[IDX2C(i, j, env.x)] = (float)(i * env.y + j + 1);
		}
	}

	cuerr = cudaMalloc(&dev_A, env.x * env.y * sizeof(float));
	if (cuerr != cudaSuccess) {
		fprintf(stderr, "cudaMalloc failed\n");
		err = -ENOMEM;
		goto done;
	}

	status = cublasSetMatrix(env.x, env.y, sizeof(float), host_A, env.x, dev_A, env.x);
	if (status != CUBLAS_STATUS_SUCCESS) {
		fprintf(stderr, "set matrix failed.\n");
		err = -1;
		goto done;
	}

	alpha = 2.0;
	cublasSscal(blashandle, env.x * env.y, &alpha, dev_A, 1);

	cublasIsamax(blashandle, env.y * env.x, dev_A, 1, &idx_max);
	cublasIsamin(blashandle, env.y * env.x, dev_A, 1, &idx_min);
	cublasSasum(blashandle, env.y * env.x, dev_A, 1, &sum);

	printf("Index min %d, max %d, %.2f\n", idx_min, idx_max, sum);

	status = cublasGetMatrix(env.x, env.y, sizeof(float), dev_A, env.x, host_A, env.x);
	if (status != CUBLAS_STATUS_SUCCESS) {
		fprintf(stderr, "get matrix failed.\n");
		err = -1;
		goto done;
	}

	sum = 0.0;
	for (j = 0; j < env.y; j++) {
		for (i = 0; i < env.x; i++) {
			sum += host_A[IDX2C(i, j, env.x)];
			printf("%7.0f", host_A[IDX2C(i, j, env.x)]);
		}
		printf("\n");
	}
	printf("Host sum %.2lf\n", sum);

done:
	cublasDestroy(blashandle);
	cudaFree(dev_A);
	free(host_A);
	return err;
}
