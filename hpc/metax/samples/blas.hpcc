/**
 * BLAS (Basic Linear Algebra Subprograms)
 *
 * refs:
 * - https://docs.nvidia.com/cuda/cublas/index.html
 */
#include <assert.h>
#include <argp.h>
#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <malloc.h>
#if defined(HAVE_HCCL)
#include <hc_runtime.h>
#include <hcblas/hcblas.h>
#include "hpcc_helpers.h"
#include "cuda2hccl.h"
#define NAME	"MetaX BLAS"
#elif defined(HAVE_CUDA)
#include <cuda_runtime.h>
#include <cublas_v2.h>
#include "cuda_helpers.h"
#define NAME	"CUDA BLAS"
#else
# error "Must define one of HAVE_HCCL, HAVE_CUDA"
#endif

#define IDX2C(i, j, ld)	(((j) * (ld)) + (i))
enum {
	TEST_SCAL,
	TEST_AXPY,
	TEST_COPY,
#define TEST_LIST	"scal|axpy|copy"
};

struct {
	int gpu;
	unsigned long x;
	unsigned long y;
	int test_type;
	bool verbose;
} env = {
	.gpu = 0,
	.x = 6,
	.y = 5,
	.test_type = TEST_SCAL,
	.verbose = false,
};

const char *version = "v0.0.2 (" NAME ")";

const char argp_prog_doc[] =
	"USAGE: [-g <GPU>] [-v] [=t=<" TEST_LIST ">]\n"
	"\n"
	"Examples:\n"
	" $ time ./blas -x10 -y10\n"
	" $ time ./blas -t scal\n";

static const struct argp_option opts[] = {
	{ "gpu", 'g', "GPU", 0, "Running on GPU" },
	{ NULL, 'x', "X", 0, "X number" },
	{ NULL, 'y', "Y", 0, "Y number" },
	{ "type", 't', "TYPE", 0, "set test type" },
	{ "verbose", 'v', NULL, 1, "Display detail" },
	{ "version", 'V', NULL, 1, "Display version" },
	{},
};

static void print_blas_version(void)
{
	int major, minor, patch;
	cublasGetProperty(MAJOR_VERSION, &major);
	cublasGetProperty(MINOR_VERSION, &minor);
	cublasGetProperty(PATCH_LEVEL, &patch);
	printf("%s %d.%d.%d\n", NAME, major, minor, patch);
}

static void print_version(void)
{
	print_blas_version();
	printf("test %s\n", version);
}

static error_t parse_arg(int key, char *arg, struct argp_state *state)
{
	switch (key) {
	case 'g':
		env.gpu = strtoul(arg, NULL, 10);
		break;
	case 'x':
		env.x = strtoul(arg, NULL, 10);
		break;
	case 'y':
		env.y = strtoul(arg, NULL, 10);
		break;
	case 't':
		if (!strcmp(arg, "scal"))
			env.test_type = TEST_SCAL;
		else if (!strcmp(arg, "axpy"))
			env.test_type = TEST_AXPY;
		else if (!strcmp(arg, "copy"))
			env.test_type = TEST_COPY;
		else {
			fprintf(stderr, "Support TEST TYPE: " TEST_LIST "\n");
			exit(-EINVAL);
		}
		break;
	case 'v':
		env.verbose = true;
		break;
	case 'V':
		print_version();
		exit(EXIT_SUCCESS);
		break;
	case ARGP_KEY_ARG:
		break;
	case ARGP_KEY_END:
		break;
	default:
		return ARGP_ERR_UNKNOWN;
	}
	return 0;
}

static const struct argp argp = {
	.options = opts,
	.parser = parse_arg,
	.doc = argp_prog_doc,
};

struct test_operations {
	/* private */
	const char *name;
	cublasHandle_t handle;
	float *host_A, *host_B, *host_C;
	float *dev_A, *dev_B, *dev_C;
	/* operations */
	int (*create_blas)(struct test_operations *test);
	int (*prepare_data)(struct test_operations *test);
	int (*run_blas)(struct test_operations *test);
	int (*display_data)(struct test_operations *test);
	int (*free_data)(struct test_operations *test);
	int (*destroy_blas)(struct test_operations *test);
};

int default_create_blas(struct test_operations *test)
{
	int version;
	cublasStatus_t status;

	status = cublasCreate(&test->handle);
	if (status != CUBLAS_STATUS_SUCCESS) {
		fprintf(stderr, "ERROR: Create blas handle failed.\n");
		return -1;
	}

	cublasGetVersion(test->handle, &version);
	if (env.verbose)
		printf("BLAS version %d\n", version);

	return 0;
}

int __alloc_and_init_matrix(float **host, float **dev, int x, int y)
{
	int i, j;
	cudaError_t cuerr;
	cublasStatus_t status;

	*host = (float *)malloc(x * y * sizeof(float));
	assert(*host);

	for (j = 0; j < y; j++) {
		for (i = 0; i < x; i++) {
			(*host)[IDX2C(i, j, x)] = (float)(i * y + j + 1);
		}
	}

	cuerr = cudaMalloc(dev, x * y * sizeof(float));
	if (cuerr != cudaSuccess) {
		fprintf(stderr, "cudaMalloc failed\n");
		return -ENOMEM;
	}

	status = cublasSetMatrix(x, y, sizeof(float), *host, x, *dev, x);
	if (status != CUBLAS_STATUS_SUCCESS) {
		fprintf(stderr, "set matrix failed.\n");
		return -1;
	}
	return 0;
}

int prepare_data_matrix_A(struct test_operations *test)
{
	return __alloc_and_init_matrix(&test->host_A, &test->dev_A, env.x, env.y);
}

int prepare_data_matrix_AB(struct test_operations *test)
{
	int err = 0;
	err += __alloc_and_init_matrix(&test->host_A, &test->dev_A, env.x, env.y);
	err += __alloc_and_init_matrix(&test->host_B, &test->dev_B, env.x, env.y);
	return err;
}

/**
 * A[j] = alpha * A[j]
 */
int run_blas_scal(struct test_operations *test)
{
	float alpha = 2.0;
	cublasSscal(test->handle, env.x * env.y, &alpha, test->dev_A, 1);
	return 0;
}

/**
 * B[j] = alpha x A[k] + B[j]
 */
int run_blas_axpy(struct test_operations *test)
{
	float alpha = 3.0;
	cublasSaxpy(test->handle, env.x * env.y, &alpha, test->dev_A, 1, test->dev_B, 1);
	return 0;
}

/**
 * B[j] = A[k]
 */
int run_blas_copy(struct test_operations *test)
{
	cublasScopy(test->handle, env.x * env.y, test->dev_A, 1, test->dev_B, 1);
	return 0;
}

int __display_matrix_pair(const char *pfx, struct test_operations *test,
			  float *host, float *dev, int x, int y)
{
	cublasStatus_t status;
	int i, j;
	int idx_max, idx_min;
	float sum = 0.0;

	cublasIsamax(test->handle, y * x, dev, 1, &idx_max);
	cublasIsamin(test->handle, y * x, dev, 1, &idx_min);
	cublasSasum(test->handle, y * x, dev, 1, &sum);

	printf("%s>> Device index min %d, index max %d, sum %.2f\n", pfx,
		idx_min, idx_max, sum);

	status = cublasGetMatrix(x, y, sizeof(float), dev, x, host, x);
	if (status != CUBLAS_STATUS_SUCCESS) {
		fprintf(stderr, "get matrix failed.\n");
		return -1;
	}

	sum = 0;

	for (j = 0; j < y; j++) {
		printf("%s>> ", pfx);
		for (i = 0; i < x; i++) {
			sum += host[IDX2C(i, j, x)];
			printf("%7.0f", host[IDX2C(i, j, x)]);
		}
		printf("\n");
	}
	printf("%s>> Host sum %.2lf\n", pfx, sum);
	return 0;
}

int display_data_A(struct test_operations *test)
{
	return __display_matrix_pair("A", test, test->host_A, test->dev_A, env.x, env.y);
}

int display_data_AB(struct test_operations *test)
{
	int err = 0;
	err += __display_matrix_pair("A", test, test->host_A, test->dev_A, env.x, env.y);
	err += __display_matrix_pair("B", test, test->host_B, test->dev_B, env.x, env.y);
	return err;
}

int free_data_matrix_A(struct test_operations *test)
{
	cudaFree(test->dev_A);
	free(test->host_A);
	return 0;
}

int free_data_matrix_AB(struct test_operations *test)
{
	cudaFree(test->dev_A);
	cudaFree(test->dev_B);
	free(test->host_A);
	free(test->host_B);
	return 0;
}

int default_destroy_blas(struct test_operations *test)
{
	cublasDestroy(test->handle);
	return 0;
}

struct test_operations testScal = {
	.name = "SCAL",
	.create_blas = default_create_blas,
	.prepare_data = prepare_data_matrix_A,
	.run_blas = run_blas_scal,
	.display_data = display_data_A,
	.free_data = free_data_matrix_A,
	.destroy_blas = default_destroy_blas,
};

struct test_operations testAxpy = {
	.name = "AXPY",
	.create_blas = default_create_blas,
	.prepare_data = prepare_data_matrix_AB,
	.run_blas = run_blas_axpy,
	.display_data = display_data_AB,
	.free_data = free_data_matrix_AB,
	.destroy_blas = default_destroy_blas,
};

struct test_operations testCopy = {
	.name = "COPY",
	.create_blas = default_create_blas,
	.prepare_data = prepare_data_matrix_AB,
	.run_blas = run_blas_copy,
	.display_data = display_data_AB,
	.free_data = free_data_matrix_AB,
	.destroy_blas = default_destroy_blas,
};

int main(int argc, char *argv[])
{
	int err = 0;
	struct test_operations *test = &testScal;

	err = argp_parse(&argp, argc, argv, 0, NULL, NULL);
	if (err) {
		fprintf(stderr, "argp_parse return %d\n", err);
		return -err;
	}

	gpu_init(0);

	if (env.verbose) {
		print_version();
		printf("M = %ld, N = %ld\n", env.x, env.y);
	}

	switch (env.test_type) {
	case TEST_SCAL:
		test = &testScal;
		break;
	case TEST_AXPY:
		test = &testAxpy;
		break;
	case TEST_COPY:
		test = &testCopy;
		break;
	}

	printf("Testing %s\n", test->name);

	test->create_blas(test);
	test->prepare_data(test);
	test->run_blas(test);
	test->display_data(test);
	test->free_data(test);
	test->destroy_blas(test);

	return 0;
}
