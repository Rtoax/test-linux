/**
 * Using GPU to perform matrix multiplication
 *
 * - commit 2506e482755d ("hpc: matrix-mul: Nvidia Tesla T4 vs MetaX ???")
 * - commit 0528d8ab981f ("hpc: matrix-mul: Compare Nvidia H800 & Mars X203 (Metax)")
 */
#include <argp.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <malloc.h>
#if defined(HAVE_HCCL)
#include <hc_runtime.h>
#include "hpcc_helpers.h"
/**
 * Metax has a CUDA-compatible API
 */
#define __gpu_global__	__global__
#define cudaMalloc	hcMalloc
#define cudaFree	hcFree
#define cudaMemset	hcMemset
#define cudaMemcpy	hcMemcpy
#define cudaMemcpyHostToDevice	hcMemcpyHostToDevice
#define cudaMemcpyDeviceToHost	hcMemcpyDeviceToHost
#elif defined(HAVE_CUDA)
#include <cuda_runtime.h>
#include "cuda_helpers.h"
#define __gpu_global__	__global__
#else
#define __gpu_global__
#endif

#if defined(TEST_DOUBLE)
#define TYPE	double
#define TFMT	"%.2lf"
#else
#define TYPE	float
#define TFMT	"%.2f"
#endif

int verbose = false;
int m_num = 3;
int n_num = 2;
unsigned long nloop = 1;
bool set_value = false;
unsigned int value;

const char argp_prog_doc[] =
	"USAGE: [-m <NUM>] [-n <NUM>] [--nloop|-N <NUM>] [-i <VAL>] [-v]\n"
	"\n"
	"Examples:\n"
	" $ time ./matrix-mul -m200 -n200 -N10000 -i2";

static const struct argp_option opts[] = {
	{ "m-num", 'm', "M_NUM", 0, "Matrix M number" },
	{ "n-num", 'n', "N_NUM", 0, "Matrix N number" },
	{ "nloop", 'N', "NLOOP", 0, "Test loop number" },
	{ "init-val", 'i', "INIT_VAL", 0, "Set matrix values" },
	{ "verbose", 'v', NULL, 1, "Display detail" },
	{},
};

static error_t parse_arg(int key, char *arg, struct argp_state *state)
{
	switch (key) {
	case 'm':
		m_num = strtoul(arg, NULL, 10);
		break;
	case 'n':
		n_num = strtoul(arg, NULL, 10);
		break;
	case 'N':
		nloop = strtoul(arg, NULL, 10);
		break;
	case 'i':
		set_value = true;
		value = atoi(arg);
		break;
	case 'v':
		verbose = true;
		break;
	case ARGP_KEY_ARG:
		break;
	case ARGP_KEY_END:
		break;
	default:
		return ARGP_ERR_UNKNOWN;
	}
	return 0;
}

static const struct argp argp = {
	.options = opts,
	.parser = parse_arg,
	.doc = argp_prog_doc,
};

/**
 * A[mn] * B[nm] = C[nn]
 *
 * m=3,n=2
 *             ┌     ┐
 * ┌       ┐   │ 1 2 │   ┌       ┐
 * │ 1 2 3 │   │     │   │ 22 28 │
 * │       │ * │ 3 4 │ = │       │
 * │ 4 5 6 │   │     │   │ 49 64 │
 * └       ┘   │ 5 6 │   └       ┘
 *             └     ┘
 */
__gpu_global__ void matrix_mul(TYPE *A, TYPE *B, TYPE *C, int m, int n)
{
	int ia, ib, ic, icx, icy, im;

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	ic = threadIdx.x + blockDim.x * blockIdx.x;
	if (ic >= n * n)
		return;
#else
	for (ic = 0; ic < n * n; ic++)
#endif
	{
	icx = ic % n;
	icy = ic / n;

	C[ic] = 0;

	for (im = 0; im < m; im++) {
		ia = icy * m + im;
		ib = im * n + icx;
		C[ic] += A[ia] * B[ib];
	}
	}
}

void init_matrix(TYPE *p, int n, bool zero, bool set_val, TYPE val)
{
	int i;
	for (i = 0; i < n; i++) {
		if (zero)
			p[i] = 0.0;
		else if (set_val)
			p[i] = val;
		else
			p[i] = 1.0 * (i + 1);
	}
}

void print_matrix(TYPE *p, int n)
{
	int i;
	for (i = 0; i < n; i++)
		printf(TFMT"%s", p[i], i == n - 1 ? "\0" : ", ");
	printf("\n");
}

int main(int argc, char *argv[])
{
	unsigned long iloop, i;
	int m, n, err;
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	TYPE *A, *B, *C;
#endif
	TYPE *host_A, *host_B, *host_C;

	err = argp_parse(&argp, argc, argv, 0, NULL, NULL);
	if (err) {
		fprintf(stderr, "argp_parse return %d\n", err);
		return -err;
	}

	printf("size of TYPE %ld\n", sizeof(TYPE));
	printf("M = %d, N = %d, NLOOP = %ld\n", m_num, n_num, nloop);
	if (set_value)
		printf("Matrix values set to %d\n", value);

#ifdef HAVE_HCCL
	hc_init(0);
#elif defined(HAVE_CUDA)
	cuda_init(0);
#endif

	m = m_num;
	n = n_num;

	host_A = (TYPE *)malloc(sizeof(TYPE) * m * n);
	host_B = (TYPE *)malloc(sizeof(TYPE) * m * n);
	host_C = (TYPE *)malloc(sizeof(TYPE) * n * n);

	init_matrix(host_A, m * n, false, set_value, value);
	init_matrix(host_B, m * n, false, set_value, value);
	init_matrix(host_C, n * n, true, false, -1);

	if (verbose) {
		print_matrix(host_A, m * n);
		print_matrix(host_B, m * n);
	}

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	cudaMalloc(&A, sizeof(TYPE) * m * n);
	cudaMalloc(&B, sizeof(TYPE) * m * n);
	cudaMalloc(&C, sizeof(TYPE) * n * n);

	cudaMemset(A, 0, sizeof(TYPE) * m * n);
	cudaMemset(B, 0, sizeof(TYPE) * m * n);
	cudaMemset(C, 0, sizeof(TYPE) * n * n);

	cudaMemcpy(A, host_A, sizeof(TYPE) * m * n, cudaMemcpyHostToDevice);
	cudaMemcpy(B, host_B, sizeof(TYPE) * m * n, cudaMemcpyHostToDevice);
#endif

	/* Stress test */
	for (iloop = 0; iloop < nloop; iloop++)
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
		matrix_mul<<<(n * n + 511) / 512, 512>>>(A, B, C, m, n);
#else
		matrix_mul(host_A, host_B, host_C, m, n);
#endif

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	cudaMemcpy(host_C, C, sizeof(TYPE) * n * n, cudaMemcpyDeviceToHost);
#endif

	if (verbose)
		print_matrix(host_C, n * n);

	/**
	 * If a fixed value is set, we can easily judge the accuracy of the
	 * calculation result.
	 */
	if (set_value) {
		TYPE correct_val = value * value * m;
		for (i = 0; i < n * n; i++) {
			if (host_C[i] != correct_val) {
				fprintf(stderr, "ERROR: cal matrix mul failed.\n");
				break;
			}
		}
	}

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	cudaFree(A);
	cudaFree(B);
	cudaFree(C);
#endif
	free(host_A);
	free(host_B);
	free(host_C);

	return 0;
}
