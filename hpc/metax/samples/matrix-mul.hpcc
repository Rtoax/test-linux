#include <argp.h>
#include <stdio.h>
#include <string.h>
#include <malloc.h>
#ifdef HAVE_HCCL
#include <hc_runtime.h>
#endif
#include "hpcc_helpers.h"

int verbose = false;
int m_num = 3;
int n_num = 2;
unsigned long nloop = 1;

const char argp_prog_doc[] =
	"USAGE: [-m <NUM>] [-n <NUM>] [--nloop|-N <NUM>] [-v]\n";

static const struct argp_option opts[] = {
	{ "m-num", 'm', "M_NUM", 0, "Matrix M number" },
	{ "n-num", 'n', "N_NUM", 0, "Matrix N number" },
	{ "nloop", 'N', "NLOOP", 0, "Test loop number" },
	{ "verbose", 'v', NULL, 1, "Display detail" },
	{},
};

static error_t parse_arg(int key, char *arg, struct argp_state *state)
{
	switch (key) {
	case 'm':
		m_num = strtoul(arg, NULL, 10);
		break;
	case 'n':
		n_num = strtoul(arg, NULL, 10);
		break;
	case 'N':
		nloop = strtoul(arg, NULL, 10);
		break;
	case 'v':
		verbose = true;
		break;
	case ARGP_KEY_ARG:
		break;
	case ARGP_KEY_END:
		break;
	default:
		return ARGP_ERR_UNKNOWN;
	}
	return 0;
}

static const struct argp argp = {
	.options = opts,
	.parser = parse_arg,
	.doc = argp_prog_doc,
};

/**
 * A[mn] * B[nm] = C[nn]
 *
 * m=3,n=2
 *             ┌     ┐
 * ┌       ┐   │ 1 2 │   ┌       ┐
 * │ 1 2 3 │   │     │   │ 22 28 │
 * │       │ * │ 3 4 │ = │       │
 * │ 4 5 6 │   │     │   │ 49 64 │
 * └       ┘   │ 5 6 │   └       ┘
 *             └     ┘
 */
__global__ void matrix_mul(float *A, float *B, float *C, int m, int n)
{
	int ia, ib, ic, icx, icy, im;

	ic = threadIdx.x + blockDim.x * blockIdx.x;
	if (ic >= n * n)
		return;

	icx = ic % n;
	icy = ic / n;

	C[ic] = 0;

	for (im = 0; im < m; im++) {
		ia = icy * m + im;
		ib = im * n + icx;
		C[ic] += A[ia] * B[ib];
	}
}

void init_matrix(float *p, int n, bool zero)
{
	int i;
	for (i = 0; i < n; i++) {
		if (zero)
			p[i] = 0.0;
		else
			p[i] = 1.0 * (i + 1);
	}
}

void print_matrix(float *p, int n)
{
	int i;
	for (i = 0; i < n; i++)
		printf("%.2f%s", p[i], i == n - 1 ? "\0" : ", ");
	printf("\n");
}

int main(int argc, char *argv[])
{
	unsigned long iloop;
	int m, n, err;
	float *A, *B, *C, *host_A, *host_B, *host_C;

	err = argp_parse(&argp, argc, argv, 0, NULL, NULL);
	if (err) {
		fprintf(stderr, "argp_parse return %d\n", err);
		return -err;
	}

	printf("M = %d, N = %d, NLOOP = %ld\n", m_num, n_num, nloop);

	hc_init(0);

	m = m_num;
	n = n_num;

	host_A = (float *)malloc(sizeof(float) * m * n);
	host_B = (float *)malloc(sizeof(float) * m * n);
	host_C = (float *)malloc(sizeof(float) * n * n);

	init_matrix(host_A, m * n, false);
	init_matrix(host_B, m * n, false);
	init_matrix(host_C, n * n, true);

	if (verbose) {
		print_matrix(host_A, m * n);
		print_matrix(host_B, m * n);
	}

	hcMalloc(&A, sizeof(float) * m * n);
	hcMalloc(&B, sizeof(float) * m * n);
	hcMalloc(&C, sizeof(float) * n * n);

	hcMemset(A, 0, sizeof(float) * m * n);
	hcMemset(B, 0, sizeof(float) * m * n);
	hcMemset(C, 0, sizeof(float) * n * n);

	hcMemcpy(A, host_A, sizeof(float) * m * n, hcMemcpyHostToDevice);
	hcMemcpy(B, host_B, sizeof(float) * m * n, hcMemcpyHostToDevice);

	/* Stress test */
	for (iloop = 0; iloop < nloop; iloop++)
		matrix_mul<<<(n * n + 511) / 512, 512>>>(A, B, C, m, n);

	hcMemcpy(host_C, C, sizeof(float) * n * n, hcMemcpyDeviceToHost);

	if (verbose)
		print_matrix(host_C, n * n);

	hcFree(A);
	hcFree(B);
	hcFree(C);
	free(host_A);
	free(host_B);
	free(host_C);

	return 0;
}
