/**
 * Using GPU to perform matrix multiplication
 *
 * - commit 2506e482755d ("hpc: matrix-mul: Nvidia Tesla T4 vs MetaX ???")
 * - commit 0528d8ab981f ("hpc: matrix-mul: Compare Nvidia H800 & Mars X203 (Metax)")
 */
#include <argp.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <malloc.h>
#include <time.h>
#if defined(HAVE_HCCL)
#include <hc_runtime.h>
#include "hpcc_helpers.h"
#define __gpu_global__	__global__
#include "cuda2hccl.h"
#elif defined(HAVE_CUDA)
#include <cuda_runtime.h>
#include "cuda_helpers.h"
#define __gpu_global__	__global__
#else
#define __gpu_global__
#endif

#if defined(TEST_DOUBLE)
#define TYPE	double
#define TFMT	"%.2lf"
#else
#define TYPE	float
#define TFMT	"%.2f"
#endif

#define NS2US	1000UL

struct {
	bool verbose;
	unsigned long m;
	unsigned long n;
	unsigned long nloop;
	bool set_value;
	unsigned int value;
	unsigned int unit_time;
} env = {
	.verbose = false,
	.m = 3,
	.n = 2,
	.nloop = 1,
	.set_value = false,
	.value = 0,
	.unit_time = NS2US,
};

const char argp_prog_doc[] =
	"USAGE: [-m <NUM>] [-n <NUM>] [--nloop|-N <NUM>] [-i <VAL>] [-v]\n"
	"\n"
	"Examples:\n"
	" $ time ./matrix-mul -m200 -n200 -N10000 -i2";

static const struct argp_option opts[] = {
	{ "m-num", 'm', "M_NUM", 0, "Matrix M number" },
	{ "n-num", 'n', "N_NUM", 0, "Matrix N number" },
	{ "nloop", 'N', "NLOOP", 0, "Test loop number" },
	{ "init-val", 'i', "INIT_VAL", 0, "Set matrix values" },
	{ "verbose", 'v', NULL, 1, "Display detail" },
	{},
};

static error_t parse_arg(int key, char *arg, struct argp_state *state)
{
	switch (key) {
	case 'm':
		env.m = strtoul(arg, NULL, 10);
		break;
	case 'n':
		env.n = strtoul(arg, NULL, 10);
		break;
	case 'N':
		env.nloop = strtoul(arg, NULL, 10);
		break;
	case 'i':
		env.set_value = true;
		env.value = atoi(arg);
		break;
	case 'v':
		env.verbose = true;
		break;
	case ARGP_KEY_ARG:
		break;
	case ARGP_KEY_END:
		break;
	default:
		return ARGP_ERR_UNKNOWN;
	}
	return 0;
}

static const struct argp argp = {
	.options = opts,
	.parser = parse_arg,
	.doc = argp_prog_doc,
};

static inline unsigned long nsecs(void)
{
	struct timespec ts;
	clock_gettime(CLOCK_MONOTONIC, &ts);
	return ts.tv_sec * 1000000000UL + ts.tv_nsec;
}

/**
 * A[mn] * B[nm] = C[nn]
 *
 * m=3,n=2
 *             ┌     ┐
 * ┌       ┐   │ 1 2 │   ┌       ┐
 * │ 1 2 3 │   │     │   │ 22 28 │
 * │       │ * │ 3 4 │ = │       │
 * │ 4 5 6 │   │     │   │ 49 64 │
 * └       ┘   │ 5 6 │   └       ┘
 *             └     ┘
 */
__gpu_global__ void matrix_mul(TYPE *A, TYPE *B, TYPE *C, unsigned long m,
			       unsigned long n)
{
	int ia, ib, ic, icx, icy, im;

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	ic = threadIdx.x + blockDim.x * blockIdx.x;
	if (ic >= n * n)
		return;
#else /* Running on CPU */
	for (ic = 0; ic < n * n; ic++)
#endif
	{
		icx = ic % n;
		icy = ic / n;

		C[ic] = 0;

		for (im = 0; im < m; im++) {
			ia = icy * m + im;
			ib = im * n + icx;
			C[ic] += A[ia] * B[ib];
		}
	}
}

static double matrix_mul_FLOPS(unsigned long ns)
{
	/**
	 * 2.0: plus and multi
	 * 1e9: nanoseconds to seconds
	 */
	return 2.0 * env.m * env.n * env.n * env.nloop * 1e9 / ns;
}

void init_matrix(TYPE *p, unsigned long n, bool zero, bool set_val, TYPE val)
{
	int i;
	for (i = 0; i < n; i++) {
		if (zero)
			p[i] = 0.0;
		else if (set_val)
			p[i] = val;
		else
			p[i] = 1.0 * (i + 1);
	}
}

void print_matrix(TYPE *p, unsigned long n)
{
	int i;
	for (i = 0; i < n; i++)
		printf(TFMT"%s", p[i], i == n - 1 ? "\0" : ", ");
	printf("\n");
}

int main(int argc, char *argv[])
{
	unsigned long iloop, i;
	unsigned long start, cal_ns, total_ns;
	int err = 0;
	double flops;
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	unsigned long malloc_ns, h2d_ns, d2h_ns;
	TYPE *dev_A, *dev_B, *dev_C;
	cudaEvent_t ev_start, ev_stop;
#endif
	TYPE *host_A, *host_B, *host_C;

	err = argp_parse(&argp, argc, argv, 0, NULL, NULL);
	if (err) {
		fprintf(stderr, "argp_parse return %d\n", err);
		return -err;
	}

	if (env.verbose) {
#ifdef HAVE_HCCL
		fprintf(stderr, "MetaX HCCL\n");
#elif defined(HAVE_CUDA)
		fprintf(stderr, "Nvidia CUDA\n");
#endif
		fprintf(stderr, "size of TYPE %ld\n", sizeof(TYPE));
		fprintf(stderr, "M = %ld, N = %ld, NLOOP = %ld\n",
			env.m, env.n, env.nloop);
		if (env.set_value)
			fprintf(stderr, "Matrix values set to %d\n", env.value);
	}

#ifdef HAVE_HCCL
	hc_init(0);
#elif defined(HAVE_CUDA)
	cuda_init(0);
#endif

	host_A = (TYPE *)malloc(sizeof(TYPE) * env.m * env.n);
	host_B = (TYPE *)malloc(sizeof(TYPE) * env.m * env.n);
	host_C = (TYPE *)malloc(sizeof(TYPE) * env.n * env.n);

	init_matrix(host_A, env.m * env.n, false, env.set_value, env.value);
	init_matrix(host_B, env.m * env.n, false, env.set_value, env.value);
	init_matrix(host_C, env.n * env.n, true, false, -1);

#ifdef DEBUG
	print_matrix(host_A, env.m * env.n);
	print_matrix(host_B, env.m * env.n);
#endif

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)

	cudaEventCreate(&ev_start);
	cudaEventCreate(&ev_stop);

	start = nsecs();

	cudaMalloc(&dev_A, sizeof(TYPE) * env.m * env.n);
	cudaMalloc(&dev_B, sizeof(TYPE) * env.m * env.n);
	cudaMalloc(&dev_C, sizeof(TYPE) * env.n * env.n);

	cudaMemset(dev_A, 0, sizeof(TYPE) * env.m * env.n);
	cudaMemset(dev_B, 0, sizeof(TYPE) * env.m * env.n);
	cudaMemset(dev_C, 0, sizeof(TYPE) * env.n * env.n);

	malloc_ns = nsecs() - start;

	start = nsecs();
	cudaMemcpy(dev_A, host_A, sizeof(TYPE) * env.m * env.n, cudaMemcpyHostToDevice);
	cudaMemcpy(dev_B, host_B, sizeof(TYPE) * env.m * env.n, cudaMemcpyHostToDevice);
	h2d_ns = nsecs() - start;
#endif

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	cudaEventRecord(ev_start);
#else
	start = nsecs();
#endif
	/* Stress test */
	for (iloop = 0; iloop < env.nloop; iloop++) {
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
		matrix_mul<<<(env.n * env.n + 511) / 512, 512>>>(dev_A, dev_B, dev_C, env.m, env.n);
#else
		matrix_mul(host_A, host_B, host_C, env.m, env.n);
#endif
	}
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	cudaEventRecord(ev_stop);
	cudaEventSynchronize(ev_stop);
	float t_ms;
	cudaEventElapsedTime(&t_ms, ev_start, ev_stop);
	cal_ns = t_ms * 1e6;
#else
	cal_ns = nsecs() - start;
#endif

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	start = nsecs();
	cudaMemcpy(host_C, dev_C, sizeof(TYPE) * env.n * env.n, cudaMemcpyDeviceToHost);
	d2h_ns = nsecs() - start;
#endif

#ifdef DEBUG
	print_matrix(host_C, env.n * env.n);
#endif

	/**
	 * If a fixed value is set, we can easily judge the accuracy of the
	 * calculation result.
	 */
	if (env.set_value) {
		TYPE correct_val = env.value * env.value * env.m;
		for (i = 0; i < env.n * env.n; i++) {
			if (host_C[i] != correct_val) {
				fprintf(stderr, "ERROR: cal matrix mul failed.\n");
				err = -1;
				break;
			}
		}
	}

#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	cudaFree(dev_A);
	cudaFree(dev_B);
	cudaFree(dev_C);
#endif
	free(host_A);
	free(host_B);
	free(host_C);

	if (env.verbose) {
		printf("%-8s %-8s %-8s ", "M", "N", "NLOOP");
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
		printf("%-8s %-8s ", "ALLOC", "H2D");
#endif
		printf("%-16s ", "KERNEL");
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
		printf("%-16s ", "D2H");
#endif
		printf("%-16s %-8s\n", "TOTAL", "FLOPS");
	}

	total_ns = 0;
	printf("%-8ld %-8ld %-8ld ", env.m, env.n, env.nloop);
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	total_ns += malloc_ns + h2d_ns;
	printf("%-8ld %-8ld ", malloc_ns / env.unit_time, h2d_ns / env.unit_time);
#endif
	total_ns += cal_ns;
	printf("%-16ld ", cal_ns / env.unit_time);
#if defined(HAVE_HCCL) || defined(HAVE_CUDA)
	total_ns += d2h_ns;
	printf("%-16ld ", d2h_ns / env.unit_time);
#endif
	printf("%-16ld ", total_ns / env.unit_time);

	flops = matrix_mul_FLOPS(cal_ns);
	printf("%-8.2lf\n", flops);

	return err;
}
