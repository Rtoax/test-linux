#!/bin/env bpftrace

BEGIN
{
	printf("Tracing CUDA Kernel Launch, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s\n", "TIME", "PID", "COMM");
}

uprobe:/opt/hpcc/lib/libhcruntime.so:hcLaunchKernel,
uprobe:/opt/luca/lib/libhcruntime.so:hcLaunchKernel,
uprobe:/lib64/libcuda.so:cuLaunchKernel
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %s\n", pid, comm, probe);
}

uretprobe:/opt/hpcc/lib/libhcruntime.so:hcLaunchKernel,
uretprobe:/opt/luca/lib/libhcruntime.so:hcLaunchKernel,
uretprobe:/lib64/libcuda.so:cuLaunchKernel
{
	printf("%s return\n", probe);
}

END
{
	printf("Bye.\n");
}
