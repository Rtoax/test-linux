#!/bin/env bpftrace

BEGIN
{
	printf("Tracing CUDA Kernel Launch, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s\n", "TIME", "PID", "COMM");
}

uprobe:/opt/hpcc/lib/libhcruntime.so:hcLaunchKernel,
uprobe:/lib64/libcuda.so:cuLaunchKernel
{
	time("%H:%M:%S ");
	printf("%-8d %-16s\n", pid, comm);
}

END
{
	printf("Bye.\n");
}
