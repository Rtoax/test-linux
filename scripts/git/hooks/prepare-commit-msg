#!/bin/bash

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2
SHA1=$3

# Remove old Env first.
sed -i '/^Env:/d' ${COMMIT_MSG_FILE}

readonly MY_DIRECTORY=$(dirname $(realpath $0))
readonly GIT_TOPDIR=$(git rev-parse --show-toplevel 2>/dev/null || :)
readonly first_nonempyline=$(sed -n '/[^[:space:]]/ { =; q }' ${COMMIT_MSG_FILE})
readonly signed_off_by_line=$(awk '/^Signed-off-by:/{print NR; exit}' ${COMMIT_MSG_FILE})

# Changed file list (new, deleted, added, modified)
CHANGED_FILES=( $( ${MY_DIRECTORY}/get-commit-file-list ) )

# git commit --amend
if [ "$COMMIT_SOURCE" = "commit" ] && [ "$SHA1" = "HEAD" ]; then
	CHANGED_FILES+=( $(git log -1 --oneline --name-only --pretty=format:) )
fi

Environment=""

add_env() {
	[[ -z "${@}" ]] && return 0
	[[ ${Environment} ]] && Environment+=", "
	Environment+="$@"
}

# input some key words.
# echo "YES" if any key matched.
files_have_key() {
	local key
	for key in ${@}
	do
		if [[ "$(echo ${CHANGED_FILES[@]} | grep -o ${key})" ]]; then
			echo "YES"
			return 0
		fi
	done
	return 0
}

if [[ -z ${signed_off_by_line} ]]; then
	echo >&2 "ERROR: must signed with -s/--signoff"
	exit 1
fi

# OS version
if [[ -e /etc/os-release ]]; then
	os_env=
	. /etc/os-release
	os_env+="${NAME}"
	if [[ ${VERSION_ID} ]]; then
		os_env+=" ${VERSION_ID}"
	elif [[ ${VERSION} ]]; then
		os_env+=" ${VERSION}"
	fi
	add_env "${os_env}"
fi

# Kernel version
add_env "Kernel $(uname -r)"

# GCC version
GCC=$(which gcc 2>/dev/null || :)
if [[ ${GCC} ]]; then
	gcc_ver=$(${GCC} -dumpfullversion -dumpversion)
	add_env "GCC ${gcc_ver}"
fi

# Glibc version
add_env "$(getconf GNU_LIBC_VERSION 2>/dev/null || :)"

# LLVM version
LLVM_CONFIG=$(which llvm-config 2>/dev/null || :)
if [[ ${LLVM_CONFIG} ]]; then
	llvm_ver=$(${LLVM_CONFIG} --version)
	add_env "LLVM ${llvm_ver}"
fi

if [[ "$(files_have_key cuda nvidia)" ]]; then
	cuda_ver=$(${GIT_TOPDIR}/hpc/nvidia/cuda/version.sh)
	add_env "CUDA ${cuda_ver}"
	# TODO: add ROCm hipcc, metax, hpcc, luca, etc.
fi

# Add lines
if [[ ${Environment} ]]; then
	sed -i "${signed_off_by_line}i Env: ${Environment}" ${COMMIT_MSG_FILE}
fi
