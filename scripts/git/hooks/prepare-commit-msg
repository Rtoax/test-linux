#!/bin/bash
# Copyright (C) 2025-2026 Rong Tao
#
# Usage:
# [ALL=1] [V2=1] [F2=1] git commit ...
#
[[ ${V2} ]] && set -x

readonly COMMIT_MSG_FILE=$1
readonly COMMIT_SOURCE=$2 # commit, merge
readonly COMMIT_SHA1=$3

readonly MY_DIRECTORY=$(dirname $(realpath $0))
readonly TOPDIR=$(realpath ${MY_DIRECTORY}/../../../)
readonly first_nonempyline=$(sed -n '/[^[:space:]]/ { =; q }' ${COMMIT_MSG_FILE})
readonly first_commentline=$(sed -n '/^#/ { =; q }' ${COMMIT_MSG_FILE})
readonly signed_off_by_line=$(awk '/^Signed-off-by:/{print NR; exit}' ${COMMIT_MSG_FILE})

readonly UNCOMMITTED_FILES=( $( ${MY_DIRECTORY}/../uncommitted-files.sh ) )
readonly LAST_SUBMITTED_FILES=( $(git log -1 --oneline --name-only --pretty=format:) )

# Changed file list (new, deleted, added, modified)
declare -a CHANGED_FILES SHEBANGS

# Remove old Env first.
sed -i '/^Vers:/d' ${COMMIT_MSG_FILE}
sed -i '/^Envs:/d' ${COMMIT_MSG_FILE}

CHANGED_FILES+=( ${UNCOMMITTED_FILES[@]} )

# git commit --amend
if [ "$COMMIT_SOURCE" = "commit" ] && [ "$COMMIT_SHA1" = "HEAD" ]; then
	CHANGED_FILES+=( ${LAST_SUBMITTED_FILES[@]} )
fi

for f in ${CHANGED_FILES[@]}; do
	ext=${f##*.}

	# This file have no extension, try to get it's shebang.
	if [[ ${ext} == ${f} ]]; then
		shebang="$(grep ^'#!' ${TOPDIR}${f} 2>/dev/null | tr -d '#!' || true)"
		if [[ ! -z ${shebang} ]]; then
			SHEBANGS+=( ${shebang} )
		fi
	fi
done
readonly CHANGED_FILES_RO=( ${CHANGED_FILES[@]} )

Versions=""
Environments=""

fatal() {
	echo >&2 "FATAL: "${@}", set F2=1 or V2=1"
	[[ -z ${F2} ]] && exit 1
}

warning() {
	echo >&2 "WARNING: "${@}
}

# $1: specify mode, values: WEAK, STRONG
__add_ver() {
	local mode=$1
	shift

	[[ -z "${@}" ]] && fatal "Bad call of add_ver()"
	[[ -z ${CHANGED_FILES_RO} ]] && return 0

	if [[ -z "$(echo ${@} | grep -oE '[0-9]')" ]]; then
		local msg="Can't found version string from '${@}'"
		if [[ ${mode} == STRONG ]]; then
			fatal "${msg}"
		else
			warning "${msg}"
		fi
		# Return directly
		return 0
	fi

	# Already exist
	if [[ "${Versions}" =~ "${@}" ]]; then
		return 0
	fi

	[[ ${Versions} ]] && Versions+=", "
	Versions+="$@"
}
add_ver_weak() {
	__add_ver WEAK "$@"
}
add_ver() {
	__add_ver STRONG "$@"
}

add_env() {
	[[ -z ${CHANGED_FILES_RO} ]] && return 0

	[[ -z "${@}" ]] && return 0

	# Already exist
	if [[ "${Environments}" =~ "${@}" ]]; then
		return 0
	fi

	[[ ${Environments} ]] && Environments+=", "
	Environments+="$@"
}

# input some key words.
# echo "YES" if any key matched.
has_key() {
	local key

	[[ ${ALL} ]] && echo "YES" && return 0

	for key in ${@}
	do
		# Match the whole word
		if [[ "$(echo ${CHANGED_FILES_RO[@]} | grep -wo ${key})" ]]; then
			echo "YES"
			return 0
		fi
		if [[ "$(echo ${SHEBANGS[@]} | grep -wo ${key})" ]]; then
			echo "YES"
			return 0
		fi
	done
	return 0
}

# input some key words, such as c, cpp, sh, cu
# echo "YES" if any file type matched.
has_type() {
	local ext

	[[ ${ALL} ]] && echo "YES" && return 0

	for ext in ${@}
	do
		# a.c b.sh -> c sh
		if [[ " ${CHANGED_FILES_RO[@]##*.} " =~ " ${ext} " ]]; then
			echo "YES"
			return 0
		fi
	done
	return 0
}

# has content in patch
has_content() {
	local str

	[[ ${ALL} ]] && echo "YES" && return 0

	for str in ${@}
	do
		# search the 'str' in patch
		if [[ "$(git status --verbose | grep -o ${str})" ]]; then
			echo "YES"
			return 0
		fi
	done
	return 0
}

add_bcc_ver() { add_ver "BCC $(${TOPDIR}/bpf/bcc/version.sh)"; }
add_bpftool_ver() { add_ver "bpftool $(${TOPDIR}/bpf/bpftool/version.sh)"; }
add_bpftrace_ver() { add_ver "BPFTrace $(${TOPDIR}/bpf/bpftrace/version.sh)"; }
add_cmake_ver() { add_ver "CMake $(${TOPDIR}/tools/cmake/version.sh)"; }
add_cuda_ver() { add_ver "CUDA $(${TOPDIR}/hpc/nvidia/cuda/version.sh)"; }
add_findutils_ver() { add_ver "Findutils $(${TOPDIR}/gnu/findutils/version.sh)"; }
add_gcc_ver() { add_ver "GCC $(${TOPDIR}/gnu/gcc/version.sh)"; }
add_gdb_ver() { add_ver "GDB $(${TOPDIR}/gnu/gdb/version.sh)"; }
add_git_ver() { add_ver "Git $(${TOPDIR}/scripts/git/version.sh)"; }
add_glibc_ver() { add_ver "$(getconf GNU_LIBC_VERSION 2>/dev/null)"; }
add_gnome_ver() { add_ver "GNOME $(${TOPDIR}/gnome/version.sh)"; }
add_hpcc_ver() { add_ver_weak "HPCC $(${TOPDIR}/hpc/metax/hpcc/version.sh)"; }
add_libbpf_ver() { add_ver "LibBpf $(${TOPDIR}/bpf/libbpf/version.sh)"; }
add_llvm_ver() { add_ver "LLVM $(${TOPDIR}/compiler/llvm/version.sh)"; }
add_lsof_ver() { add_ver "lsof $(${TOPDIR}/tools/lsof/version.sh)"; }
add_luca_ver() { add_ver_weak "LUCA $(${TOPDIR}/hpc/cestc/luca/version.sh)"; }
add_make_ver() { add_ver "Make $(${TOPDIR}/gnu/make/version.sh)"; }
add_numactl_ver() { add_ver "NUMACTL $(${TOPDIR}/numa/numactl/version.sh)"; }
add_openssl_ver() { add_ver "OpenSSL $(${TOPDIR}/security/openssl/version.sh)"; }
add_os_ver() { add_ver "$(${TOPDIR}/distro/version.sh)"; }
add_ostree_ver() { add_ver "RPM $(${TOPDIR}/tools/ostree/version.sh)"; }
add_pahole_ver() { add_ver "Pahole $(${TOPDIR}/pahole/version.sh)"; }
add_pciutils_ver() { add_ver "PCIUtils $(${TOPDIR}/driver/pcie/pciutils/version.sh)"; }
add_podman_ver() { add_ver "Podman $(${TOPDIR}/tools/podman/version.sh)"; }
add_procps_ver() { add_ver "Procps-ng $(${TOPDIR}/fs/procfs/procps-ng/version.sh)"; }
add_psmisc_ver() { add_ver "Psmisc $(${TOPDIR}/tools/psmisc/version.sh)"; }
add_py_ver() { add_ver "Python $(${TOPDIR}/python/version.sh)"; }
add_qemu_ver() { add_ver "Qemu $(${TOPDIR}/qemu/version.sh)"; }
add_rocm_ver() { add_ver_weak "ROCm $(${TOPDIR}/hpc/amd/rocm/version.sh)"; }
add_rpm_ver() { add_ver "RPM $(${TOPDIR}/distro/rpm/version.sh)"; }
add_rust_ver() { add_ver "Rust $(${TOPDIR}/rust/version.sh)"; }
add_shell_ver() { add_ver "$(${TOPDIR}/shell/version.sh --name) $(${TOPDIR}/shell/version.sh)"; }
add_strace_ver() { add_ver "Strace $(${TOPDIR}/syscall/strace/version.sh)"; }
add_systemd_ver() { add_ver "Systemd $(${TOPDIR}/init/systemd/version.sh)"; }
add_vim_ver() { add_ver "Vim $(${TOPDIR}/tools/vim/version.sh)"; }

add_cpu_env() { add_env "$(${TOPDIR}/cpu/cpuname.sh)"; add_env "$(uname -m)"; }
add_pid1_env() { add_env "pid1=$(cat /proc/1/comm)"; }
add_virt_env() { add_env "$(${TOPDIR}/virt/virttype.sh)"; }

if [[ -z ${signed_off_by_line} ]] && [[ ${COMMIT_SOURCE} != merge ]]; then
	fatal "must signed with -s/--signoff"
fi

if [[ -z ${signed_off_by_line} ]]; then
	warning "Skipping git hooks of prepare-commit-msg"
	exit 0
fi

# __main__
if [[ "$(has_type asm S)$(has_key asm arch insn cpu)" ]]; then
	add_cpu_env
	add_virt_env
fi

add_os_ver
add_ver "Linux $(uname -r)"

if [[ "$(has_type c cpp c++ h hpp)$(has_key cpp gcc compiler)" ]]; then
	add_gcc_ver
fi

if [[ "$(has_type gdb)$(has_key gdb)" ]]; then
	add_gdb_ver
fi

if [[ "$(has_key find)" ]]; then
	add_findutils_ver
fi

if [[ "$(has_type c cpp c++ h hpp)$(has_key glibc ipc socket)" ]]; then
	add_glibc_ver
fi

if [[ "$(has_type sh bash)$(has_key bash shell)" ]]; then
	add_shell_ver
fi

if [[ "$(has_type service)$(has_key systemd)$(has_content systemd journal)" ]]; then
	add_systemd_ver
fi

if [[ "$(has_key strace)" ]]; then
	add_strace_ver
fi

if [[ "$(has_key qcow qcow2 qcow3 qemu)" ]]; then
	add_virt_env
	add_qemu_ver
fi

if [[ "$(has_type mk make)$(has_key make Makefile)" ]]; then
	add_make_ver
fi

if [[ "$(has_type rpm)$(has_key rpm dnf)" ]]; then
	add_rpm_ver
fi

if [[ "$(has_type rs)$(has_key rust)" ]]; then
	add_rust_ver
fi

if [[ "$(has_key ostree)" ]]; then
	add_ostree_ver
fi

if [[ "$(has_type cmake)$(has_key cmake CMake)" ]]; then
	add_cmake_ver
fi

if [[ "$(has_key podman Dockerfile)" ]]; then
	add_podman_ver
fi

if [[ "$(has_key procps ps pgrep)" ]]; then
	add_procps_ver
fi

if [[ "$(has_key psmisc killall prtstat pstree fuser)" ]]; then
	add_psmisc_ver
fi

if [[ "$(has_key gnome)" ]]; then
	add_gnome_ver
fi

if [[ "$(has_type vim)$(has_key vim)" ]]; then
	add_vim_ver
fi

if [[ "$(has_key libbpf pahole)" ]]; then
	add_pahole_ver
fi

if [[ "$(has_key pci pcie)" ]]; then
	add_pciutils_ver
fi

if [[ "$(has_key git)" ]]; then
	add_git_ver
fi

if [[ "$(has_key numa numactl)" ]]; then
	add_numactl_ver
fi

if [[ "$(has_type bt)$(has_key bpftrace)" ]]; then
	add_bpftrace_ver
fi

if [[ "$(has_type pem)$(has_key ssl openssl)" ]]; then
	add_openssl_ver
fi

if [[ "$(has_key bpftool)" ]]; then
	add_bpftool_ver
fi

if [[ "$(has_key llvm bt nvidia)" ]]; then
	add_llvm_ver
fi

if [[ "$(has_key cuda nvidia)" ]]; then
	name=$(${TOPDIR}/hpc/nvidia/gpuname.sh)
	if [[ ! -z ${name} ]]; then
		add_env "${name}"
	fi
	add_cuda_ver
	add_llvm_ver
fi

if [[ "$(has_key cuda nvidia rocm amd ROCm AMD)" ]]; then
	add_rocm_ver
	add_llvm_ver
fi

if [[ "$(has_key cuda nvidia luca LUCA cestc CESTC)" ]]; then
	name=$(${TOPDIR}/hpc/cestc/lingspeed/gpuname.sh)
	if [[ ! -z ${name} ]]; then
		add_env "${name}"
	fi
	add_luca_ver
	add_llvm_ver
fi

[[ "$(has_key lsof)" ]] && add_lsof_ver

if [[ "$(has_key cuda nvidia hpcc HPCC metax MetaX)" ]]; then
	add_hpcc_ver
	add_llvm_ver
fi

if [[ "$(has_key libbpf bcc bpf)" ]]; then
	add_bcc_ver
	add_libbpf_ver
fi

if [[ "$(has_key ai pytorch python py)" ]]; then
	add_py_ver
fi

# Add lines
if [[ ${Versions} ]]; then
	sed -i "$((${signed_off_by_line}+1))i Vers: ${Versions}" ${COMMIT_MSG_FILE} || {
		fatal "Failed handle Vers: ${Versions}"
	}
fi
if [[ ${Environments} ]]; then
	sed -i "$((${signed_off_by_line}+1))i Envs: ${Environments}" ${COMMIT_MSG_FILE} || {
		fatal "Failed handle Envs: ${Environments}"
	}
fi
