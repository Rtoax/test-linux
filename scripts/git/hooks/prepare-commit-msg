#!/bin/bash
# Copyright (C) 2025-2026 Rong Tao
#
# Usage:
# $ [AV=1] [VCM=1] [FCM=1] git commit ...
# - AV: Match all versions
# - VCM: Verbose mode of Commit Message
# - FCM: Force mode of Commit Message
[[ ${VCM} ]] && set -x

readonly COMMIT_MSG_FILE=$1
readonly COMMIT_SOURCE=$2 # commit, merge
readonly COMMIT_SHA1=$3

readonly MY_DIRECTORY=$(dirname $(realpath $0))
readonly TOPDIR=$(realpath ${MY_DIRECTORY}/../../../)
readonly VERDIR=${TOPDIR}/scripts/version
readonly first_nonempyline=$(sed -n '/[^[:space:]]/ { =; q }' ${COMMIT_MSG_FILE})
readonly first_commentline=$(sed -n '/^#/ { =; q }' ${COMMIT_MSG_FILE})
readonly signed_off_by_line=$(awk '/^Signed-off-by:/{print NR; exit}' ${COMMIT_MSG_FILE})

readonly UNCOMMITTED_FILES=( $( ${MY_DIRECTORY}/../uncommitted-files.sh ) )
readonly LAST_SUBMITTED_FILES=( $(git log -1 --oneline --name-only --pretty=format:) )

# Changed file list (new, deleted, added, modified)
declare -a CHANGED_FILES SHEBANGS

# Remove old Env first.
sed -i '/^Vers:/d' ${COMMIT_MSG_FILE}
sed -i '/^Envs:/d' ${COMMIT_MSG_FILE}

CHANGED_FILES+=( ${UNCOMMITTED_FILES[@]} )

# git commit --amend
if [ "$COMMIT_SOURCE" = "commit" ] && [ "$COMMIT_SHA1" = "HEAD" ]; then
	CHANGED_FILES+=( ${LAST_SUBMITTED_FILES[@]} )
fi

for f in ${CHANGED_FILES[@]}; do
	ext=${f##*.}

	# This file have no extension, try to get it's shebang.
	if [[ ${ext} == ${f} ]]; then
		shebang="$(grep ^'#!' ${TOPDIR}${f} 2>/dev/null | tr -d '#!' || true)"
		if [[ ! -z ${shebang} ]]; then
			SHEBANGS+=( ${shebang} )
		fi
	fi
done
readonly CHANGED_FILES_RO=( ${CHANGED_FILES[@]} )

Versions=""
Environments=""

fatal() {
	echo >&2 "FATAL: "${@}", try FCM=1 or VCM=1"
	[[ -z ${FCM} ]] && exit 1
}

warning() {
	echo >&2 "WARNING: "${@}
}

# $1: specify mode, values: WEAK, STRONG
__add_ver() {
	local mode=$1
	shift

	[[ -z "${@}" ]] && fatal "Bad call of add_ver()"
	[[ -z ${CHANGED_FILES_RO} ]] && return 0

	if [[ -z "$(echo ${@} | grep -oE '[0-9]')" ]]; then
		local msg="Can't found version string from '${@}'"
		if [[ ${mode} == STRONG ]]; then
			fatal "${msg}"
		else
			warning "${msg}"
		fi
		# Return directly
		return 0
	fi

	# Already exist
	if [[ "${Versions}" =~ "${@}" ]]; then
		return 0
	fi

	[[ ${Versions} ]] && Versions+=", "
	Versions+="$@"
}
add_ver_weak() {
	__add_ver WEAK "$@"
}
add_ver() {
	__add_ver STRONG "$@"
}

add_env() {
	[[ -z ${CHANGED_FILES_RO} ]] && return 0

	[[ -z "${@}" ]] && return 0

	# Already exist
	if [[ "${Environments}" =~ "${@}" ]]; then
		return 0
	fi

	[[ ${Environments} ]] && Environments+=", "
	Environments+="$@"
}

# input some key words.
# echo "YES" if any key matched.
has_key() {
	local key

	[[ ${AV} ]] && echo "YES" && return 0

	for key in ${@}
	do
		# Match the whole word
		if [[ "$(echo ${CHANGED_FILES_RO[@]} | grep -wo ${key})" ]]; then
			echo "YES"
			return 0
		fi
		if [[ "$(echo ${SHEBANGS[@]} | grep -wo ${key})" ]]; then
			echo "YES"
			return 0
		fi
	done
	return 0
}

# input some key words, such as c, cpp, sh, cu
# echo "YES" if any file type matched.
has_type() {
	local ext

	[[ ${AV} ]] && echo "YES" && return 0

	for ext in ${@}
	do
		# a.c b.sh -> c sh
		if [[ " ${CHANGED_FILES_RO[@]##*.} " =~ " ${ext} " ]]; then
			echo "YES"
			return 0
		fi
	done
	return 0
}

# has content in patch
has_content() {
	local str

	[[ ${AV} ]] && echo "YES" && return 0

	for str in ${@}
	do
		# search the 'str' in patch
		if [[ "$(git status --verbose | grep -e '^+' -e '^-' | \
				grep -o ${str})" ]] ||
		   [[ "$(git diff --staged | grep -e '^+' -e '^-' | \
				grep -o ${str})" ]]; then
			echo "YES"
			return 0
		fi
	done
	return 0
}

as_ver() { add_ver "As $(${VERDIR}/binutils.sh)"; }
bcc_ver() { add_ver "BCC $(${VERDIR}/bcc.sh)"; }
binutils_ver() { add_ver "Binutils $(${VERDIR}/binutils.sh)"; }
bpftool_ver() { add_ver "bpftool $(${VERDIR}/bpftool.sh)"; }
bpftrace_ver() { add_ver "BPFTrace $(${VERDIR}/bpftrace.sh)"; }
capstone_ver() { add_ver "capstone $(${VERDIR}/capstone.sh)"; }
cmake_ver() { add_ver "CMake $(${VERDIR}/cmake.sh)"; }
cuda_ver() { add_ver "CUDA $(${VERDIR}/cuda.sh)"; }
dracut_ver() { add_ver "Dracut $(${VERDIR}/dracut.sh)"; }
ethtool_ver() { add_ver "Ethtool $(${VERDIR}/ethtool.sh)"; }
ffmpeg_ver() { add_ver "ffmpeg $(${VERDIR}/ffmpeg.sh)"; }
findutils_ver() { add_ver "Findutils $(${VERDIR}/findutils.sh)"; }
gcc_ver() { add_ver "GCC $(${VERDIR}/gcc.sh)"; }
gdb_ver() { add_ver "GDB $(${VERDIR}/gdb.sh)"; }
go_ver() { add_ver "Golang $(${VERDIR}/go.sh)"; }
git_ver() { add_ver "Git $(${VERDIR}/git.sh)"; }
glibc_ver() { add_ver "$(getconf GNU_LIBC_VERSION 2>/dev/null)"; }
gnome_ver() { add_ver "GNOME $(${VERDIR}/gnome.sh)"; }
hpcc_ver() { add_ver_weak "HPCC $(${VERDIR}/hpcc.sh)"; }
java_ver() { add_ver "Java $(${VERDIR}/java.sh)"; }
kmod_ver() { add_ver "kmod $(${VERDIR}/kmod.sh)"; }
latexmk_ver() { add_ver_weak "LaTeXmk $(${VERDIR}/latexmk.sh)"; }
libbpf_ver() { add_ver "LibBpf $(${VERDIR}/libbpf.sh)"; }
libvirt_ver() { add_ver "Libvirt $(${VERDIR}/libvirt.sh)"; }
libxdp_ver() { add_ver "LibXDP $(${VERDIR}/libxdp.sh)"; }
linux_ver() { add_ver "Linux $(uname -r)"; }
linux_fw_ver() { add_ver "Linux-Firmware $(${VERDIR}/linux-firmware.sh)"; }
llvm_ver() { add_ver "LLVM $(${VERDIR}/llvm.sh)"; }
lsof_ver() { add_ver "lsof $(${VERDIR}/lsof.sh)"; }
luca_ver() { add_ver_weak "LUCA $(${VERDIR}/luca.sh)"; }
make_ver() { add_ver "Make $(${VERDIR}/make.sh)"; }
memcached_ver() { add_ver "Memcached $(${VERDIR}/memcached.sh)"; }
nasm_ver() { add_ver "Nasm $(${VERDIR}/nasm.sh)"; }
NetworkManater_ver() { add_ver "NetworkManater $(${VERDIR}/NetworkManater.sh)"; }
ndctl_ver() { add_ver "ndctl $(${VERDIR}/ndctl.sh)"; }
numactl_ver() { add_ver "NUMACTL $(${VERDIR}/numactl.sh)"; }
openssl_ver() { add_ver "OpenSSL $(${VERDIR}/openssl.sh)"; }
os_ver() { add_ver "$(${VERDIR}/distro.sh)"; }
ostree_ver() { add_ver "RPM $(${VERDIR}/ostree.sh)"; }
pahole_ver() { add_ver "Pahole $(${VERDIR}/pahole.sh)"; }
pciutils_ver() { add_ver "PCIUtils $(${VERDIR}/pciutils.sh)"; }
podman_ver() { add_ver "Podman $(${VERDIR}/podman.sh)"; }
procps_ver() { add_ver "Procps-ng $(${VERDIR}/procps-ng.sh)"; }
psmisc_ver() { add_ver "Psmisc $(${VERDIR}/psmisc.sh)"; }
py_ver() { add_ver "Python $(${VERDIR}/python.sh)"; }
qemu_ver() { add_ver "Qemu $(${VERDIR}/qemu.sh)"; }
redis_ver() { add_ver "$(${VERDIR}/redis.sh --name) $(${VERDIR}/redis.sh)"; }
rocm_ver() { add_ver_weak "ROCm $(${VERDIR}/rocm.sh)"; }
rpm_ver() { add_ver "RPM $(${VERDIR}/rpm.sh)"; }
rust_ver() { add_ver "Rust $(${VERDIR}/rust.sh)"; }
shell_ver() { add_ver "$(${VERDIR}/shell.sh --pretty-name) $(${VERDIR}/shell.sh)"; }
sphinx_ver() { add_ver "Sphinx $(${VERDIR}/sphinx.sh)"; }
strace_ver() { add_ver "Strace $(${VERDIR}/strace.sh)"; }
systemd_ver() { add_ver "Systemd $(${VERDIR}/systemd.sh)"; }
uefi_ver() { add_ver "UEFI Spec $(${VERDIR}/uefi.sh)"; }
vim_ver() { add_ver "Vim $(${VERDIR}/vim.sh)"; }

cpu_env() { add_env "$(${TOPDIR}/cpu/cpuname.sh)"; add_env "$(uname -m)"; }
pid1_env() { add_env "pid1=$(cat /proc/1/comm)"; }
virt_env() { add_env "$(${TOPDIR}/virt/virttype.sh)"; }

if [[ -z ${signed_off_by_line} ]] && [[ ${COMMIT_SOURCE} != merge ]]; then
	fatal "must signed with -s/--signoff"
fi

if [[ -z ${signed_off_by_line} ]]; then
	warning "Skipping git hooks of prepare-commit-msg"
	exit 0
fi

# __main__
if [[ "$(has_type asm S)$(has_key asm arch insn cpu)" ]]; then
	cpu_env
	virt_env
fi

os_ver
linux_ver

if [[ "$(has_key firmware)" ]]; then
	linux_fw_ver
fi

if [[ "$(has_type c cpp c++ h hpp)$(has_key cpp gcc compiler)" ]]; then
	gcc_ver
fi

if [[ "$(has_type gdb)$(has_key gdb)" ]]; then
	gdb_ver
fi

if [[ "$(has_type go)$(has_key go golang)" ]]; then
	go_ver
fi

if [[ "$(has_key ffmpeg)$(has_content ffmpeg)" ]]; then
	ffmpeg_ver
fi

if [[ "$(has_key find findutils)" ]]; then
	findutils_ver
fi

if [[ "$(has_type c cpp c++ h hpp)$(has_key glibc ipc socket)" ]]; then
	glibc_ver
fi

if [[ "$(has_type sh bash)$(has_key bash shell)" ]]; then
	shell_ver
fi

if [[ "$(has_type service)$(has_key systemd)$(has_content systemd journal)" ]]; then
	systemd_ver
fi

if [[ "$(has_key strace)" ]]; then
	strace_ver
fi

if [[ "$(has_key latexmk sphinx Documentation)" ]]; then
	latexmk_ver
	sphinx_ver
fi

if [[ "$(has_type qcow2 raw)$(has_key qcow qcow2 qcow3 qemu)" ]]; then
	virt_env
	qemu_ver
fi

if [[ "$(has_type mk mak make)$(has_key make Makefile)" ]]; then
	make_ver
fi

if [[ "$(has_key redis)" ]]; then
	redis_ver
fi

if [[ "$(has_key memcache memcached)" ]]; then
	memcached_ver
fi

if [[ "$(has_type rpm)$(has_key rpm dnf)" ]]; then
	rpm_ver
fi

if [[ "$(has_type rs)$(has_key rust)" ]]; then
	rust_ver
fi

if [[ "$(has_key ostree)" ]]; then
	ostree_ver
fi

if [[ "$(has_type cmake)$(has_key cmake CMake)$(has_content cmake)" ]]; then
	cmake_ver
fi

if [[ "$(has_key capstone)$(has_content capstone)" ]]; then
	capstone_ver
fi

if [[ "$(has_key podman Dockerfile)" ]]; then
	podman_ver
fi

if [[ "$(has_key procps ps pgrep)" ]]; then
	procps_ver
fi

if [[ "$(has_key psmisc killall prtstat pstree fuser)" ]]; then
	psmisc_ver
fi

if [[ "$(has_key gnome)" ]]; then
	gnome_ver
fi

if [[ "$(has_type vim)$(has_key vim)" ]]; then
	vim_ver
fi

if [[ "$(has_type efi)$(has_key uefi UEFI efi EFI)" ]]; then
	uefi_ver
fi

if [[ "$(has_key libbpf pahole)" ]]; then
	pahole_ver
fi

if [[ "$(has_key virsh libvirt)" ]]; then
	libvirt_ver
fi

if [[ "$(has_key libxdp xdp)" ]]; then
	libxdp_ver
fi

if [[ "$(has_key pci pcie)" ]]; then
	pciutils_ver
fi

if [[ "$(has_key git)" ]]; then
	git_ver
fi

# .asm is nasm in test-linux.
if [[ "$(has_type asm)$(has_key nasm)" ]]; then
	nasm_ver
fi

if [[ "$(has_key nmcli NetworkManater)" ]]; then
	NetworkManater_ver
fi

if [[ "$(has_key ndctl daxctl cxl)$(has_content cxl)" ]]; then
	ndctl_ver
fi

if [[ "$(has_key numa numactl)" ]]; then
	numactl_ver
fi

if [[ "$(has_type bt)$(has_key bpftrace)$(has_content bpftrace)" ]]; then
	bpftrace_ver
fi

if [[ "$(has_type pem)$(has_key ssl openssl)" ]]; then
	openssl_ver
fi

if [[ "$(has_key bpftool btf)" ]]; then
	bpftool_ver
fi

if [[ "$(has_key llvm bt nvidia)" ]]; then
	llvm_ver
fi

if [[ "$(has_key cuda nvidia)" ]]; then
	name=$(${TOPDIR}/hpc/nvidia/gpuname.sh)
	if [[ ! -z ${name} ]]; then
		add_env "${name}"
	fi
	cuda_ver
	llvm_ver
fi

if [[ "$(has_key cuda nvidia rocm amd ROCm AMD)" ]]; then
	rocm_ver
	llvm_ver
fi

if [[ "$(has_key cuda nvidia luca LUCA cestc CESTC)" ]]; then
	name=$(${TOPDIR}/hpc/cestc/lingspeed/gpuname.sh)
	if [[ ! -z ${name} ]]; then
		add_env "${name}"
	fi
	luca_ver
	llvm_ver
fi

[[ "$(has_key lsof)" ]] && lsof_ver

if [[ "$(has_key cuda nvidia hpcc HPCC metax MetaX)" ]]; then
	hpcc_ver
	llvm_ver
fi

if [[ "$(has_key dracut initramfs initrd)" ]]; then
	dracut_ver
fi

if [[ "$(has_key ethtool)" ]]; then
	ethtool_ver
fi

if [[ "$(has_key java jdk)" ]]; then
	java_ver
fi

if [[ "$(has_key kmod module)" ]]; then
	kmod_ver
fi

if [[ "$(has_type s)$(has_key asm)" ]]; then
	as_ver
fi

if [[ "$(has_key libbpf bcc bpf)" ]]; then
	bcc_ver
	libbpf_ver
fi

if [[ "$(has_key binutils bfd)" ]]; then
	binutils_ver
fi

if [[ "$(has_key ai pytorch python py)" ]]; then
	py_ver
fi

# If only modify The Documentation, try add Commit Message Title
if [[ -z "$(git status --short | grep -v Documentation || :)" ]]; then
	doc_files=( $(git status --short | grep -Eo 'Documentation.*' | grep -vw conf.py) )
	doc_dirs=( $(basename $(dirname ${doc_files[@]}) ) )
	doc_label=$(IFS=,; echo "${doc_dirs[*]}")
	sed -i "1i Doc: ${doc_label}: update " ${COMMIT_MSG_FILE} || {
		fatal "Failed add commit message"
	}

fi

# Add lines
if [[ ${Versions} ]]; then
	sed -i "$((${signed_off_by_line}+1))i Vers: ${Versions}" ${COMMIT_MSG_FILE} || {
		fatal "Failed handle Vers: ${Versions}"
	}
fi
if [[ ${Environments} ]]; then
	sed -i "$((${signed_off_by_line}+1))i Envs: ${Environments}" ${COMMIT_MSG_FILE} || {
		fatal "Failed handle Envs: ${Environments}"
	}
fi
