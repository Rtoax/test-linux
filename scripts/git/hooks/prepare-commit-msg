#!/bin/bash
# Copyright (c) 2025 Rong Tao

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2
SHA1=$3

# Remove old Env first.
sed -i '/^Versions:/d' ${COMMIT_MSG_FILE}
sed -i '/^Envs:/d' ${COMMIT_MSG_FILE}

readonly MY_DIRECTORY=$(dirname $(realpath $0))
readonly GIT_TOPDIR=$(git rev-parse --show-toplevel 2>/dev/null || :)
readonly first_nonempyline=$(sed -n '/[^[:space:]]/ { =; q }' ${COMMIT_MSG_FILE})
readonly first_commentline=$(sed -n '/^#/ { =; q }' ${COMMIT_MSG_FILE})
readonly signed_off_by_line=$(awk '/^Signed-off-by:/{print NR; exit}' ${COMMIT_MSG_FILE})

# Changed file list (new, deleted, added, modified)
CHANGED_FILES=( $( ${MY_DIRECTORY}/get-commit-file-list ) )

# git commit --amend
if [ "$COMMIT_SOURCE" = "commit" ] && [ "$SHA1" = "HEAD" ]; then
	CHANGED_FILES+=( $(git log -1 --oneline --name-only --pretty=format:) )
fi

Versions=""
Environments=""

add_versions() {
	[[ -z "${@}" ]] && return 0
	[[ ${Versions} ]] && Versions+=", "
	Versions+="$@"
}

add_envs() {
	[[ -z "${@}" ]] && return 0
	[[ ${Environments} ]] && Environments+=", "
	Environments+="$@"
}

# input some key words.
# echo "YES" if any key matched.
files_have_key() {
	local key
	for key in ${@}
	do
		if [[ "$(echo ${CHANGED_FILES[@]} | grep -o ${key})" ]]; then
			echo "YES"
			return 0
		fi
	done
	return 0
}

if [[ -z ${signed_off_by_line} ]]; then
	echo >&2 "ERROR: must signed with -s/--signoff"
	exit 1
fi

# OS version
if [[ -e /etc/os-release ]]; then
	os_env=
	. /etc/os-release
	os_env+="${NAME}"
	if [[ ${VERSION_ID} ]]; then
		os_env+=" ${VERSION_ID}"
	elif [[ ${VERSION} ]]; then
		os_env+=" ${VERSION}"
	fi
	add_versions "${os_env}"
fi

# Kernel version
add_versions "Kernel $(uname -r)"
add_envs "CPU: $(lscpu | grep "Model name" | awk '{ for(i=3; i<=NF; i++) printf "%s", $i (i==NF ? "\n" : " ") }')"
add_envs "Arch $(uname -m)"

# GCC version
GCC=$(which gcc 2>/dev/null || :)
if [[ ${GCC} ]]; then
	gcc_ver=$(${GCC} -dumpfullversion -dumpversion)
	add_versions "GCC ${gcc_ver}"
fi

# Glibc version
add_versions "$(getconf GNU_LIBC_VERSION 2>/dev/null || :)"

# LLVM version
LLVM_CONFIG=$(which llvm-config 2>/dev/null || :)
if [[ ${LLVM_CONFIG} ]]; then
	llvm_ver=$(${LLVM_CONFIG} --version)
	add_versions "LLVM ${llvm_ver}"
fi

if [[ "$(files_have_key cuda nvidia)" ]]; then
	cuda_ver=$(${GIT_TOPDIR}/hpc/nvidia/cuda/version.sh)
	add_versions "CUDA ${cuda_ver}"
	# TODO: add ROCm hipcc, metax, hpcc, luca, etc.
fi

if [[ "$(files_have_key libbpf bcc bpf)" ]]; then
	bcc_ver=$(${GIT_TOPDIR}/bpf/bcc/version.sh)
	add_versions "BCC ${bcc_ver}"
	libbpf_ver=$(${GIT_TOPDIR}/bpf/libbpf/version.sh)
	add_versions "LIBBPF ${libbpf_ver}"
	# TODO: add bpftools, etc.
fi

# Add lines
if [[ ${Versions} ]]; then
	sed -i "$((${signed_off_by_line}+1))i Versions: ${Versions}" ${COMMIT_MSG_FILE}
	sed -i "$((${signed_off_by_line}+1))i Envs: ${Environments}" ${COMMIT_MSG_FILE}
fi
