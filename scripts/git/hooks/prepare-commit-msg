#!/bin/bash
# Copyright (c) 2025 Rong Tao

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2
SHA1=$3

# Remove old Env first.
sed -i '/^Versions:/d' ${COMMIT_MSG_FILE}
sed -i '/^Envs:/d' ${COMMIT_MSG_FILE}

readonly MY_DIRECTORY=$(dirname $(realpath $0))
readonly GIT_TOPDIR=$(git rev-parse --show-toplevel 2>/dev/null || :)
readonly first_nonempyline=$(sed -n '/[^[:space:]]/ { =; q }' ${COMMIT_MSG_FILE})
readonly first_commentline=$(sed -n '/^#/ { =; q }' ${COMMIT_MSG_FILE})
readonly signed_off_by_line=$(awk '/^Signed-off-by:/{print NR; exit}' ${COMMIT_MSG_FILE})

# Changed file list (new, deleted, added, modified)
CHANGED_FILES=( $( ${MY_DIRECTORY}/get-commit-file-list ) )

# git commit --amend
if [ "$COMMIT_SOURCE" = "commit" ] && [ "$SHA1" = "HEAD" ]; then
	CHANGED_FILES+=( $(git log -1 --oneline --name-only --pretty=format:) )
fi

Versions=""
Environments=""

fatal() {
	echo >&2 "FATAL: "${@}
	exit 1
}

add_versions() {
	[[ -z "${@}" ]] && return 0
	[[ ${Versions} ]] && Versions+=", "
	Versions+="$@"
}

add_envs() {
	[[ -z "${@}" ]] && return 0
	[[ ${Environments} ]] && Environments+=", "
	Environments+="$@"
}

# input some key words.
# echo "YES" if any key matched.
files_have_key() {
	local key
	for key in ${@}
	do
		if [[ "$(echo ${CHANGED_FILES[@]} | grep -o ${key})" ]]; then
			echo "YES"
			return 0
		fi
	done
	return 0
}

# input some key words, such as c, cpp, sh, cu
# echo "YES" if any file type matched.
files_have_type() {
	local key
	for key in ${@}
	do
		# a.c b.sh -> c sh
		if [[ " ${CHANGED_FILES[@]##*.} " =~ " ${key} " ]]; then
			echo "YES"
			return 0
		fi
	done
	return 0
}

cpu_info() {
	readonly CPU_MODEL=$(lscpu | grep "Model name" | \
			awk '{ for(i=3; i<=NF; i++) printf "%s", $i (i==NF ? "\n" : " ") }')
	readonly CPU_VENDOR=$(lscpu | grep "^Vendor ID" | \
			awk '{ for(i=3; i<=NF; i++) printf "%s", $i (i==NF ? "\n" : " ") }')
	if [[ ${CPU_MODEL} ]]; then
		echo ${CPU_MODEL}
	elif [[ ${CPU_VENDOR} ]]; then
		echo ${CPU_VENDOR}
	else
		fatal "Can't get cpu info from lscpu"
	fi
}

if [[ -z ${signed_off_by_line} ]]; then
	echo >&2 "ERROR: must signed with -s/--signoff"
	exit 1
fi

add_envs "CPU: $(cpu_info)"
add_envs "Arch $(uname -m)"

SYSTEMD_DETECT_VIRT=$(which systemd-detect-virt 2>/dev/null || :)
if [[ ${SYSTEMD_DETECT_VIRT} ]]; then
	virt=$( ${SYSTEMD_DETECT_VIRT} )
	if [[ ${virt} != none ]]; then
		add_envs "VIRT-${virt}"
	fi
fi

# OS version
if [[ -e /etc/os-release ]]; then
	os_env=
	. /etc/os-release
	os_env+="${NAME}"
	if [[ ${VERSION_ID} ]]; then
		os_env+=" ${VERSION_ID}"
	elif [[ ${VERSION} ]]; then
		os_env+=" ${VERSION}"
	fi
	add_versions "${os_env}"
fi

# Kernel version
add_versions "Kernel $(uname -r)"

# GCC version
GCC=$(which gcc 2>/dev/null || :)
if [[ ${GCC} ]]; then
	gcc_ver=$(${GCC} -dumpfullversion -dumpversion)
	add_versions "GCC ${gcc_ver}"
fi

# Glibc version
add_versions "$(getconf GNU_LIBC_VERSION 2>/dev/null || :)"

if [[ "$(files_have_type sh bash)$(files_have_key bash shell)" ]]; then
	bash_ver=$(${GIT_TOPDIR}/shell/version.sh)
	add_versions "BASH ${bash_ver}"
fi

# LLVM version
LLVM_CONFIG=$(which llvm-config 2>/dev/null || :)
if [[ ${LLVM_CONFIG} ]]; then
	llvm_ver=$(${LLVM_CONFIG} --version)
	add_versions "LLVM ${llvm_ver}"
fi

if [[ "$(files_have_key cuda nvidia)" ]]; then
	cuda_ver=$(${GIT_TOPDIR}/hpc/nvidia/cuda/version.sh)
	add_versions "CUDA ${cuda_ver}"
fi

if [[ "$(files_have_key cuda nvidia rocm amd ROCm AMD)" ]]; then
	rocm_ver=$(${GIT_TOPDIR}/hpc/amd/rocm/version.sh)
	[[ ${rocm_ver} ]] && add_versions "ROCm ${rocm_ver}"
fi

if [[ "$(files_have_key cuda nvidia luca LUCA cestc CESTC)" ]]; then
	luca_ver=$(${GIT_TOPDIR}/hpc/cestc/version.sh)
	[[ ${luca_ver} ]] && add_versions "LUCA ${luca_ver}"
fi

if [[ "$(files_have_key cuda nvidia hpcc HPCC metax MetaX)" ]]; then
	hpcc_ver=$(${GIT_TOPDIR}/hpc/metax/version.sh)
	[[ ${hpcc_ver} ]] && add_versions "HPCC ${hpcc_ver}"
fi

if [[ "$(files_have_key libbpf bcc bpf)" ]]; then
	bcc_ver=$(${GIT_TOPDIR}/bpf/bcc/version.sh)
	add_versions "BCC ${bcc_ver}"
	libbpf_ver=$(${GIT_TOPDIR}/bpf/libbpf/version.sh)
	add_versions "LIBBPF ${libbpf_ver}"
	# TODO: add bpftools, etc.
fi

if [[ "$(files_have_key python py)" ]]; then
	py_ver=$(${GIT_TOPDIR}/python/version.sh)
	add_versions "Python ${py_ver}"
fi

# Add lines
if [[ ${Versions} ]]; then
	sed -i "$((${signed_off_by_line}+1))i Versions: ${Versions}" ${COMMIT_MSG_FILE}
	sed -i "$((${signed_off_by_line}+1))i Envs: ${Environments}" ${COMMIT_MSG_FILE}
fi
