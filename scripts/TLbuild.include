# Makefile format
comma	:= ,
quota	:= "
squote	:= '
empty   :=
space   := $(empty) $(empty)
space_escape := _-_SPACE_-_
pound	:= \#
define newline

endef

define tl_ascii_logo1
	@echo >&2 -e "$(1)8888888888                             88 "
	@echo >&2 -e "$(1)    88                         ,d      88         88 "
	@echo >&2 -e "$(1)    88                         88      88 "
	@echo >&2 -e "$(1)    88   ,adPYba,  ,adPYba,  MM88MM    88         88  8b,dPYba,   88      88  8b,    ,db "
	@echo >&2 -e "$(1)    88  a8P____88  I8<   88    88      88         88  88P'  '*8a  88      88   'Y8,,8P' "
	@echo >&2 -e "$(1)    88  8PP######   '*Yba,     88      88         88  88      88  88      88     )88( "
	@echo >&2 -e "$(1)    88  '8b,  ,aa  aa   ]8I    88,     88         88  88      88  '8a,  ,a88   ,d8""8b, "
	@echo >&2 -e "$(1)    88    *Ybd8*    *YbdP*     *Y88    888888888  88  88      88   \"YbdP:Y8  8P/     'Y8 "
endef

