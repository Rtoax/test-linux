				"/usr/bin/qemu-system-@ARCH@",
				"/usr/libexec/qemu-system-@ARCH@"
			],
			"extension": [ "qcow2" ]
		},
		"redis": {
			"name": "Redis",
			"command": [ "redis-server", "redis-cli" ]
