{
	"version": "0.0.1",
	"common": {
		"version": {
			"length": [ 3 ],
			"argument": [ "--version", "-V" ],
			"seperator": [ "." ]
		}
	},
	"software": {
		"dracut": {
			"command": [ "dracut" ],
			"version": {
				"length": [ 2 ],
				"argument": [ "--version" ],
				"seperator": [ "-" ]
			},
			"keys": [ "dracut", "initramfs", "initrd" ]
		},
		"shell": {
			"command": [ "bash", "sh" ],
			"version": {
				"argument": [ "--version" ]
			},
			"keys": [ "shell", "bash", "sh" ]
		},
		"vim": {
			"command": [ "vim" ],
			"version": {
				"argument": [ "--version" ],
				"length": [ 2 ]
			},
			"keys": [ "vim" ]
		}
	}
}
