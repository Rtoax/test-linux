		"gcc": {
			"name": "GCC",
			"extension": [ "gcov" ]
		},
		"gdb": {
			"name": "GDB",
			"version": {
				"length": [ 2 ]
			},
			"extension": [ "gdb" ]
		},
		"git": {
			"name": "Git"
		},
		"gnome": {
			"name": "GNOME",
			"command": [ "gnome-shell" ],
			"version": {
				"length": [ 2 ]
			}
		},
		"gnuplot": {
			"name": "GNUPlot",
			"extension": [ "gp" ]
		},
		"go": {
			"name": "GOLang",
			"version": {
				"argument": [ "version" ]
			},
			"extension": [ "go" ]
