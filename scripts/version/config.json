		"openssl": {
			"name": "OpenSSL",
			"version": {
				"argument": [ "--version", "version" ]
			}
		},
		"ostree": {
			"name": "OSTree",
			"version": {
				"length": [ 2 ]
			}
		},
		"pahole": {
			"name": "Pahole",
			"version": {
				"length": [ 2 ]
			}
		},
		"pciutils": {
			"name": "PCIUtils",
			"command": [ "lspci" ]
		},
		"podman": {
			"name": "Podman"
		},
