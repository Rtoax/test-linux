{
	"version": "0.0.1",
	"common": {
		"version": {
			"length": [ 3 ],
			"argument": [ "--version", "-V" ],
			"seperator": [ "." ]
		}
	},
	"software": {
		"bcc": {
			"name": "BCC",
			"library": [ "libbcc.so", "libbcc_bpf.so" ],
			"keys": [ "bcc", "bpfcc" ]
		},
		"binutils": {
			"name": "Binutils",
			"command": [ "ld.bfd" ]
		},
		"bpftool": {
			"name": "BPFTool",
			"keys": [ "bpftool", "btf" ]
		},
		"bpftrace": {
			"name": "BPFTrace",
			"extension": [ "bt" ],
			"keys": [ "bpftrace" ]
		},
		"capstone": {
			"name": "Capstone",
			"command": [ "cstool" ]
		},
		"cuda": {
			"name": "CUDA",
			"command": [ "nvcc", "/usr/local/cuda/bin/nvcc" ],
			"extension": [ "cu" ]
		},
		"cmake": {
			"name": "CMake",
			"extension": [ "cmake" ]
		},
		"dracut": {
			"name": "Dracut",
