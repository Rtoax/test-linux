#!/bin/env bpftrace

struct net_device {
	char name[32];
}

BEGIN
{
	printf("Tracing TUN xmit, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s %-8s\n", "TIME", "PID", "COMM", "DEV", "RET");
}

kprobe:tun_net_xmit
{
	@dev[tid] = (struct net_device *)arg1;
}

kretprobe:tun_net_xmit
/ @dev[tid] /
{
	$dev = @dev[tid];
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s %-8d\n", pid, comm, $dev->name, retval);

	delete(@dev[tid]);
}

END
{
	clear(@dev);
	printf("Bye.\n");
}
