#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif
struct net_device {
	char name[32];
}

BEGIN
{
	printf("Tracing xxx, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s\n", "TIME", "PID", "COMM");
}

kprobe:tun_net_xmit
{
	$dev = (struct net_device *)arg1;
	time("%H:%M:%S ");
	printf("%-8d %-16s %s\n", pid, comm, $dev->name);
}

END
{
	printf("Bye.\n");
}
