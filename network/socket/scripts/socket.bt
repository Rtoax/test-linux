#!/bin/env bpftrace
/**
 * socket.bt - Tracing socket(2) syscall
 *
 * Copyright (C) Rong Tao 2022-2023
 */

BEGIN
{
	printf("Tracing socket(2) syscall, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s %-8s\n", "TIME", "PID", "FD", "COMM");
}

kretprobe:__sys_socket
{
	$fd = retval;

	time("%H:%M:%S ");
	printf("%-8d %-8d %-8s\n", pid, $fd, comm);
}

END
{
	printf("Bye.\n");
}
