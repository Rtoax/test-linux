#!/bin/env bpftrace
/**
 * socket.bt - Tracing socket(2) syscall
 *
 * Copyright (C) CESTC, Co. 2022-2023
 *
 * 2023-07-14	Rong Tao	Create this.
 */

BEGIN
{
	printf("Tracing socket(2) syscall, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s %-8s\n", "TIME", "PID", "FD", "COMM");
}

kretprobe:__sys_socket
{
	$fd = retval;

	@fds[pid, comm, $fd] = 1;

	time("%H:%M:%S ");
	printf("%-8d %-8d %-8s\n", pid, $fd, comm);
}

tracepoint:syscalls:sys_enter_close
{
	$fd = args->fd;

	if (@fds[pid, comm, $fd] == 1) {
		@fds[pid, comm, $fd] = 0;

		time("%H:%M:%S ");
		printf("%-8d %-8d %-8s CLOSE\n", pid, $fd, comm);
	}
}

END
{
	clear(@fds);
	printf("Bye.\n");
}
