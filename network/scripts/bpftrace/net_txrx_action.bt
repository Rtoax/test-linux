#!/usr/bin/env bpftrace.numaid
/**
 * File: net_txrx_action.bt
 * Author: Rong Tao <rongtao@cestc.cn>
 * Time: 2022.03.30
 *
 * TODO:
 * If https://github.com/iovisor/bpftrace/pull/2177 is merge to master
 * it's will support `numaid` builtin, then /usr/bin/env bpftrace, not now.
 */
BEGIN
{
	printf("Tracing Net TX/RX action, hit ctrl-c to end.\n");
}

kprobe:net_tx_action,
kprobe:net_rx_action
{
	@[numaid, comm] = count();
}
