#!/bin/env bpftrace
/**
 * icmp_echo.bt - Tracing icmp_echo
 *
 * Stress test:
 *   $ for ((i=0;i<1000;i++)); do ping -c 4 0& done
 *
 * Copyright (C) Rong Tao 2022-2023
 *
 * 2023-10-20	Rong Tao	Create this.
 * 2024-12-24	Rong Tao	Remove interval print and display CPU.
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing icmp_echo, hit ctrl-c to end.\n");
	printf("%-8s %-8s\n", "TIME", "CPU");
}

kprobe:icmp_echo
{
	@start[tid] = nsecs;
	time("%H:%M:%S ");
	printf("%-8d\n", cpu);
}

kretprobe:icmp_echo
/ @start[tid] /
{
	$latency_us = (nsecs - @start[tid]) / 1000;
	delete(@start[tid]);
	@hist_latency_us = hist($latency_us);
}

END
{
	clear(@start);
	printf("Bye.\n");
}
