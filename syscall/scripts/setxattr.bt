#!/usr/bin/env bpftrace
/**
 * File: setxattr.bt
 * Author: Rong Tao
 * Date: 2022.06.16
 *
 * Tracing setxattr(2)
 *
 * $ chcon -t admin_home_t abc.txt
 * $ chcon -t test_file_t abc.txt
 */
#include <linux/fs.h>
#include <linux/dcache.h>
#include <linux/xattr.h>
#include <linux/sched.h>

BEGIN
{
	printf("Tracing selinux context changes, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s %-8s %-8s %-24s %s\n",
		"TIME", "PID", "PPID", "COMM", "PCOMM", "CONTEXT", "FILE");
}

tracepoint:syscalls:sys_enter_lsetxattr,
tracepoint:syscalls:sys_enter_setxattr
{
	$pathname = args->pathname;
	$name = args->name;
	$flags = args->flags;
	$task = (struct task_struct *)curtask;
	$ppid = $task->real_parent->tgid;
	$pcomm = $task->real_parent->comm;

	time("%H:%M:%S ");
	printf("%-8d %-8d %-8s %-8s %-24s %-s\n",
		pid, $ppid, comm, $pcomm, str($name), str($pathname));
}

kprobe:xfs_attr_set_args
{
	printf("%s,%s\n", kstack, ustack);
}

END
{
}
