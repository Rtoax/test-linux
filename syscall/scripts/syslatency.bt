#!/bin/env bpftrace
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing syscall latency, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s %-8s\n",
		"TIME", "PID", "COMM", "SYS", "LAT(us)");
}

tracepoint:raw_syscalls:sys_enter
{
	@ids[tid] = args->id;
	@start[tid] = nsecs;
	@comm[tid] = comm;
}

tracepoint:raw_syscalls:sys_exit
/ @start[tid] /
{
	$us = (nsecs - @start[tid]) / 1000;
	@latency_us = hist($us);

	if ($us > 1000000) {
		time("%H:%M:%S ");
		printf("%-8d %-16s %-8d %-8d\n", pid, @comm[tid], @ids[tid], $us);
	}
	delete(@start[tid]);
	delete(@comm[tid]);
}

interval:s:1
{
	print(@latency_us);
}

END
{
	clear(@ids);
	clear(@start);
	clear(@comm);
	printf("Bye.\n");
}
