#!/bin/env bpftrace
/**
 * Tracing libaio io_ function calls.
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2024-02-01	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing libaio.so io_ function, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %s\n", "TIME", "PID", "COMM", "PROBE");
}

uprobe:/lib64/libaio.so:io_*
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %s\n", pid, comm, probe);
}

END
{
	printf("Bye.\n");
}
