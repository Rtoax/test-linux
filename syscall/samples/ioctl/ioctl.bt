#!/bin/env bpftrace
/**
 * Tracing ioctl(2) syscall
 *
 * Copyright (C) CESTC 2022-2023
 */
/* see /usr/include/asm-generic/ioctls.h */
#define TIOCGWINSZ  0x5413
#define TIOCSWINSZ  0x5414

struct winsize {
	unsigned short ws_row;
	unsigned short ws_col;
	unsigned short ws_xpixel;
	unsigned short ws_ypixel;
};

BEGIN
{
	/* FIXME: add more */
	@cmd_str[TIOCGWINSZ] = "TIOCGWINSZ";
	@cmd_str[TIOCSWINSZ] = "TIOCSWINSZ";

	printf("Tracing ioctl() syscall, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s %-8s\n", "TIME", "PID", "COMM", "FD", "CMD");
}

tracepoint:syscalls:sys_enter_ioctl
{
	$fd = args->fd;
	$cmd = args->cmd;

	@start[tid] = nsecs;

	time("%H:%M:%S ");
	printf("%-8d %-16s %-8d %-8s\n", pid, comm, $fd, @cmd_str[$cmd]);

	if ($cmd == TIOCSWINSZ) {
		$winsz = (struct winsize *)args->arg;
		printf("TIOCSWINSZ: %dx%d\n", $winsz->ws_row, $winsz->ws_col);
	}
}

tracepoint:syscalls:sys_exit_ioctl
/ @start[tid] /
{
	$diff_us = (nsecs - @start[tid]) / 1000;

	@latency_us = hist($diff_us);
	delete(@start[tid]);
}

END
{
	clear(@cmd_str);
	printf("Bye.\n");
}
