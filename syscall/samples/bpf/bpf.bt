#!/bin/env bpftrace
#ifndef BPFTRACE_HAVE_BTF
#endif

BEGIN
{
	@CMD[0] = "BPF_MAP_CREATE";
	@CMD[1] = "BPF_MAP_LOOKUP_ELEM";
	@CMD[2] = "BPF_MAP_UPDATE_ELEM";
	@CMD[3] = "BPF_MAP_DELETE_ELEM";
	@CMD[4] = "BPF_MAP_GET_NEXT_KEY";
	@CMD[5] = "BPF_PROG_LOAD";
	@CMD[6] = "BPF_OBJ_PIN";
	@CMD[7] = "BPF_OBJ_GET";
	@CMD[8] = "BPF_PROG_ATTACH";
	@CMD[9] = "BPF_PROG_DETACH";
	@CMD[10] = "BPF_PROG_TEST_RUN";
	@CMD[11] = "BPF_PROG_GET_NEXT_ID";
	@CMD[12] = "BPF_MAP_GET_NEXT_ID";
	@CMD[13] = "BPF_PROG_GET_FD_BY_ID";
	@CMD[14] = "BPF_MAP_GET_FD_BY_ID";
	@CMD[15] = "BPF_OBJ_GET_INFO_BY_FD";
	@CMD[16] = "BPF_PROG_QUERY";
	@CMD[17] = "BPF_RAW_TRACEPOINT_OPEN";
	@CMD[18] = "BPF_BTF_LOAD";
	@CMD[19] = "BPF_BTF_GET_FD_BY_ID";
	@CMD[20] = "BPF_TASK_FD_QUERY";
	@CMD[21] = "BPF_MAP_LOOKUP_AND_DELETE_ELEM";
	@CMD[22] = "BPF_MAP_FREEZE";
	@CMD[23] = "BPF_BTF_GET_NEXT_ID";
	@CMD[24] = "BPF_MAP_LOOKUP_BATCH";
	@CMD[25] = "BPF_MAP_LOOKUP_AND_DELETE_BATCH";
	@CMD[26] = "BPF_MAP_UPDATE_BATCH";
	@CMD[27] = "BPF_MAP_DELETE_BATCH";
	@CMD[28] = "BPF_LINK_CREATE";
	@CMD[29] = "BPF_LINK_UPDATE";
	@CMD[30] = "BPF_LINK_GET_FD_BY_ID";
	@CMD[31] = "BPF_LINK_GET_NEXT_ID";
	@CMD[32] = "BPF_ENABLE_STATS";
	@CMD[33] = "BPF_ITER_CREATE";
	@CMD[34] = "BPF_LINK_DETACH";
	@CMD[35] = "BPF_PROG_BIND_MAP";
	@CMD[36] = "BPF_TOKEN_CREATE";

	printf("Tracing bpf(2) syscall, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s\n", "TIME", "PID", "COMM", "CMD");
}

tracepoint:syscalls:sys_enter_bpf
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %s\n", pid, comm, @CMD[args->cmd]);
}

END
{
	clear(@CMD);
	printf("Bye.\n");
}
