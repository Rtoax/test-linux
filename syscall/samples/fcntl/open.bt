#!/bin/env bpftrace

BEGIN
{
	printf("Tracing open(2), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-4s %-8s\n", "TIME", "PID", "COMM", "RET", "FILE");
}

tracepoint:syscalls:sys_enter_open,
tracepoint:syscalls:sys_enter_openat
{
	@modes[tid] = args->mode;
	@files[tid] = args->filename;
}

tracepoint:syscalls:sys_exit_open,
tracepoint:syscalls:sys_exit_openat
/ @files[tid] /
{

	time("%H:%M:%S ");
	printf("%-8d %-16s %-4d %-04o %-s\n", pid, comm, args->ret, @modes[tid], str(@files[tid]));

	delete(@modes[tid]);
	delete(@files[tid]);
}

/**
 * Only tracing for openat.c
 */
fexit:vmlinux:__x64_sys_openat
/ comm == "openat" /
{
	$pt_regs = (struct pt_regs *)args->regs;

	/* x86_64 */
	$dfd = $pt_regs->di;
	$filename = str($pt_regs->si);
	$flags = $pt_regs->dx;
	$mode = $pt_regs->cx;

	time("%H:%M:%S ");
	printf("%-8d %-16s %-04o %-s (fentry)\n", pid, comm, $mode, $filename);
}

END
{
	clear(@files);
	printf("Bye.\n");
}
