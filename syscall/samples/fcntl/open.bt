#!/bin/env bpftrace

BEGIN
{
	printf("Tracing open(2), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-4s %-8s %-4s %-8s\n", "TIME", "PID", "COMM",
		"RET", "FLAGS", "MODE", "FILE");
}

tracepoint:syscalls:sys_enter_open,
tracepoint:syscalls:sys_enter_openat
{
	@files[tid] = args->filename;
	@flags[tid] = args->flags;
	@modes[tid] = args->mode;
}

tracepoint:syscalls:sys_exit_open,
tracepoint:syscalls:sys_exit_openat
/ @files[tid] /
{

	time("%H:%M:%S ");
	printf("%-8d %-16s %-4d %-08o %-04o %-s (tp)\n", pid, comm, args->ret,
		@flags[tid], @modes[tid], str(@files[tid]));

	delete(@files[tid]);
	delete(@flags[tid]);
	delete(@modes[tid]);
}

/**
 * Only tracing for openat.c
 */
fentry:vmlinux:__x64_sys_openat
/ comm == "openat" /
{
	$pt_regs = (struct pt_regs *)args->regs;

	/* x86_64 */
	$dfd = $pt_regs->di;
	$filename = str($pt_regs->si);
	$flags = $pt_regs->dx;
	$mode = $pt_regs->cx;

	time("%H:%M:%S ");
	printf("%-8d %-16s %-4d %-08o %-04o %-s (fentry)\n", pid, comm, $dfd,
		$flags, $mode, $filename);
}

END
{
	clear(@files);
	clear(@flags);
	clear(@modes);
	printf("Bye.\n");
}
