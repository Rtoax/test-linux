#!/bin/env bpftrace
/**
 * clone-ret.bt - Tracing clone(2), clone3(2)
 *
 * Copyright (C) 2024-2026 Rong Tao
 *
 *                      group_leader
 *                        ┌──────┐
 *                        │      │
 *                        ▼      │
 * ┏━━━━━━━━━━┓        ┏━━━━━━━━━┷┓     pthread_create/clone
 * ┃   bash   ┃═══════▶┃  parent  ┃═════════════╦════════════════════════════▶
 * ┗━━━━━━━━━━┛        ┗━━┯━━━━━━━┛             ║
 *    ▲  ▲  ▲             │  ▲  ▲               ║
 *    │  │  │             │  │  │               ║
 *    │  │  │ real_parent │  │  │               ║
 *    │  │  │             │  │  │               ║
 *    │  │  │             │  │  │               ▼
 *    │  │  │             │  │  │          ╔═════════╗   pthread_create/clone
 *    │  │  └─────────────┘  │  └──────────╢   son   ║═════════╦═════════════▶
 *    │  │                   │ group_leader╚═══════╤═╝         ║
 *    │  │                   │                     │           ║
 *    │  │                   │  real_parent        │           ║
 *    │  └───────────────────┼─────────────────────┘           ║
 *    │                      │                                 ║
 *    │                      │                                 ▼
 *    │                      │               group_leader   ╔══════════╗
 *    │                      └──────────────────────────────╢ grandson ║═════▶
 *    │                                                     ╚════╤═════╝
 *    │                                      real_parent         │
 *    └──────────────────────────────────────────────────────────┘
 *
 * ref: commit d4acdce4bf0e ("{pthread/create.c,clone(2),fork.c}: Recursive creation")
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing clone(2), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s %-16s %-8s %-8s %-8s %-8s %-16s %-8s %-16s\n",
		"TIME", "PID", "TID", "COMM", "OPS", "RET/PID", "ROLE",
		"ParPID", "ParCOMM", "GrpLePID", "GrpLeCOMM");
}

tracepoint:syscalls:sys_enter_clone,
tracepoint:syscalls:sys_enter_clone3
{
	time("%H:%M:%S ");
	printf("%-8d %-8d %-16s %-8s\n", pid, tid, comm, "ENTER");
}

tracepoint:syscalls:sys_exit_clone,
tracepoint:syscalls:sys_exit_clone3
{
	$current = curtask;
	$parent = $current->real_parent;
	$grpleader = $current->group_leader;

	time("%H:%M:%S ");
	printf("%-8d %-8d %-16s %-8s %-8d %-8s %-8d %-16s %-8d %-16s\n",
		pid, tid, comm, "EXIT", args->ret,
		args->ret == 0 ? "CHILD" : "PARENT",
		$parent->pid, $parent->comm,
		$grpleader->pid, $grpleader->comm);
}

END
{
	printf("Bye.\n");
}
