#!/bin/env bpftrace
/**
 * clone.bt - Tracing clone(2)
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing clone(2), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s %-8s\n",
		"TIME", "PID", "COMM", "OPS", "RET/PID");
}

tracepoint:syscalls:sys_enter_clone,
tracepoint:syscalls:sys_enter_clone3
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s\n", pid, comm, "ENTER");
}

tracepoint:syscalls:sys_exit_clone,
tracepoint:syscalls:sys_exit_clone3
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s %-8d\n", pid, comm, "EXIT", args->ret);
}

END
{
	printf("Bye.\n");
}
