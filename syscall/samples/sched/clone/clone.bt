#!/bin/env bpftrace
/**
 * clone.bt - Tracing clone(2), clone3(2) latency
 *
 * Copyright (C) Rong Tao 2024
 *
 * 2024-09-05	Rong Tao	Create this.
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing clone, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s %-12s %-8s %-16s\n",
		"TIME", "PID", "COMM", "LAT(us)", "CHILD_PID", "ROLE",
		"CLONE_FLAGS");
}

tracepoint:syscalls:sys_enter_clone
{
	@start[tid] = nsecs;
	@comm[tid] = comm;
	@flags[tid] = args->clone_flags;
}

tracepoint:syscalls:sys_enter_clone3
{
	@start[tid] = nsecs;
	@comm[tid] = comm;
	$clone_args = (struct clone_args *)args->uargs;
	@flags[tid] = $clone_args->flags;
}

tracepoint:syscalls:sys_exit_clone,
tracepoint:syscalls:sys_exit_clone3
/ @start[tid] /
{
	$us = (nsecs - @start[tid]) / 1000;
	@latency_us = hist($us);
	$pid = (uint32)args->ret;
	$role = "CHILD";

	/* Parent */
	if ($pid > 0) {
		/**
		 * clone(2) will return twice, one for parent, one for child.
		 * and parent clone return first(actually parent and child is
		 * parallel), for avoid @start[tid] of child is zero, set
		 * @start for child.
		 */
		@start[$pid] = @start[tid];
		@comm[$pid] = @comm[tid];
		$role = "PARENT";
	}

	time("%H:%M:%S ");
	printf("%-8d %-16s %-8d %-12d %-8s 0x%lx(",
		pid, @comm[tid], $us, $pid, $role, @flags[tid]);
	printf("%s", @flags[tid] & 0x00000000000100 ? "VM|" : "");
	printf("%s", @flags[tid] & 0x00000000000200 ? "FS|" : "");
	printf("%s", @flags[tid] & 0x00000000000400 ? "FILES|" : "");
	printf("%s", @flags[tid] & 0x00000000000800 ? "SIGHAND|" : "");
	printf("%s", @flags[tid] & 0x00000000001000 ? "PIDFD|" : "");
	printf("%s", @flags[tid] & 0x00000000002000 ? "PTRACE|" : "");
	printf("%s", @flags[tid] & 0x00000000004000 ? "VFORK|" : "");
	printf("%s", @flags[tid] & 0x00000000008000 ? "PARENT|" : "");
	printf("%s", @flags[tid] & 0x00000000010000 ? "THREAD|" : "");
	printf("%s", @flags[tid] & 0x00000000020000 ? "NEWNS|" : "");
	printf("%s", @flags[tid] & 0x00000000040000 ? "SYSVSEM|" : "");
	printf("%s", @flags[tid] & 0x00000000080000 ? "SETTLS|" : "");
	printf("%s", @flags[tid] & 0x00000000400000 ? "DETACHED|" : "");
	printf("%s", @flags[tid] & 0x00000000800000 ? "UNTRACED|" : "");
	printf("%s", @flags[tid] & 0x00000002000000 ? "NEWCGROUP|" : "");
	printf("%s", @flags[tid] & 0x00000004000000 ? "NEWUTS|" : "");
	printf("%s", @flags[tid] & 0x00000008000000 ? "NEWIPC|" : "");
	printf("%s", @flags[tid] & 0x00000010000000 ? "NEWUSER|" : "");
	printf("%s", @flags[tid] & 0x00000020000000 ? "NEWPID|" : "");
	printf("%s", @flags[tid] & 0x00000040000000 ? "NEWNET|" : "");
	printf("%s", @flags[tid] & 0x00000080000000 ? "IO|" : "");
	printf(")\n");

	delete(@start[tid]);
	delete(@comm[tid]);
	delete(@flags[tid]);
}

END
{
	clear(@start);
	clear(@comm);
	clear(@flags);
	printf("Bye.\n");
}
