#!/bin/env bpftrace
/**
 * fork.bt - Tracing fork(2), vfork(2)
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2024-03-15	Rong Tao	Create this.
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing fork, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s %-8s\n",
		"TIME", "PID", "COMM", "OPS", "RET/PID");
}

tracepoint:syscalls:sys_enter_fork,
tracepoint:syscalls:sys_enter_vfork
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s\n", pid, comm, "ENTER");
}

tracepoint:syscalls:sys_exit_fork,
tracepoint:syscalls:sys_exit_vfork
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s %-8d\n", pid, comm, "EXIT", args->ret);
}

END
{
	printf("Bye.\n");
}
