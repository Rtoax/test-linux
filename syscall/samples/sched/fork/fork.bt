#!/bin/env bpftrace
// Copyright (C) 2022-2026 Rong Tao
/**
 * fork.bt - Tracing fork(2), vfork(2)
 *
 *                      group_leader
 *                        ┌──────┐
 *                        │      │
 *                        ▼      │
 * ┏━━━━━━━━━━┓        ┏━━━━━━━━━┷┓           fork
 * ┃   bash   ┃═══════▶┃  parent  ┃═════════════╦════════════════════════════▶
 * ┗━━━━━━━━━━┛        ┗━━┯━━━━━━━┛             ║
 *      ▲                 │    ▲                ║
 *      │                 │    │                ║
 *      │  real_parent    │    │                ║
 *      └─────────────────┘    │                ║
 *                             │                ▼
 *                             │           ┏━━━━━━━━━┓       fork
 *                             └───────────┃   son   ┃═════════╦═════════════▶
 *                            real_parent  ┗━━━━━┯━━━┛         ║
 *                                           ▲   │  ▲          ║
 *                                           └───┘  │          ║
 *                                   group_leader   │          ║
 *                                                  │          ║
 *                                                  │          ▼
 *                                                  │       ┏━━━━━━━━━━┓
 *                                                  └───────┃ grandson ┃═════▶
 *                                           real_parent    ┗━━━━━━━━━┯┛
 *                                                            ▲       │
 *                                                            └───────┘
 *                                                          group_leader
 *
 * Architectures that have not fork(2), vfork(2):
 * - aarch64
 *
 * Refs:
 * - commit d4acdce4bf0e ("{pthread/create.c,clone(2),fork.c}: Recursive creation")
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing fork, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s %-16s %-8s %-8s %-8s ", "TIME", "PID", "TID",
	       "COMM", "OPS", "RET/PID", "ROLE");
	printf("%-8s %-16s %-8s %-16s %-8s\n", "ParPID", "ParCOMM", "GrpLePID",
	       "GrpLeCOMM", "LAT(us)");
}

tracepoint:syscalls:sys_enter_fork,
tracepoint:syscalls:sys_enter_vfork
{
	time("%H:%M:%S ");
	printf("%-8d %-8d %-16s %-8s\n", pid, tid, comm, "ENTER");
	@start[tid] = nsecs;
	@return_cnt[tid] = 2;
}

tracepoint:syscalls:sys_exit_fork,
tracepoint:syscalls:sys_exit_vfork
/ @start[tid] && @return_cnt[tid] /
{
	$current = curtask;
	$parent = $current->real_parent;
	$grpleader = $current->group_leader;

	$latus = (nsecs - @start[tid]) / 1000;

	time("%H:%M:%S ");
	printf("%-8d %-8d %-16s %-8s %-8d %-8s %-8d %-16s %-8d %-16s %-8ld\n",
		pid, tid, comm, "EXIT", args->ret,
		args->ret == 0 ? "CHILD" : "PARENT",
		$parent->pid, $parent->comm,
		$grpleader->pid, $grpleader->comm,
		$latus);

	@return_cnt[tid]--;
	if (@return_cnt[tid] == 0) {
		delete(@start[tid]);
		delete(@return_cnt[tid]);
	}
}

END
{
	clear(@start);
	clear(@return_cnt);
	printf("Bye.\n");
}
