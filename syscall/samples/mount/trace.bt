#!/bin/env bpftrace
#include <uapi/linux/mount.h>

BEGIN
{
	@FSCONFIG_CMD[FSCONFIG_SET_FLAG] = "SET_FLAG";
	@FSCONFIG_CMD[FSCONFIG_SET_STRING] = "SET_STRING";
	@FSCONFIG_CMD[FSCONFIG_SET_BINARY] = "SET_BINARY";
	@FSCONFIG_CMD[FSCONFIG_SET_PATH] = "SET_PATH";
	@FSCONFIG_CMD[FSCONFIG_SET_PATH_EMPTY] = "SET_PATH_EMPTY";
	@FSCONFIG_CMD[FSCONFIG_SET_FD] = "SET_FD";
	@FSCONFIG_CMD[FSCONFIG_CMD_CREATE] = "CMD_CREATE";
	@FSCONFIG_CMD[FSCONFIG_CMD_RECONFIGURE] = "CMD_RECONFIGURE";
	@FSCONFIG_CMD[FSCONFIG_CMD_CREATE_EXCL] = "CMD_CREATE_EXCL";

	printf("%-8s %-16s %-10s\n", "PID", "COMM", "SYSCALL");
}

tracepoint:syscalls:sys_enter_fsconfig
{
	printf("%-8d %-16s %-10s cmd:%s key:%s value:%s\n",
		pid, comm, "fsconfig",
		@FSCONFIG_CMD[args->cmd],
		str(args->_key), str(args->_value));
}

tracepoint:syscalls:sys_enter_fsmount
{
	printf("%-8d %-16s %-10s fd:%d\n",
		pid, comm, "fsmount", args->fs_fd);
}

tracepoint:syscalls:sys_enter_fsopen
{
	printf("%-8d %-16s %-10s fs_name:%s\n",
		pid, comm, "fsopen", str(args->_fs_name));
}

tracepoint:syscalls:sys_exit_fsopen
{
	printf("%-8d %-16s %-10s fd:%d\n",
		pid, comm, "fsopen:r", args->ret);
}

tracepoint:syscalls:sys_enter_mount
{
	printf("%-8d %-16s %-10s dev:%s dir:%s type:%s options:%s\n",
		pid, comm, "mount", str(args->dev_name), str(args->dir_name),
		str(args->type), str(args->data));
}

tracepoint:syscalls:sys_enter_mount_setattr
{
	printf("%-8d %-16s %-10s path:%s\n",
		pid, comm, "setattr", str(args->path));
}

tracepoint:syscalls:sys_enter_move_mount
{
	printf("%-8d %-16s %-10s from:%s to:%s\n",
		pid, comm, "movemnt", str(args->from_pathname),
		str(args->to_pathname));
}

tracepoint:syscalls:sys_enter_umount
{
	printf("%-8d %-16s %-10s name:%s\n",
		pid, comm, "umount", str(args->name));
}

END
{
	clear(@FSCONFIG_CMD);
}
