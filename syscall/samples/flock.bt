#!/bin/env bpftrace
/**
 * flock.bt: Tracing flock syscall
 *
 * Copyright (C) CESTC, Co. 2022-2023
 *
 * 2023-07-25	Rong Tao	Create this.
 */
#define LOCK_SH     1	/* Share */
#define LOCK_EX     2	/* Exclusive */
#define LOCK_NB     4	/* Non Block */
#define LOCK_UN     8	/* Unlock */

BEGIN
{
	printf("Tracing flock(2), hit ctrl-c to end.\n");
	printf(" CMD: Share(S), Exclusive(E), Nonblock(N), Unlock(U)\n");
	printf("\n");
	printf("%-16s %-8s %-8s %-16s %-8s %-5s %-8s %-16s\n",
		"TIME(ns)", "PID", "TID", "COMM", "FD", "CMD", "RESULT", "FILE");
}

tracepoint:syscalls:sys_enter_open,
tracepoint:syscalls:sys_enter_openat
{
	$filename = args->filename;
	@filenames[tid] = $filename;
}

tracepoint:syscalls:sys_exit_open,
tracepoint:syscalls:sys_exit_openat
/ @filenames[tid] /
{
	$fd = args->ret;
	$filename = @filenames[tid];

	printf("%-16ld %-8d %-8d %-16s %-8d OPEN  %-8s %-16s\n",
		nsecs, pid, tid, comm, $fd,
		$fd > 0 ? "Success" : "\033[1;31mFailed\033[m",
		str($filename)
	);

	delete(@filenames[tid]);
}

tracepoint:syscalls:sys_enter_close
{
	$fd = args->fd;
	@close_fds[tid] = $fd;
}

tracepoint:syscalls:sys_exit_close
/ @close_fds[tid] /
{
	$fd = @close_fds[tid];
	$ret = args->ret;

	printf("%-16ld %-8d %-8d %-16s %-8d CLOSE %-8s\n",
		nsecs, pid, tid, comm, $fd,
		$ret == 0 ? "Success" : "\033[1;31mFailed\033[m"
	);
	delete(@close_fds[tid]);
}

tracepoint:syscalls:sys_enter_flock
{
	$fd = args->fd;
	$cmd = args->cmd;

	@fds[tid] = $fd;
	@cmds[tid] = $cmd;
}

tracepoint:syscalls:sys_exit_flock
/ @fds[tid] && @cmds[tid] /
{
	$ret = args->ret;
	$fd = @fds[tid];
	$cmd = @cmds[tid];

	printf("%-16ld %-8d %-8d %-16s %-8d %s%s%s%s  %-8s\n",
		nsecs, pid, tid, comm, $fd,
		$cmd & LOCK_SH ? "S" : "-",
		$cmd & LOCK_EX ? "E" : "-",
		$cmd & LOCK_NB ? "N" : "-",
		$cmd & LOCK_UN ? "U" : "-",
		$ret == 0 ? "Success" : "\033[1;31mFailed\033[m"
	);

	delete(@fds[tid]);
	delete(@cmds[tid]);
}

END
{
	clear(@fds);
	clear(@cmds);
	clear(@filenames);
	clear(@close_fds);
	printf("Bye.\n");
}
