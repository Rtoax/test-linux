OUTPUT := .output/

include kconfig.mk

target-y := PR_CAPBSET_DROP
target-y += PR_GET_NAME
target-y += PR_SET_VMA_ANON_NAME
target-y += PR_GET_ENDIAN
target-y += PR_SET_SECCOMP
target-y += PR_SET_PDEATHSIG

ifeq ($(CONFIG_ANON_VMA_NAME),y)
  CFLAGS += -DCONFIG_ANON_VMA_NAME=1
endif

include main.mk

PR_CAPBSET_DROP: ${OUTPUT}PR_CAPBSET_DROP.o
PR_GET_NAME: ${OUTPUT}PR_GET_NAME.o
PR_SET_VMA_ANON_NAME: ${OUTPUT}PR_SET_VMA_ANON_NAME.o
PR_GET_ENDIAN: ${OUTPUT}PR_GET_ENDIAN.o
PR_SET_SECCOMP: ${OUTPUT}PR_SET_SECCOMP.o
PR_SET_PDEATHSIG: ${OUTPUT}PR_SET_PDEATHSIG.o
