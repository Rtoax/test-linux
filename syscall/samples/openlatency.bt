#!/bin/env bpftrace
/**
 * openlatency.bt - Tracing open syscall latency
 *
 * Copyright (C) CESTC.
 *
 * 2024-03-25	Rong Tao	Create this.
 */

BEGIN
{
	printf("Tracing open syscall latency.\n");
}

tracepoint:syscalls:sys_enter_open,
tracepoint:syscalls:sys_enter_openat,
tracepoint:syscalls:sys_enter_openat2
{
	@start[tid] = nsecs;
}

tracepoint:syscalls:sys_exit_open,
tracepoint:syscalls:sys_exit_openat,
tracepoint:syscalls:sys_exit_openat2
/ @start[tid] /
{
	$latency = nsecs - @start[tid];
	delete(@start[tid]);

	@latency_ns = hist($latency);

	/* 1s */
	if ($latency > 1000000000) {
		@spend_more_than_1s[pid, comm] = count();
	}
}

i:s:2
{
	print(@latency_ns);
	print(@spend_more_than_1s)
}

END
{
	clear(@start);
	clear(@latency_ns);
	clear(@spend_more_than_1s);
}

