#!/bin/env bpftrace
/**
 * openlatency.bt - Tracing open syscall latency
 *
 * Copyright (C) Rong Tao.
 *
 * 2024-03-25	Rong Tao	Create this.
 */

struct __open_how {
	unsigned long flags;
	unsigned long mode;
	unsigned long resolve;
};

BEGIN
{
	printf("Tracing open syscall latency.\n");
	@open_rate = 0;
}

tracepoint:syscalls:sys_enter_open,
tracepoint:syscalls:sys_enter_openat
{
	$flags = args->flags;
	@flags[tid] = $flags;
	@start[tid] = nsecs;
	@files[tid] = args->filename;
}

tracepoint:syscalls:sys_enter_openat2
{
	$how = (struct __open_how *)args->how;
	$flags = $how->flags;
	@flags[tid] = $flags;
	@start[tid] = nsecs;
	@files[tid] = args->filename;
}

tracepoint:syscalls:sys_exit_open,
tracepoint:syscalls:sys_exit_openat,
tracepoint:syscalls:sys_exit_openat2
/ @start[tid] && @files[tid] != 0 /
{
	@open_rate++;

	$flags = @flags[tid];
	$latency = nsecs - @start[tid];

	@latency_ns = hist($latency);

	/* 1s */
	if ($latency > 1000000000) {
		@spent_more_than_1s[pid, comm, str(@files[tid]), $flags] = count();
	} else if ($latency > 500000000) {
		@spent_more_than_500ms[pid, comm, str(@files[tid]), $flags] = count();
	}
	delete(@start[tid]);
	delete(@files[tid]);
	delete(@flags[tid]);
}

i:s:1
{
	printf("Call open(2) %ld/s\n", @open_rate);
	print(@latency_ns);
	print(@spent_more_than_1s);
	print(@spent_more_than_500ms, 10);
	clear(@open_rate);
}

END
{
	clear(@start);
	clear(@latency_ns);
	clear(@spent_more_than_1s);
	clear(@spent_more_than_500ms);
	clear(@files);
	clear(@flags);
	clear(@open_rate);
}

