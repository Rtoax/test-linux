#!/usr/bin/env bpftrace
BEGIN
{
	printf("Tracing clock_gettime, hit ctrl-C to end.\n");
}

tracepoint:syscalls:sys_enter_clock_gettime
{
	@start[tid] = nsecs;
}

tracepoint:syscalls:sys_exit_clock_gettime
/ @start[tid] /
{
	@latency_ns = hist(nsecs - @start[tid]);
	delete(@start[tid]);
}

uprobe:./clock_gettime:sys_clock_gettime
{
	@start_user[tid] = nsecs;
}

uretprobe:./clock_gettime:sys_clock_gettime
/ @start_user[tid] /
{
	@latency_ns_user = hist(nsecs - @start_user[tid]);
	delete(@start_user[tid]);
}

END
{
	clear(@start);
	clear(@start_user);
	printf("Bye.\n");
}
