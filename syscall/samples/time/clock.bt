#!/bin/env bpftrace
/**
 * clock.bt - Tracing clock relate syscall
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2023-11-15	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing xxx, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

tracepoint:syscalls:sys_enter_clock_*
{
	time("%H:%M:%S ");
	printf("%-8d %-8s\n", pid, comm);
}

END
{
	printf("Bye.\n");
}
