#!/bin/env bpftrace
BEGIN
{
	printf("Tracing write(2), hit ctrl-c to end.\n");
}

tracepoint:syscalls:sys_enter_write
{
	@start[tid] = nsecs;
}

tracepoint:syscalls:sys_exit_write
/ @start[tid] /
{
	@hist = hist(nsecs - @start[tid]);
	delete(@start[tid]);
}

END
{
	clear(@start);
	printf("Bye.\n");
}
