#!/bin/env bpftrace
/**
 * flock.bt: Tracing flock syscall
 *
 * Copyright (C) Rong Tao. 2022-2025
 *
 * 2023-07-25	Rong Tao	Create this.
 * 2023-07-26	Rong Tao	Add more hint.
 */
#define LOCK_SH     1	/* Share */
#define LOCK_EX     2	/* Exclusive */
#define LOCK_NB     4	/* Non Block */
#define LOCK_UN     8	/* Unlock */

#define EINTR	4
#define EBADF	9
#define EWOULDBLOCK	11
#define EINVAL	22
#define ENOLCK	37

BEGIN
{
	@errno_str[EINTR] = "EINTR";
	@errno_str[EBADF] = "EBADF";
	@errno_str[EWOULDBLOCK] = "EWOULDBLOCK";
	@errno_str[EINVAL] = "EINVAL";
	@errno_str[ENOLCK] = "ENOLCK";

	printf("Tracing flock(2), hit ctrl-c to end.\n");
	printf(" CMD: Share(S), Exclusive(E), Nonblock(N), Unlock(U)\n");
	printf("\n");
	printf("%-16s %-8s %-8s %-16s ", "TIME(ns)", "PID", "TID", "COMM");
	printf("%-8s %-5s %-8s %-16s %-16s\n", "FD", "CMD", "FLAGS", "RESULT", "FILE");
}

tracepoint:syscalls:sys_enter_open,
tracepoint:syscalls:sys_enter_openat
{
	@filenames[tid] = args->filename;
	@openflags[tid] = args->flags;
}

tracepoint:syscalls:sys_exit_open,
tracepoint:syscalls:sys_exit_openat
/ @filenames[tid] /
{
	$fd = args->ret;
	$filename = @filenames[tid];
	$flags = @openflags[tid];

	printf("%-16ld %-8d %-8d %-16s %-8d OPEN  %-8x %-16s %-16s\n",
		nsecs, pid, tid, comm, $fd,
		$flags,
		$fd > 0 ? "Success" : "Failed",
		str($filename)
	);

	delete(@filenames[tid]);
	delete(@openflags[tid]);
}

tracepoint:syscalls:sys_enter_close
{
	$fd = args->fd;
	@close_fds[tid] = $fd;
}

tracepoint:syscalls:sys_exit_close
/ @close_fds[tid] /
{
	$fd = @close_fds[tid];
	$ret = args->ret;

	printf("%-16ld %-8d %-8d %-16s %-8d CLOSE %-8s %-16s\n",
		nsecs, pid, tid, comm, $fd,
		"-",
		$ret == 0 ? "Success" : "Failed"
	);
	delete(@close_fds[tid]);
}

tracepoint:syscalls:sys_enter_flock
{
	$fd = args->fd;
	$cmd = args->cmd;

	@fds[tid] = $fd;
	@cmds[tid] = $cmd;
}

tracepoint:syscalls:sys_exit_flock
/ @fds[tid] && @cmds[tid] /
{
	$ret = args->ret;
	$fd = @fds[tid];
	$cmd = @cmds[tid];

	printf("%-16ld %-8d %-8d %-16s %-8d %s%s%s%s  %-8s %-16s\n",
		nsecs, pid, tid, comm, $fd,
		$cmd & LOCK_SH ? "S" : "-",
		$cmd & LOCK_EX ? "E" : "-",
		$cmd & LOCK_NB ? "N" : "-",
		$cmd & LOCK_UN ? "U" : "-",
		"-",
		$ret == 0 ? "Success" : @errno_str[-$ret]
	);

	delete(@fds[tid]);
	delete(@cmds[tid]);
}

END
{
	clear(@fds);
	clear(@cmds);
	clear(@filenames);
	clear(@openflags);
	clear(@close_fds);
	clear(@errno_str);
	printf("Bye.\n");
}
