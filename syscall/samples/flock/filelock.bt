#!/bin/env bpftrace
/**
 * filelock.bt - Print file lock information
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2023-07-26	Rong Tao	Create this.
 */

#define EINTR	4
#define EBADF	9
#define EWOULDBLOCK	11
#define EINVAL	22
#define ENOLCK	37

#define FL_POSIX	1
#define FL_FLOCK	2
#define FL_DELEG	4	/* NFSv4 delegation */
#define FL_ACCESS	8	/* not trying to lock, just looking */
#define FL_EXISTS	16	/* when unlocking, test for existence */
#define FL_LEASE	32	/* lease held on this file */
#define FL_CLOSE	64	/* unlock on close */
#define FL_SLEEP	128	/* A blocking lock */
#define FL_DOWNGRADE_PENDING	256 /* Lease is being downgraded */
#define FL_UNLOCK_PENDING	512 /* Lease is being broken */
#define FL_OFDLCK	1024	/* lock is "owned" by struct file */
#define FL_LAYOUT	2048	/* outstanding pNFS layout */

BEGIN
{
	@errno_str[0] = "SUCCESS";
	@errno_str[EINTR] = "EINTR";
	@errno_str[EBADF] = "EBADF";
	@errno_str[EWOULDBLOCK] = "EWOULDBLOCK";
	@errno_str[EINVAL] = "EINVAL";
	@errno_str[ENOLCK] = "ENOLCK";

	printf("Tracing filelock, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

tracepoint:filelock:flock_lock_inode
{
	$ino = args->i_ino;
	$flags = args->fl_flags;

	$ret = args->ret;

	time("%H:%M:%S ");
	printf("%-8d %-8s %-16ld %-16s %lx\n",
		pid, comm, $ino, @errno_str[-$ret], $flags & FL_SLEEP);
}

END
{
	clear(@errno_str);
	printf("Bye.\n");
}
