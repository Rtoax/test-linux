#!/bin/env bpftrace
/**
 * audit_alloc.bt - Tracing audit_alloc()
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2023-09-13	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing audit_alloc(), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

kprobe:audit_alloc
{
	time("%H:%M:%S ");
	printf("%-8d %-8s\n", pid, comm);
}

END
{
	printf("Bye.\n");
}
