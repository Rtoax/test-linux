#!/usr/bin/env bpftrace
/**
 * audit_enabled.bt - Print audit_enabled,audit_ever_enabled,... value
 *
 * 2023-09-13	Rong Tao	Create this.
 */
#include <linux/audit.h>

struct val {
	u32 i;
};

BEGIN
{
	@V[AUDIT_OFF] = "OFF";
	@V[AUDIT_ON] = "ON";
	@V[AUDIT_LOCKED] = "LOCKED";

	$audit_enabled = (struct val *)kaddr("audit_enabled");
	$audit_ever_enabled = (struct val *)kaddr("audit_ever_enabled");

	printf("audit_enabled = %s\n", @V[$audit_enabled->i]);
	printf("audit_ever_enabled = %d\n", $audit_ever_enabled->i);
	exit();
}

END
{
	clear(@V);
}
