#!/usr/bin/env bpftrace
/**
 * File: update_vsyscall.bt
 *
 * Author: Rong Tao
 * Date: 2022.05.10
 */
BEGIN
{
	printf("Tracing update_vsyscall, hit ctrl-C to end.\n");
	if ($# == 0) {
		printf("Usage: ./update_vsyscall.bt [OPTs].\n");
		printf(" OPTs:\n");
		printf("	[kstack] to print kernel stack.\n");
	}
}

kprobe:update_vsyscall
{
	@start[pid] = nsecs;
	// See kernel stack of update_vsyscall().
	if (strncmp(str($1), "kstack", 6) == 0) {
		@stacks[kstack] = count();
	}
	@update_count = count();
}

kretprobe:update_vsyscall
/@start[pid]/
{
	@latency_us = hist((nsecs - @start[pid]) / 1000);
	delete(@start[pid]);
}

i:s:1
{
	print(@update_count);
	clear(@update_count);
}

END
{
	print(@stacks, 2);
	clear(@stacks);
	clear(@start);
}

