#!/usr/bin/env bpftrace
/**
 * clock_gettime.bt - get clock_gettime() latancy
 *
 * Copyright (C) CESTC, Co.
 *
 * 2023-04-06	Rong Tao	Create this.
 */

BEGIN
{
	printf("Tracing clock_gettime latency, hit ctrl-C to exit.\n");
}

uprobe:/lib64/libc.so.6:clock_gettime
{
	@start[tid] = nsecs;
}

uretprobe:/lib64/libc.so.6:clock_gettime
/ @start[tid] /
{
	$latency_us = (nsecs - @start[tid]) / 1000;
	@graph_latancy_us = hist($latency_us);
	delete(@start[tid]);
}

END
{
	clear(@start);
}

