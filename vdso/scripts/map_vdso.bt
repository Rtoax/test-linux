#!/usr/bin/env bpftrace
/**
 * Tracing kprobe:map_vdso
 *
 * Every process create will call 'map_vdso' function
 */
#include <linux/kernel.h>
#if defined(CONFIG_X86_64)
/* see arch/x86/include/asm/vdso.h */
struct vdso_image {
	/* =raw_data: see /arch/x86/entry/vdso/vdso2c.h */
	void *data;
	unsigned long size;   /* Always a multiple of PAGE_SIZE */
	unsigned long alt, alt_len;

	long sym_vvar_start;  /* Negative offset to the vvar area */
	long sym_vvar_page;
	long sym_pvclock_page;
	long sym_hvclock_page;
	long sym_timens_page;
	long sym_VDSO32_NOTE_MASK;
	long sym___kernel_sigreturn;
	long sym___kernel_rt_sigreturn;
	long sym___kernel_vsyscall;
	long sym_int80_landing_pad;
};
#else
# error "Unsupport arch, just x86_64 right now."
#endif

BEGIN
{
	printf("Tracing kprobe:map_vdso, hit ctrl-C to end.\n");
	printf("%-8s %-16s %-6s %-16s\n", "PID", "COMM", "SIZE", "VVAR_ADDR");
	printf("\t\033[2m%-16s %-8s %-16s %-16s %-16s %-16s\033[m\n",
		"DATA(raw_data)", "SIZE", "VVAR_Start", "VVAR_Page", "PVCLOCK_Page", "HVCLOCK_Page");
}

kprobe:map_vdso
{
	$vdso_image = (struct vdso_image *)arg0;
	$addr = arg1;
	printf("%-8d %-16s %-6d %-16lx\n", tid, comm, $vdso_image->size, $addr);
	printf("\t\033[2m%-16lx %-8d %-16lx %-16lx %-16lx %-16lx\033[m\n",
		$vdso_image->data,
		$vdso_image->size,
		$vdso_image->sym_vvar_start,
		$vdso_image->sym_vvar_page,
		$vdso_image->sym_pvclock_page,
		$vdso_image->sym_hvclock_page);
	/**
	 * @map_vdso_kstack[
	 *     map_vdso+1
	 *     load_elf_binary+2665
	 *     search_binary_handler+210
	 *     exec_binprm+81
	 *     bprm_execve.part.0+364
	 *     do_execveat_common.isra.0+342
	 *    __x64_sys_execve+51
	 *    do_syscall_64+56
	 *    entry_SYSCALL_64_after_hwframe+68
	 * ]: 2
	 */
	@map_vdso_kstack[kstack] = count();
}

END
{
	printf("Bye.\n");
}
