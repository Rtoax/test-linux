#!/usr/bin/env bpftrace

BEGIN
{
	printf("Tracing clock_gettime latency, hit ctrl-C to exit.\n");
}

uprobe:libc:gettimeofday,
uprobe:libc:clock_gettime
{
	@start[tid] = nsecs;
}

uretprobe:libc:gettimeofday,
uretprobe:libc:clock_gettime
/ @start[tid] /
{
	@latency_ns_hist = hist(nsecs - @start[tid]);
	delete(@start[tid]);
}

END
{
	clear(@start);
}

