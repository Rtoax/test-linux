#!/usr/bin/env bpftrace
/**
 * clock_gettime.bt - get clock_gettime() latency
 *
 * Copyright (C) Rong Tao.
 *
 * 2023-04-06	Rong Tao	Create this.
 */

BEGIN
{
	printf("Tracing clock_gettime latency, hit ctrl-C to exit.\n");
}

uprobe:libc:clock_gettime
{
	@start[tid] = nsecs;
	@cnt[comm] = count();
}

uretprobe:libc:clock_gettime
/ @start[tid] /
{
	$latency_us = (nsecs - @start[tid]) / 1000;
	@graph_latency_us = hist($latency_us);
	delete(@start[tid]);
}

END
{
	clear(@cnt);
	clear(@start);
}

