#!/usr/bin/env bpftrace
/**
 * Rong Tao <rtoax@foxmail.com>
 * 2022.02.20
 * Tracing kprobe:vdso_fault
 *
 * Every process create will call 'vdso_fault' function
 */
#include <linux/kernel.h>
#include <linux/mm.h>
#if defined(CONFIG_X86_64)
// see arch/x86/include/asm/vdso.h
struct vdso_image {
	void *data;
	unsigned long size;   /* Always a multiple of PAGE_SIZE */
};
#else
# error "Unsupport arch, just x86_64 right now."
#endif

BEGIN
{
	printf("Tracing kprobe:vdso_fault, hit ctrl-C to end.\n");
	printf("Legend: \033[1;32mvDSO ELF\033[m, ");
	printf("\033[1;31m[vdso] VMA\033[m\n");
	printf("%-8s %-16s \033[1;32m%-16s %-8s %-8s \033[1;31m%-16s %-16s\033[m\n",
		 "PID", "COMM", "KADDR", "SIZE", "OFF", "VM_START", "VM_END");
}

kprobe:vdso_fault
{
	$vma = (struct vm_area_struct *)arg1;
	$vmf = (struct vm_fault *)arg2;
	$vdso_image = (struct vdso_image*)($vma->vm_mm->context.vdso_image);
	$kaddr = $vdso_image->data + ($vmf->pgoff << PAGE_SHIFT);
	$size = $vdso_image->size;

	/**
	 * VMA start-end is same as `sudo cat /proc/[PID]/maps | grep vdso`
	 */
	printf("%-8d %-16s \033[1;32m%-16lx %-8d %-8lx \033[1;31m%-16lx %-16lx\033[m\n",
		tid, comm, $kaddr, $size, ($vmf->pgoff << PAGE_SHIFT),
		$vma->vm_start, $vma->vm_end);

	// $kaddr is vDSO ELF file pointer.
	//printf("%r\n", buf(str($kaddr), 64));

	/**
	 * @vdso_fault[
	 *     vdso_fault+1
	 *     __do_fault+51
	 *     do_read_fault+230
	 *     do_fault+197
	 *     __handle_mm_fault+971
	 *     handle_mm_fault+197
	 *     do_user_addr_fault+443
	 *     exc_page_fault+98
	 *     asm_exc_page_fault+30
	 * ]: 13
	*/
	@vdso_fault[kstack] = count();
}

END
{
	printf("Bye.\n");
}
