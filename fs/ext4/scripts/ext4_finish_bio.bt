#!/usr/bin/env bpftrace
/**
 * File: ext4_finish_bio.bt
 *
 * 2022-02-18	Rong Tao	Create this.
 */
#include <linux/bio.h>
#include <linux/genhd.h>

BEGIN
{
	printf("Tracing ext4_finish_bio, Ctrl-C to end.\n");
	printf("%-16s %-8s %-8s %-8s %-8s %-8s %-8s\n",
		"COMM", "DEV", "MAJOR", "MINOR", "SECTOR", "SIZE", "IDX");
}

kprobe:ext4_finish_bio
{
	$bio = (struct bio *)arg0;
	$bdev = $bio->bi_bdev;
	$gendisk = $bdev->bd_disk;

	$sector = $bio->bi_iter.bi_sector;
	$size = $bio->bi_iter.bi_size;
	$idx = $bio->bi_iter.bi_idx;

	printf("%-16s %-8s %-8d %-8d %-8d %-8d %-8d\n",
		comm,
		$gendisk->disk_name,
		$gendisk->major,
		$gendisk->minors,
		$sector,
		$size,
		$idx);
}

END
{
	printf("Bye.\n");
}
