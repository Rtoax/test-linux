#!/bin/env bpftrace
/**
 * ovlfsnoop.bt - Tracing overlayfs file operations
 *
 * Need overlay kernel module.
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2024-03-21	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing overlayfs file operations, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s\n", "TIME", "PID", "COMM", "OPS");
}

kprobe:ovl_open
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s\n", pid, comm, "open");
}

kprobe:ovl_unlink
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s\n", pid, comm, "unlink");
}

kprobe:ovl_statfs
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s\n", pid, comm, "statfs");
}

kprobe:ovl_mkdir
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s\n", pid, comm, "mkdir");
}

kprobe:ovl_rmdir
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s\n", pid, comm, "rmdir");
}

kprobe:ovl_rename
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s\n", pid, comm, "rename");
}

kprobe:ovl_new_inode
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8s\n", pid, comm, "new-ino");
}

END
{
	printf("Bye.\n");
}
