#!/bin/env bpftrace
/**
 * ovlfsnoop.bt - Tracing overlayfs file operations
 *
 * Need overlay kernel module.
 *
 * Copyright (C) Rong Tao 2022-2025
 */
BEGIN
{
	printf("Tracing overlayfs file operations, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %s\n", "TIME", "PID", "COMM", "OPS");
}

kprobe:ovl_open,
kprobe:ovl_unlink,
kprobe:ovl_statfs,
kprobe:ovl_mkdir,
kprobe:ovl_rmdir,
kprobe:ovl_rename,
kprobe:ovl_new_inode
{
	time("%H:%M:%S ");
	/* probe+11 to skip kprobe:ovl_ prefix */
	printf("%-8d %-16s %s\n", pid, comm, probe + 11);
}

END
{
	printf("Bye.\n");
}
