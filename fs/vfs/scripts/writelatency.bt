#!/bin/env bpftrace
/**
 * writelatency.bt - Tracing vfs_write latency
 *
 * Copyright (C) Rong Tao 2024
 *
 * 2024-09-05	Rong Tao	Create this.
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/fs.h>
#endif

BEGIN
{
	printf("Tracing vfs_write, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s %-8s %-8s %-8s\n",
		 "TIME", "PID", "COMM", "LAT(us)", "FILE", "BUF", "LEN");
}

tracepoint:syscalls:sys_enter_write
{
	@sys_buf[tid] = args->buf;
}

kprobe:vfs_write
{
	@start[tid] = nsecs;
	@comm[tid] = comm;
	@file[tid] = (struct file *)arg0;
	/* FIXME: Why it's NULL? */
	@buf[tid] = arg1;
	@buf_len[tid] = arg2;
}

kretprobe:vfs_write
/ @start[tid] /
{
	$us = (nsecs - @start[tid]) / 1000;
	@latency_us = hist($us);

	/* call vfs_write too much times, only print big latency */
	if ($us > 1000000) {
		$file = @file[tid];
		$buf = @buf[tid];
		$len = @buf_len[tid];
		$f_name = $file->f_path.dentry->d_name.name;

		time("%H:%M:%S ");
		printf("%-8d %-16s %-8d %s %r %-8d\n",
			pid, @comm[tid], $us, str($f_name),
			buf(@sys_buf[tid], $len), $len);
	}

	delete(@start[tid]);
	delete(@comm[tid]);
	delete(@file[tid]);
	delete(@buf[tid]);
	delete(@buf_len[tid]);
}

tracepoint:syscalls:sys_exit_write
{
	delete(@sys_buf[tid]);
}

END
{
	clear(@start);
	clear(@comm);
	clear(@file);
	clear(@buf);
	clear(@buf_len);
	clear(@sys_buf);
	printf("Bye.\n");
}
