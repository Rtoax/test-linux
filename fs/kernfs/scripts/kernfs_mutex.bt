#!/bin/env bpftrace
/**
 * kernfs_mutex.bt
 *
 * Copyright (C) Rong Tao 2022-2023
 */

BEGIN
{
	printf("Tracing xxx, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

kprobe:kernfs_get
{
	time("%H:%M:%S ");
	printf("%-8d %-8s\n", pid, comm);
}

END
{
	printf("Bye.\n");
}
