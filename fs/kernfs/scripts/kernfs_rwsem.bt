#!/usr/bin/env bpftrace
/**
 * kernfs_rwsem.bt - Tracing kernfs_rwsem lock
 *
 * 2023-05-20	Rong Tao	Create this.
 */
#include <linux/mutex.h>
#include <linux/rwsem.h>
#include <linux/sched.h>

BEGIN
{
	printf("Tracing who hold kernfs_mutex, hit ctrl-c to end.\n");
	printf("%-8s %-16s %-16s\n", "TIME", "PID", "COMM");
}

interval:s:1
{
	/**
	 * per-fs lock: >= v5.16-rc2-1-g393c3714081a
	 * kernfs_rwsem: v5.14-rc3-16-g7ba0273b2f34 <= V < v5.16-rc2-1-g393c3714081a
	 * kernfs_mutex:                               V < v5.14-rc3-16-g7ba0273b2f34
	 */
	$kernfs_lock = (struct rw_semaphore *)kaddr("kernfs_rwsem");
	/* FIXME: Why need -1 */
	$task = (struct task_struct *)($kernfs_lock->owner.counter - 1);

	time("%H:%M:%S ");
	printf("%-16d %-16s %-8ld\n", $task->pid, $task->comm,
		$kernfs_lock->count.counter);
}

END
{
	printf("Bye.\n");
}
