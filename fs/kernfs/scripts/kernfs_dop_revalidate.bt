#!/usr/bin/env bpftrace
/**
 * kernfs_dop_revalidate.bt
 *
 * prometheus node-exporter may hold kernfs_{rwsem,mutex} lock (kernel < 5.16),
 * this scription could get the task who hold the lock (maybe).
 *
 * Copyright (C) Rong Tao, 2022-2025
 *
 * 2023-03-20	Rong Tao	Create this.
 * 2023-03-21	Rong Tao	Add latency hist.
 */

BEGIN
{
	printf("Tracing who hold kernfs_mutex, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

kprobe:kernfs_add_one,
kprobe:kernfs_iop_permission,
kprobe:kernfs_dop_revalidate
{
	@start[tid] = nsecs;
}

kretprobe:kernfs_add_one,
kretprobe:kernfs_iop_permission,
kretprobe:kernfs_dop_revalidate
/ @start[tid] /
{
	@comms[comm] = count();

	$latency = (nsecs - @start[tid]) / 1000;
	delete(@start[tid]);
	@latency_usecs = hist($latency);

	if ($latency > @max_latency[1]) {
		@max_latency[1] = $latency;
		@max_latency_comm[1] = comm;
	}
}

interval:s:1
{
	printf("=== \n");
	printf("=== Task may hold or wait kernfs_{mutex,rwsem}\n");
	printf("=== \n");
	printf("=== MAX latency %ld us, comm %s\n", @max_latency[1], @max_latency_comm[1]);
	print(@comms, 3);
	print(@latency_usecs);
}

END
{
	clear(@start);
	clear(@comms);
	clear(@latency_usecs);
	clear(@max_latency);
	clear(@max_latency_comm);
}
