 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	$task = curtask;
	$utask = $task->utask;
	printf("%-16s %-16lx\n", $task->comm, $utask->vaddr);
	exit();
}
