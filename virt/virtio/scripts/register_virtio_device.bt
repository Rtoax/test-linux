#!/bin/env bpftrace
/**
 * register_virtio_device.bt
 *
 * Copyright (C) Rong Tao 2024
 * Copyright (C) Rong Tao 2022-2025
 */
#include <linux/virtio.h>

BEGIN
{
	printf("Tracing register_virtio_device(), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-4s %-8s\n",
		"TIME", "PID", "COMM", "IDX", "NAME");
}

/* This function will not be called during Start a VM */
kprobe:register_virtio_device
{
	@devs[tid] = (struct virtio_device *)arg0;
}

kretprobe:register_virtio_device
/ @devs[tid] /
{
	$dev = @devs[tid];
	$index = $dev->index;

	time("%H:%M:%S ");
	printf("%-8d %-16s %-4d %-8s\n", pid, comm, $index,
		str($dev->dev.kobj.name));

	delete(@devs[tid]);
}

END
{
	clear(@devs);
	printf("Bye.\n");
}
