#!/bin/env bpftrace
/**
 * File: virtqueue_kick.bt
 * Author: Rong Tao <rtoax@foxmail.com>
 * Date: 2022.06.19
 *
 */
BEGIN
{
	printf("Tracing virtqueue_kick, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

/**
 * 驱动在添加请求数据到 virtqueue 后，会调用 virtqueue_kick 函数
 * 来通知对端设备
 */
kprobe:virtqueue_kick
{
	time("%H:%M:%S ");
	printf("%-8d %-8s\n", pid, comm);
}

END
{
	printf("Bye.\n");
}
