<!-- you could see /dev/pmemN in guestos -->
<domain type='qemu'>
  <!-- may need maxMemory -->
  <maxMemory slots='16' unit='GiB'>16</maxMemory>
  <devices>
    <memory model='nvdimm'>
      <source>
        <path>/home/sda/qcow2s/nvdimm.bin</path>
      </source>
      <target>
        <size unit='GiB'>1</size>
        <node>0</node>
      </target>
      <address type='dimm' slot='0'/>
    </memory>
  </devices>
</domain>

<!-- Direct qemu command -->
<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <qemu:commandline>
    <!-- need enable nvdimm=on for -machine -->
    <qemu:arg value='-machine'/>
    <qemu:arg value='nvdimm=on'/>
    <!--
      unarmed=on: readonly
    -->
    <qemu:arg value='-device'/>
    <qemu:arg value='nvdimm,id=nv0,memdev=mem0'/>
    <!--
      sudo chown qemu:qemu nvdimm.bin
      readonly=on: readonly
    -->
    <qemu:arg value='-object'/>
    <qemu:arg value='memory-backend-file,id=mem0,mem-path=/home/sda/qcow2s/nvdimm.bin,size=1073741824'/>
  </qemu:commandline>
</domain>
