<!--
Q: error: unsupported configuration: host doesn't support passthrough of host PCI devices
A: Enable IOMMU if x86, SMMU if arm in BIOS
   And maybe you need to:
     Add iommu.passthrough=1 to kernel argument
     sudo grubby \-\-args=iommu.passthrough=1 \-\-update-kernel=/boot/vmlinuz-$(uname -r)
-->
<domain type='kvm'>
  <!-- ... -->
  <devices>
    <!-- ... -->
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source>
        <address domain='0x0000' bus='0x81' slot='0x00' function='0x0'/>
      </source>
      <address type='pci' domain='0x0000' bus='0x99' slot='0x00' function='0x0'/>
    </hostdev>
    <!-- ... -->
  </devices>
</domain>
