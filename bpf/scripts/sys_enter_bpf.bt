#!/usr/bin/env bpftrace
#ifndef BPFTRACE_HAVE_BTF
#include <uapi/linux/bpf.h>
#endif

BEGIN
{
	@CMD_STR[BPF_MAP_CREATE] = "BPF_MAP_CREATE";
	@CMD_STR[BPF_MAP_LOOKUP_ELEM] = "BPF_MAP_LOOKUP_ELEM";
	@CMD_STR[BPF_MAP_UPDATE_ELEM] = "BPF_MAP_UPDATE_ELEM";
	@CMD_STR[BPF_MAP_DELETE_ELEM] = "BPF_MAP_DELETE_ELEM";
	@CMD_STR[BPF_MAP_GET_NEXT_KEY] = "BPF_MAP_GET_NEXT_KEY";
	@CMD_STR[BPF_PROG_LOAD] = "BPF_PROG_LOAD";
	@CMD_STR[BPF_OBJ_PIN] = "BPF_OBJ_PIN";
	@CMD_STR[BPF_OBJ_GET] = "BPF_OBJ_GET";
	@CMD_STR[BPF_PROG_ATTACH] = "BPF_PROG_ATTACH";
	@CMD_STR[BPF_PROG_DETACH] = "BPF_PROG_DETACH";
	@CMD_STR[BPF_PROG_TEST_RUN] = "BPF_PROG_TEST_RUN";
	@CMD_STR[BPF_PROG_GET_NEXT_ID] = "BPF_PROG_GET_NEXT_ID";
	@CMD_STR[BPF_MAP_GET_NEXT_ID] = "BPF_MAP_GET_NEXT_ID";
	@CMD_STR[BPF_PROG_GET_FD_BY_ID] = "BPF_PROG_GET_FD_BY_ID";
	@CMD_STR[BPF_MAP_GET_FD_BY_ID] = "BPF_MAP_GET_FD_BY_ID";
	@CMD_STR[BPF_OBJ_GET_INFO_BY_FD] = "BPF_OBJ_GET_INFO_BY_FD";
	@CMD_STR[BPF_PROG_QUERY] = "BPF_PROG_QUERY";
	@CMD_STR[BPF_RAW_TRACEPOINT_OPEN] = "BPF_RAW_TRACEPOINT_OPEN";
	@CMD_STR[BPF_BTF_LOAD] = "BPF_BTF_LOAD";
	@CMD_STR[BPF_BTF_GET_FD_BY_ID] = "BPF_BTF_GET_FD_BY_ID";
	@CMD_STR[BPF_TASK_FD_QUERY] = "BPF_TASK_FD_QUERY";
	@CMD_STR[BPF_MAP_LOOKUP_AND_DELETE_ELEM] = "BPF_MAP_LOOKUP_AND_DELETE_ELEM";
	@CMD_STR[BPF_MAP_FREEZE] = "BPF_MAP_FREEZE";
	@CMD_STR[BPF_BTF_GET_NEXT_ID] = "BPF_BTF_GET_NEXT_ID";
	@CMD_STR[BPF_MAP_LOOKUP_BATCH] = "BPF_MAP_LOOKUP_BATCH";
	@CMD_STR[BPF_MAP_LOOKUP_AND_DELETE_BATCH] = "BPF_MAP_LOOKUP_AND_DELETE_BATCH";
	@CMD_STR[BPF_MAP_UPDATE_BATCH] = "BPF_MAP_UPDATE_BATCH";
	@CMD_STR[BPF_MAP_DELETE_BATCH] = "BPF_MAP_DELETE_BATCH";
	@CMD_STR[BPF_LINK_CREATE] = "BPF_LINK_CREATE";
	@CMD_STR[BPF_LINK_UPDATE] = "BPF_LINK_UPDATE";
	@CMD_STR[BPF_LINK_GET_FD_BY_ID] = "BPF_LINK_GET_FD_BY_ID";
	@CMD_STR[BPF_LINK_GET_NEXT_ID] = "BPF_LINK_GET_NEXT_ID";
	@CMD_STR[BPF_ENABLE_STATS] = "BPF_ENABLE_STATS";
	@CMD_STR[BPF_ITER_CREATE] = "BPF_ITER_CREATE";
	@CMD_STR[BPF_LINK_DETACH] = "BPF_LINK_DETACH";
	@CMD_STR[BPF_PROG_BIND_MAP] = "BPF_PROG_BIND_MAP";
	@CMD_STR[BPF_TOKEN_CREATE] = "BPF_TOKEN_CREATE";
	/* add more */

	printf("Tracing bpf(2) syscall, press ctrl-C to end.\n");
	printf("%-8s %-16s %-4s %-20s\n", "PID", "COMM", "RET", "CMD");
}

tracepoint:syscalls:sys_enter_bpf
{
	@cmds[tid] = args->cmd;
}

tracepoint:syscalls:sys_exit_bpf
/ @cmds[tid] != 0 /
{
	$cmd = @cmds[tid];
	printf("%-8d %-16s %-4d %-20s\n", pid, comm, args->ret, @CMD_STR[$cmd]);
	@cmd_count[@CMD_STR[$cmd]] = count();
	delete(@cmds[tid]);
}

END
{
	clear(@CMD_STR);
	clear(@cmds);
	printf("Bye.\n");
}
