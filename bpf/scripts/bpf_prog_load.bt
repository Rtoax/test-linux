#!/usr/bin/env bpftrace
#include <linux/filter.h>
#include <uapi/linux/bpf.h>


BEGIN
{
	@Type[BPF_PROG_TYPE_UNSPEC] = "Unspec";
	@Type[BPF_PROG_TYPE_SOCKET_FILTER] = "SockFilter";
	@Type[BPF_PROG_TYPE_KPROBE] = "Kprobe";
	@Type[BPF_PROG_TYPE_TRACEPOINT] = "TracePoint";
	@Type[BPF_PROG_TYPE_PERF_EVENT] = "PerfEvent";
	@Type[BPF_PROG_TYPE_XDP] = "XDP";
	@Type[BPF_PROG_TYPE_LWT_IN] = "LWT IN";
	@Type[BPF_PROG_TYPE_LWT_OUT] = "LWT OUT";
	@Type[BPF_PROG_TYPE_LWT_XMIT] = "LWT XMIT";
	@Type[BPF_PROG_TYPE_RAW_TRACEPOINT] = "RawTracePoint";

	printf("Tracing bpf_prog_load(), end with ctrl+c\n");
	printf("%-7s %-8s %-8s %-16s\n", "K/U", "PID", "COMM", "TYPE");
}

kprobe:bpf_prog_load
{
	$attr = (union bpf_attr *)arg0;
	$type = $attr->prog_type;

	printf("kernel: %-8d %-8s %-16s\n", pid, comm, @Type[$type]);
}

uprobe:libbpf:bpf_prog_load,
uprobe:/usr/bin/bpftrace:bpf_prog_load
{
	@libbpf_prog_type[tid] = arg0;
}

uretprobe:libbpf:bpf_prog_load,
uretprobe:/usr/bin/bpftrace:bpf_prog_load
/ @libbpf_prog_type[tid] /
{
	printf("libbpf: %-8d %-8s %-16s %d\n", pid, comm,
		@Type[@libbpf_prog_type[tid]], retval);
	delete(@libbpf_prog_type[tid]);
}

END
{
	clear(@libbpf_prog_type);
	clear(@Type);
}
