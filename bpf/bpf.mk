ifndef _ANSI
  $(error Not define _ANSI, include ansi.mk)
endif

BPF_TARGET_ARCH ?= $(shell uname -m | sed 's/x86_64/x86/' \
			 | sed 's/arm.*/arm/' \
			 | sed 's/aarch64/arm64/' \
			 | sed 's/ppc64le/powerpc/' \
			 | sed 's/mips.*/mips/' \
			 | sed 's/riscv64/riscv/' \
			 | sed 's/loongarch64/loongarch/')

CFLAG_BPF_TARGET_ARCH := -D__TARGET_ARCH_$(BPF_TARGET_ARCH)

b := ${ANSI_BLK}${ANSI_REVE}
w := ${ANSI_BRIGHT_BLACK}${ANSI_REVE}
W := ${ANSI_DARK_WHITE}${ANSI_REVE}
Y := ${ANSI_YEL}${ANSI_REVE}
B := ${ANSI_BLU}${ANSI_REVE}
G := ${ANSI_GRAY}${ANSI_REVE}
C := ${ANSI_CYAN}${ANSI_REVE}
R := ${ANSI_RST}

define bpf_logo_summit_2021
@echo -e "                     ${w}.${R}${b}####-${R}                ${b}.+@@@@-${R}"
@echo -e "                     ${w}.${R}${b}####=${R}                ${b}.+@@@@-${R}"
@echo -e "                ${w}:${R}${b}*####${R}                 ${b}@@@@@+${R}"
@echo -e "                ${w}:${R}${b}*####${R}                 ${b}@@@@@+${R}"
@echo -e "                ${w}:${R}${b}*####${R}                 ${b}@@@@@+${R}"
@echo -e "                ${w}:${R}${b}*####:::::::::::::::::@@@@@+:::.${R}"
@echo -e "              ${w}:${R}${b}*####@@@@@@@@@@@@@@@@@@@@@@@@@####-${R}"
@echo -e "            ${w}-${R}${b}####@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-"
@echo -e "${b}:---:${R}       ${w}-${R}${b}####@@@@@##########@@@@##########@@@-${R}"
@echo -e "${b}+@@@*${R}       ${w}-${R}${b}####@@@@@####${R}${C}+====*${R}${b}@@@#####${R}${C}====+${R}${b}#@@@-${R}"
@echo -e "${b}+@@@*${R}       ${w}-${R}${b}####@@@@@####${R}${C}+====*${R}${b}@@@#####${R}${C}====+${R}${b}#@@@-${R}"
@echo -e "${b}+@@@*${R}       ${w}-${R}${b}####@@@@@#####****#@@@#####*****#@@@-${R}            ${b}.+*****${R}"
@echo -e "${b}+@@@*${R}       ${w}-${R}${b}####@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@-${R}            ${b}:#@@@@@${R}"
@echo -e "    ${b}=@@@@${R}${B}########${R}${b}#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#${R}${B}###=.${R}   ${b}:@@@@:${R}"
@echo -e "    ${B}-####${R}${b}@@@@@@@${R}${Y}#+--------------------------+${R}${b}#@@@@@@@@#####::::.${R}"
@echo -e "    ${B}-####${R}${b}@@@@@@@${R}${Y}#=::::::::::::::::::::::::::=${R}${b}#@@@@@@@@@@@@#${R}"
@echo -e "${B}=###*${R}${G}===========${R}${b}+#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*${R}${G}=========${R}${B}###*:${R}"
@echo -e "${B}=###*${R}${G}-----------${R}${b}=#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@+${R}${G}--------=${R}${B}####:${R}"
@echo -e "${B}=###*${R}${G}-----------${R}${Y}--:::::::::::::::::::::::::::::::-${R}${G}--------=${R}${B}####:${R}"
@echo -e "${B}=###*${R}${G}-----------${R}${Y}--:::::::::::::::::::::::::::::::-${R}${G}--------=${R}${B}####:${R}"
@echo -e "${B}=###*${R}${G}-----------${R}${b}=#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@+${R}${G}--------=${R}${B}####:${R}"
@echo -e "${B}=###*${R}${G}===========${R}${b}+#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@*${R}${G}=========${R}${B}###*:${R}"
@echo -e "    ${B}-###########${R}${b}#@@@@@@@@@${R}${Y}+::::::::::::${R}${b}=@@@@@@@@@${R}${B}##########${R}"
@echo -e "    ${B}-###########${R}${b}#@@@@@@@@@${R}${Y}+::::::::::::${R}${b}=@@@@@@@@@${R}${B}##########${R}"
@echo -e "                ${b}:#@@@@${R}   ${b}:*@@@@@@@@@@@@#${R}   ${b}.+@@@@-${R}"
@echo -e "                ${b}:#@@@@${R}   ${b}.-++++++++++++-${R}   ${b}.+@@@@-${R}"
@echo -e "                ${b}:#@@@@${R}                     ${b}.+@@@@-${R}"
@echo -e "       ${b}.=@@@@@@@@@@@@@${R}                     ${b}.+@@@@@@@@@@@@@#${R}"
@echo -e "       ${b}.+@@@@@@@@@@@@@${R}                     ${b}.+@@@@@@@@@@@@@#${R}"
@echo -e "${W}........-=============...................-==============.............${R}"
@echo -e "${W}:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::${R}"
endef
