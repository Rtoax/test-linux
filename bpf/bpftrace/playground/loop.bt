#!/bin/env bpftrace
macro test_arithmetic_sum() {
  import "loop.bpf.c";

  $cnt = __bpf_arithmetic_sum(4);
  $cnt
}

macro test_strlen() {
  let $str : string[256];
  $str = "12345";
  __bpf_strlen((int8*)&$str, 256)
}

BEGIN
{
  printf("arithmetic sum %d\n", test_arithmetic_sum);
  printf("strlen %d\n", test_strlen());
  exit();
}
