#!/bin/env bpftrace
macro test_arithmetic_sum() {
  import "loop.bpf.c";

  $cnt = __bpf_arithmetic_sum(4);
  $cnt
}

macro test_strnlen() {
  let $str : string[256];
  $str = "1234567890abcdefghijklmnopqrstuvwxyz";
  __bpf_strnlen((int8*)&$str, 256)
}

BEGIN
{
  printf("arithmetic sum %d\n", test_arithmetic_sum);
  printf("strnlen %d\n", test_strnlen());
  exit();
}
