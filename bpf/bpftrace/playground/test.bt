#!/bin/env bpftrace
macro v1234() {
  import "dummy.bpf.c";

  let $v = __bpf_dummy();

  $v
}

macro add(a, b) {
  import "add.bpf.c";

  let $v = __bpf_add(a, b);
  $v
}

macro factorial(a) {
  import "factorial.bpf.c";

  let $v = __bpf_factorial(a);
  $v
}

macro memcpy($dest, $src, n) {
  import "string.bpf.c";

  __bpf_memcpy((int8*)&$dest, (int8*)&$src, (int32)n);
}

macro strncpy($dest, $src, n) {
  import "string.bpf.c";

  __bpf_strncpy((int8*)&$dest, (int8*)&$src, (int32)n);
}

BEGIN
{
  printf("%s\n", v1234);
  printf("%d\n", add(1, 2));
  printf("%ld\n", factorial(3));

  let $src = "abcdefghijklmnopqrstuvwxyz";
  let $s1 : string[27];
  let $s2 : string[27];

  memcpy($s1, $src, 27);
  printf("%s, %s\n", $src, $s1);

  strncpy($s2, $src, 10);
  printf("%s, %s\n", $src, $s2);

  exit();
}
