#!/bin/bash
set -ex

. /etc/os-release

deb() {
	sudo apt-get install -y \
		ament-cmake-googletest \
		asciidoctor \
		binutils-dev \
		bison \
		build-essential \
		clang \
		cmake \
		flex \
		google-mock \
		googletest \
		libbpf-dev \
		libbpfcc-dev \
		libcereal-dev \
		libdw-dev \
		libelf-dev \
		libiberty-dev \
		libpcap-dev \
		llvm-dev \
		liblldb-dev \
		libclang-dev \
		systemtap-sdt-dev \
		xxd \
		zlib1g-dev
}

rpm_pkgs() {
	sudo dnf install -y \
		rubygem-asciidoctor
}

if [[ " debian ubuntu " =~ " ${ID} " ]]; then
	deb
	cmake_args+=( -DLLVM_REQUESTED_VERSION=19 )
elif [[ " rhel centos fedora " =~ " ${ID} " ]]; then
	rpm_pkgs
fi

cmake \
	-DCMAKE_INSTALL_PREFIX=/usr/ \
	-DCMAKE_BUILD_TYPE=Debug \
	-DBUILD_TESTING=ON \
	-DVENDOR_GTEST=OFF \
	${cmake_args[@]} \
	..

make -j$(($(nproc) / 2))
sudo make install
