#!/bin/bash
set -e

readonly prog=bpftrace-compile

flags_deps=
flags_cmake=
flags_install=
verbose=

declare -a cmake_args

. /etc/os-release

deb_pkgs() {
	sudo apt-get install -y \
		googletest \
		asciidoctor \
		binutils-dev \
		bison \
		build-essential \
		clang \
		cmake \
		flex \
		google-mock \
		googletest \
		libbpf-dev \
		libbpfcc-dev \
		libcereal-dev \
		libdw-dev \
		libelf-dev \
		libgtest-dev \
		libgmock-dev \
		libiberty-dev \
		libpcap-dev \
		llvm-dev \
		liblldb-dev \
		libclang-dev \
		systemtap-sdt-dev \
		xxd \
		zlib1g-dev
}

rpm_pkgs() {
	sudo dnf install -y --skip-broken \
		blazesym-c-devel \
		rubygem-asciidoctor
}

__usage__()
{
	echo -e "
NAME
	${prog} - Compile bpftrace

SYNOPSIS
	${prog} [--deps] [--cmake] [--help] [--verbose]

DESCRIPTION
	Compile bpftrace.

ARGUMENT
	-d, --deps              install depends
	-c, --cmake             execute the cmake to generate Makefile
	-i, --install           execute the make install
	-v, --verbose           run with verbose mode
	-h, --help              show this info

LINKS
	https://github.com/bpftrace/bpftrace

SEE ALSO
	bpftrace(8)
"
	exit ${1-0}
}

TEMP_ARGS=$(getopt --options dcivh \
	--long deps \
	--long cmake \
	--long install \
	--long verbose \
	--long help \
	--name ${prog} -- "$@")

test $? != 0 && __usage__ 1

eval set -- "$TEMP_ARGS"

while true; do
	case $1 in
	-d | --deps)
		shift
		flags_deps=YES
		;;
	-c | --cmake)
		shift
		flags_cmake=YES
		;;
	-i | --install)
		shift
		flags_install=YES
		;;
	-v | --verbose)
		shift
		verbose=YES
		;;
	-h | --help)
		shift
		__usage__
		;;
	--)
		shift
		break
		;;
	esac
done

if [[ ${verbose} ]]; then
	export PS4='+${BASH_SOURCE}:${LINENO}:${FUNCNAME[0]}: '
	set -x
fi

if [[ ${flags_deps} ]]; then
	if [[ " debian ubuntu " =~ " ${ID} " ]]; then
		deb_pkgs
		# FIXME: update Debian 12 llvm version here
		cmake_args+=( -DLLVM_REQUESTED_VERSION=19.1.14 )
		cmake_args+=( -DLLVM_DIR=/usr/lib/llvm-19/cmake/ )
	elif [[ " rhel centos fedora " =~ " ${ID} " ]]; then
		rpm_pkgs
	fi
fi

if [[ ${flags_cmake} ]]; then
	cmake \
		-DCMAKE_INSTALL_PREFIX=/usr/ \
		-DCMAKE_BUILD_TYPE=Debug \
		-DBUILD_TESTING=ON \
		${cmake_args[@]} \
		..
fi

# Must execute make command at least
make -j$(nproc)

[[ ${flags_install} ]] && sudo make install

# Check for the clang-format
git clang-format --diff origin/master --extensions cpp,h
