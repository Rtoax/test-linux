#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

struct {
	int a;
};

BEGIN
{
	printf("Tracing xxx, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s\n", "TIME", "PID", "COMM");
}

/* kprobe/kretprobe/kfunc/kretfunc/tracepoint/usdt/uprobe/uretprobe/fentry/fexit/probe/interval, etc. */
interval:s:1
{
	let $a = (uint64)(1 + 9);

	time("%H:%M:%S ");
	printf("%-8d %-16s\n", pid, comm);

	/**
	 * TODO:
	 */
	// TODO
	if (1) {
		while (0) {
			continue;
		}
	} else {
		while (1) {
			break;
		}
	}
}

END
{
	printf("Bye.\n");
}
