#!/bin/env bpftrace

BEGIN
{
	$max = 10;
	$cnt = 0;

	for ($j : ((uint64)0)..((uint64)$max)) {
		printf("cnt %d, j = %d\n", $cnt, $j);
		$cnt += 1;
	}

	$str = comm;
	$strsz = sizeof($str);

	if (comptime is_str($str)) {
		printf("$str = %s is compile time string.\n", $str);
	}
	if (comptime is_array($str)) {
		printf("$str = %s is compile time array.\n", $str);
	}

	$len = 0;
	for ($i : ((uint64)0)..((uint64)$strsz)) {
		printf("%d\n", $i);
		$len += 1;
	}
	printf("strlen(\"%s\") = %d\n", $str, $len);
}
