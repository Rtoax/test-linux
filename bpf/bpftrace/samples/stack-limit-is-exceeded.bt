#!/usr/bin/env bpftrace
/* https://github.com/bpftrace/bpftrace/pull/5094 */
tracepoint:syscalls:sys_exit_openat,
tracepoint:syscalls:sys_exit_openat2
{
  $ret = args.ret;
  $fd = ($ret >= 0) ? $ret : (-1);
  $errno = ($ret >= 0) ? 0 : (-$ret);
  printf("%-6d %-16s %4d %3s\n", pid, comm, $fd, strerror($errno));
  @[strerror($errno)] = count();
  exit();
}
