#!/bin/env bpftrace
#define PACKED __attribute__((packed))
#define ALIGN(n) __attribute__((align(n)))

struct s0 {
	int a;
} /* The comma can be ignored. */

// Could have whitespace
	struct s1 {
	int a;
};

struct PACKED s2 {
	// int
	int i;
	/* char */
	char c;
	struct s1 s1;
	struct ALIGN(8) {
		int sa;
	};
	struct {
		int sb;
	} __attribute__((packed));
	long l;
};

// TODO: support __attribute__ in the end
// see PR https://github.com/bpftrace/bpftrace/pull/5153
struct s3 {
	int i;
	char c;
	int i2;
} __attribute__ ((aligned(1), packed))

union u0 {
	int a;
	int b;
};

union u1 {
	struct {
		int a;
		char c;
		int b;
	} s0 __attribute__((packed));
	struct {
		int a;
		int b;
	} s1 __attribute__((packed));
};

enum e0 {
	a,
	b,
};

BEGIN
{
	$a = (struct s1 *)0;
	printf("offsetof s2 %d\n", offsetof(struct s2, sb));
	printf("sizeof s3 %d\n", sizeof(struct s3));
	printf("sizeof u1 %d\n", sizeof(union u1));
	exit();
}
