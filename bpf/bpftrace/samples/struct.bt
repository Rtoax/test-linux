#!/bin/env bpftrace
#define PACKED __attribute__((packed))
#define ALIGN(n) __attribute__((align(n)))

struct s0 {
	int a;
} /* The comma can be ignored. */

// Could have whitespace
	struct s1 {
	int a;
};

struct PACKED s2 {
	// int
	int i;
	/* char */
	char c;
	struct s1 s1;
	struct ALIGN(8) {
		int sa;
	};
	struct {
		int sb;
	} __attribute__((packed));
	long l;
};

// TODO: support __attribute__ in the end
// see https://github.com/bpftrace/bpftrace/pull/5153
/*
struct s3 {
	int i;
	char c;
} __attribute__((packed))
*/

union u0 {
	int a;
	int b;
};

enum e0 {
	a,
	b,
};

BEGIN
{
	$a = (struct s1 *)0;
	printf("offsetof %d\n", offsetof(struct s2, sb));
	exit();
}
