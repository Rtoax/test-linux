#!/bin/env bpftrace

BEGIN
{
	let $s1 : string[256];
	let $s2 : string[32];

	$s2 = "s2";

	$sz1 = strcap($s1);
	$len1 = strlen($s1);
	$sz2 = strcap($s2);
	$len2 = strlen($s2);

	/**
	 * TODO:
	 * https://github.com/bpftrace/bpftrace/pull/4601
	 * https://github.com/Rtoax/bpftrace/commit/95bf746af7501df777e02919eef39b1033e4c0f1
	 */
	for $i : ((uint64)0)..((uint64)$len2) {
		// ERROR: syntax: invalid assignment target
		// $s1[$len1 + $i] = $s2[$i];
		$s1 = $s2;
		if ($s1[0] != $s1[1]) {}
	}

	printf("%s %s\n", $s1, $s2);
	exit();
}
