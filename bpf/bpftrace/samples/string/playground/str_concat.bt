#!/bin/env bpftrace
// refs:
// - stdlib: support get current working directory
//   https://github.com/bpftrace/bpftrace/pull/5231
// - Warn on low log space in verbose mode
//   https://github.com/bpftrace/bpftrace/pull/5259
//   - avoid to ENOSPC, add BPFTRACE_LOG_SIZE or `config = { log_size = N; }`.

config = {
  log_size = 10000000;
}

macro str_concat($s1, $s2) {
  import "str_concat.bpf.c";

  let $new : string[1024];

  assert_str($s1);
  assert_str($s2);

  let $new_sz = strcap($new);
  let $s1_sz = strcap($s1);
  let $s2_sz = strcap($s2);

  __bpf_str_concat((int8 *)&$new, (uint64)$new_sz, (int8 *)&$s1,
                   (uint64)$s1_sz);
  __bpf_str_concat((int8 *)&$new, (uint64)$new_sz, (int8 *)&$s2,
                   (uint64)$s2_sz);

  $new
}

macro str_concat($s1, s2) {
  let $s2 = s2;
  str_concat($s1, $s2)
}

macro str_concat(s1, $s2) {
  let $s1 = s1;
  str_concat($s1, $s2)
}

macro str_concat(s1, s2) {
  let $s1 = s1;
  let $s2 = s2;
  str_concat($s1, $s2)
}

BEGIN
{
  let $s1 : string[32];
  $s1 = "hello";

  $new = str_concat($s1, " world");
  $new = str_concat($new, " Rong Tao");
  $new = str_concat("INFO: ", $new);

  printf("%s\n", $new);

  $new2 = str_concat("Hello", " World");
  printf("%s\n", $new2);
  exit();
}
