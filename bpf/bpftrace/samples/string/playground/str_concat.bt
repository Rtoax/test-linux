#!/bin/env bpftrace
// see https://github.com/bpftrace/bpftrace/pull/5231
/*
Q: Why run in verbose mode (-v), load failed.
A: Need bigger log buffer, see bpf_check():
        if (log->level && bpf_verifier_log_full(log))
            ret = -ENOSPC;

   Error:

     $ ./str_concat.bt # works fine
     $ ./str_concat.bt -v
     ...
     ERROR: Error loading BPF program for begin_1. Error code: -28.
     Kernel error log:
     processed 87034 insns (limit 1000000) max_states_per_insn 4 total_states 2811 peak_states 136 mark_read 31

   test-linux/bpf/scripts/sys_enter_bpf.bt track bpf(2) BPF_PROG_LOAD return -28.
   bpf_check() return -28.
   ps: -28 is ENOSPC (No space left on device)
   more to see commit 73a01d16426d ("bpf: bpf_check() return ENOSPC in verbose mode if log buf full")
*/

macro str_concat($s1, $s2) {
  import "stdlib/strings/strings.bpf.c";
  import "str_concat.bpf.c";

  let $new : string[1024];

  assert_str($s1);
  assert_str($s2);

  let $new_sz = strcap($new);
  let $s1_sz = strcap($s1);
  let $s2_sz = strcap($s2);

  __bpf_str_concat((int8 *)&$new, (uint64)$new_sz, (int8 *)&$s1,
                   (uint64)$s1_sz);
  __bpf_str_concat((int8 *)&$new, (uint64)$new_sz, (int8 *)&$s2,
                   (uint64)$s2_sz);

  $new
}

macro str_concat($s1, s2) {
  let $s2 = s2;
  str_concat($s1, $s2)
}

macro str_concat(s1, $s2) {
  let $s1 = s1;
  str_concat($s1, $s2)
}

macro str_concat(s1, s2) {
  let $s1 = s1;
  let $s2 = s2;
  str_concat($s1, $s2)
}

BEGIN
{
  let $s1 : string[32];
  $s1 = "hello";

  $new = str_concat($s1, " world");
  $new = str_concat($new, " Rong Tao");
  $new = str_concat("INFO: ", $new);

  printf("%s\n", $new);

  $new2 = str_concat("Hello", " World");
  printf("%s\n", $new2);
  exit();
}
