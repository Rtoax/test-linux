#!/bin/env bpftrace

macro test_base()
{
	let $s1 : string[64];
	$s1 = "a";
	print($s1);
}

macro test_size()
{
	/**
	 * MUST be 256, see bpftrace::src/ast/irbuilderbpf.cpp::
	 *  IRBuilderBPF::CreateAllocaBPF() {
	 *    // Anything this large should be allocated in a scratch map instead
	 *    assert(module_.getDataLayout().getTypeAllocSize(ty) <= 256);
	 *  }
	 */
	let $s1 : string[256];
	let $s2 : string[32];

	$s1 = "hello";
	$s2 = "world";
	$s1 = $s2;

	print($s1);
}

let @map_str = lruhash(4096);

macro test_map(@map)
{
	let $s : string[256];
	$s = "$s";
	@map[0] = "0";
	@map[1] = "01";
	@map[2] = "012";
	@map[3] = comm;
	@map[4] = $s;

	/* strcap() of @map is max length of it's item */
	print(strcap(@map[0]));
}

BEGIN
{
	test_base();
	test_size();
	test_map(@map_str);

	exit();
}

END
{
	clear(@map_str);
}
