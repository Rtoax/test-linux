#!/bin/env bpftrace

/**
 * ref: https://github.com/bpftrace/bpftrace/issues/782
 * ref: commit d4acdce4bf0e ("{pthread/create.c,clone(2),fork.c}: Recursive creation")
 */
macro xpcomm(task)
{
  if (pid == tid) {
    task.real_parent.comm
  } else {
    task.group_leader.comm
  }
}

macro xpcomm()
{
  xpcomm(curtask)
}

BEGIN
{
  printf("%s %s\n", xpcomm, comm);
  exit();
}
