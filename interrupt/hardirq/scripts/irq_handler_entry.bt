#!/usr/bin/env bpftrace
/**
 *
 * see also
 * 1. bcc/tools/hardirqs.py
 * 2. bcc/libbpf-tools/hardirqs
 */
BEGIN
{
	printf("Tracing interrupts, hit ctrl-C to end.\n");
}

tracepoint:irq:irq_handler_entry
{
	$irq = args->irq;
	$name = args->name;
	@interrupts[$irq, str($name)] = count();

	@start[pid] = nsecs;
	@name[pid] = str($name);
}

tracepoint:irq:irq_handler_exit
/ @start[pid] /
{
	@total_usecs[@name[pid]] = hist((nsecs - @start[pid]) / 1000);
	delete(@name[pid]);
	delete(@start[pid]);
}

END
{
	clear(@start);
	clear(@name);
}
