#!/bin/env bpftrace
/**
 * tcg-tb.bt - Tracing Translation Block alloc/remove/insert/lookup
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2024-05-14	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing Qemu TCG TB, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-32s %-8s\n", "TIME", "PID", "COMM", "PROBE");
}

uprobe:/usr/bin/qemu-system-*:tcg_tb_
{
	time("%H:%M:%S ");
	printf("%-8d %-32s %s\n", pid, comm, probe);
}

END
{
	printf("Bye.\n");
}
