 */
BEGIN
{
	printf("Tracing Qemu TCG Gen code, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-32s %-8s\n", "TIME", "PID", "COMM", "PROBE");
}

uprobe:/usr/bin/qemu-system-*:gen_intermediate_code
{
	time("%H:%M:%S ");
	printf("%-8d %-32s %s\n", pid, comm, probe);
}

END
{
	printf("Bye.\n");
}
