#!/bin/env bpftrace
/**
 * tcg-init.bt - description
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2024-05-14	Rong Tao	Create this.
 */
BEGIN
{
	printf("Tracing Qemu TCG Init, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-32s %-8s\n", "TIME", "PID", "COMM", "PROBE");
}

uprobe:/usr/bin/qemu-system-*:tcg_init,
uprobe:/usr/bin/qemu-system-*:tcg_context_init,
uprobe:/usr/bin/qemu-system-*:tcg_target_init,
uprobe:/usr/bin/qemu-system-*:tcg_prologue_init
{
	time("%H:%M:%S ");
	printf("%-8d %-32s %s\n", pid, comm, probe);
}

END
{
	printf("Bye.\n");
}
