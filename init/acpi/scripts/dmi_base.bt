struct phys_addr_t {
	unsigned long addr;
};

BEGIN
{
	$addr = (struct phys_addr_t *)kaddr("dmi_base");
	printf("0x%lx, addr: 0x%lx\n", kaddr("dmi_base"), $addr->addr);
	exit();
}
