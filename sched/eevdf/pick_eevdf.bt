#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing EEVDF, hit ctrl-c to end.\n");
}

kprobe:__pick_eevdf
{
	@[kstack] = count();
}

END
{
	printf("Bye.\n");
}
