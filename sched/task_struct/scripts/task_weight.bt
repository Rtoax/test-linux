#!/bin/env bpftrace
/**
 * File: weight.bt
 * Author: Rong Tao <rtoax@foxmail.com>
 * Date: 2022.06.06
 *
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Profile task weight, hit ctrl-c to end.\n");
}

profile:hz:99
{
	$task = (struct task_struct *)curtask;
	$weight = $task->se.load.weight;

	@W[$weight] = count();
	@C[$task->comm] = count();
}

END
{
	print(@C, 10);
	clear(@C);
}
