#!/usr/bin/env bpftrace
/**
 * File: try_to_wake_up.bt
 * Author: Rong Tao <rongtao@cestc.cn>
 * Date: 2022.05.25
 *
 * TTWU: try_to_wake_up
 *
 * 2022-07-12	Rong Tao	Just print 10st count COMM, add 'kstack'
 */
#include <linux/sched.h>

BEGIN
{
	printf("Tracing try_to_wake_up(TTWU), hit ctrl-c to end.\n");
}

kprobe:try_to_wake_up
{
	$task = (struct task_struct *)arg0;
	@count_comm[$task->comm] = count();
	@stack[kstack] = count();
}

END
{
	print(@count_comm, 20);
	print(@stack, 1);
	clear(@count_comm);
	clear(@stack);
}
