#!/usr/bin/env bpftrace
/**
 * File: try_to_wake_up.bt
 * Author: Rong Tao <rongtao@cestc.cn>
 * Date: 2022.05.25
 *
 * TTWU: try_to_wake_up
 */
#include <linux/sched.h>

BEGIN
{
	printf("Tracing try_to_wake_up(TTWU), hit ctrl-c to end.\n");
}

kprobe:try_to_wake_up
{
	$task = (struct task_struct *)arg0;
	@[$task->comm] = count();
}

END
{
}
