#!/usr/bin/env bpftrace
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing sched_waking and sched_wakeup, hit ctrl-c to end.\n");
}

tracepoint:sched:sched_waking
{
	$pid = args->pid;
	@start[$pid] = nsecs;
}

tracepoint:sched:sched_wakeup
{
	$pid = args->pid;
	if (@start[$pid]) {
		@latency_usecs[comm] = hist((nsecs - @start[$pid]) / 1000);
		delete(@start[$pid]);
	}
}

END
{
	clear(@start);
}
