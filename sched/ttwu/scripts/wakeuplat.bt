#!/usr/bin/env bpftrace
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing sched_waking and sched_wakeup, hit ctrl-c to end.\n");
}

tracepoint:sched:sched_waking
{
	$pid = args->pid;
	@start[$pid] = nsecs;
	@count = count();
}

tracepoint:sched:sched_wakeup
/ @start[tid] /
{
	$pid = args->pid;
	@latency_us = hist((nsecs - @start[$pid]) / 1000);
	delete(@start[$pid]);
}

i:s:1
{
	print(@count);
	clear(@count);
}

END
{
	clear(@start);
	clear(@count);
}
