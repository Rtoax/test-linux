#!/bin/env bpftrace
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing task cpu migration, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s %-8s\n",
		"TIME", "PID", "COMM", "FROM", "TO");
}

tracepoint:sched:sched_migrate_task
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8d %-8d\n",
		pid, args.comm, args.orig_cpu, args.dest_cpu);
}

END
{
	printf("Bye.\n");
}
