#!/bin/env bpftrace
/**
 * move_queued_task.bt - Tracing migration/[core] task migration
 *
 * The follow command could trigger migration on x86_64:
 *
 *     $ while :; do ls >/dev/null; done
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2023-10-16	Rong Tao	Create this.
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing task migration, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-16s to %-8s\n",
		"TIME", "PID", "Migration", "TASK", "CPU");
}

kprobe:move_queued_task
{
	$p = (struct task_struct *)arg2;
	$new_cpu = arg3;

	time("%H:%M:%S ");
	printf("%-8d %-16s %-16s -> %-8d\n",
		pid, curtask->comm, $p->comm, $new_cpu);
	@stack[kstack] = count();
}

/* execve() is a valuable balancing opportunity */
kprobe:sched_exec
{
	@cnt_sched_exec = count();
}

/* NUMA balance relate migration */
kprobe:migrate_task_to
{
	@cnt_numa_migrate = count();
}

END
{
	printf("Bye.\n");
}
