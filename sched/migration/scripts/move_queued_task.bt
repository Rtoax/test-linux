#!/bin/env bpftrace
/**
 * move_queued_task.bt - Tracing migration/[core] task migration
 *
 * Copyright (C) Rong Tao 2022-2023
 *
 * 2023-10-16	Rong Tao	Create this.
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing task migration, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-16s to %-8s\n",
		"TIME", "PID", "Migration", "TASK", "CPU");
}

kfunc:move_queued_task
{
	time("%H:%M:%S ");
	printf("%-8d %-16s %-16s -> %-8d\n",
		pid, curtask->comm, args->p->comm, args->new_cpu);
}

END
{
	printf("Bye.\n");
}
