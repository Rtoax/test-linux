#!/bin/env bpftrace
/**
 * stopped.bt - Tracing SIGSTOP
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2023-10-10	Rong Tao	Create this.
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif
#include <linux/signal.h>

BEGIN
{
	@sig_str[SIGSTOP] = "STOP";
	@sig_str[SIGCONT] = "CONT";
	printf("Tracing SIGSTOP, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-8s %-8s\n",
		"TIME", "PID", "COMM", "KILLHIM", "SIGNAL");
}

tracepoint:syscalls:sys_enter_kill,
tracepoint:syscalls:sys_enter_tkill,
tracepoint:syscalls:sys_enter_tgkill
{
	$pid = args->pid;
	$sig = args->sig;

	if ($sig == SIGSTOP || $sig == SIGCONT) {
		time("%H:%M:%S ");
		printf("%-8d %-16s %-8d %-8s\n", pid, comm, $pid, @sig_str[$sig]);
	}
}

END
{
	clear(@sig_str);
	printf("Bye.\n");
}
