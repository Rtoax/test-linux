#!/usr/bin/env bpftrace
/**
 * sched_type.bt - Tracing schedule type
 *
 * Copyright (C) Rong Tao
 *
 * 2022-10-22	Rong Tao	Create this
 */
#include <linux/sched.h>

kprobe:schedule,
kprobe:scheduler_tick,
kprobe:hrtick,
kprobe:wake_up_process
{
	@stack[kstack] = count();
	@probe_cnt[probe] = count();
}

i:s:1
{
	print(@probe_cnt);
}

