#!/bin/env bpftrace
/**
 * reschedule.bt - Tracing Rescheduling interrupts
 *
 * Copyright (C) Rong Tao 2022-2025
 *
 * 2023-09-23	Rong Tao	Create this.
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/sched.h>
#endif

BEGIN
{
	printf("Tracing Rescheduling, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-8s\n", "TIME", "PID", "COMM");
}

tracepoint:irq_vectors:reschedule_entry
{
	@start[tid] = nsecs;
}

tracepoint:irq_vectors:reschedule_exit
/ @start[tid] /
{
	$diff_ns = nsecs - @start[tid];
	delete(@start[tid]);

	@latency_hist_ns = hist($diff_ns);

	time("%H:%M:%S ");
	printf("%-8d %-8s\n", pid, comm);
}

END
{
	clear(@start);
	printf("Bye.\n");
}
