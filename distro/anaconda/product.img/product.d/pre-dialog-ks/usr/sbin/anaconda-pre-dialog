#!/bin/bash
# This is dialog __main__ file for anaconda-pre-dialog.service
#
# Copyright (C) 2022-2026 Rong Tao
#

# change foreground terminal to ttyN, this number _MUST_ same as
# 'After=getty@tty9.service' in anaconda-pre-dialog.service.
# Actually, anaconda use tty1-tty6 for Ctrl+Alt+{F1-F6}, tty9 used
# here, It is possible to switch to tty9 with Ctrl+Alt+F9
chvt 9

DIALOG_ROOT=$(dirname `realpath $0`)
SYS_ROOT=${DIALOG_ROOT}/../../
# Use default dialog config
# export DIALOGRC=${SYS_ROOT}/usr/sbin/.dialogrc

# Pre-dialog-ks supports adding custom addon module functionality, similar
# to the dracut module. Each module is a separate folder, like dracut,
# containing module-setup.sh script files, which need to contain two functions,
# depends() and install().
# Folder naming format [0-9][0-9]*, priority 00>99.
DIALOG_MODULES_ROOT=${SYS_ROOT}/usr/lib/pre-dialog-ks/modules.d/

# This environment variable is usually used for testing, and normally,
# the product information should be obtained from the /.buildstamp file.
export BUILDSTAMP_PRODUCT

# See ostools/anaconda/product.d/pre-dialog-ks/run/install/
KS_ROOT=${SYS_ROOT}/run/install/
KS_MAIN=${KS_ROOT}/ks.cfg
KS_NETWORK=${KS_ROOT}/network.ks
KS_REPOS=${KS_ROOT}/repos.ks
KS_PACKAGES=${KS_ROOT}/packages.ks
KS_USER=${KS_ROOT}/user.ks
KS_PARTITION=${KS_ROOT}/partition.ks

# It should be considered that some products will preset the kickstart
# configuration file, in this case, anaconda-pre-dialog should not override
# this kickstart, this Magic is used to determine whether kickstart is
# generated by anaconda-pre-dialog. The kickstart header generated by
# anaconda-pre-dialog has this comment.
KS_HDR_MAGIC="This kickstart was generated by anaconda-pre-dialog."

# dialog return status
: ${DIALOG_OK=0}
: ${DIALOG_CANCEL=1}
: ${DIALOG_HELP=2}
: ${DIALOG_EXTRA=3}
: ${DIALOG_ITEM_HELP=4}
: ${DIALOG_ESC=255}

. ${DIALOG_ROOT}/anaconda-pre-dialog-libs.sh

# Dialog Contant
backtitle="$(buildstamp_product) Installer"

# Main MENU items
MENU_SELECT_TARGET_DISK="Select Target Disk"
MENU_NETWORK_CONFIG="Network Config"
MENU_ADDUSER='Create User'
MENU_DISPLAT_DISK='Display Disk Space'
MENU_SAVE_AND_CONTINUE='Save and Continue'
MENU_DISPLAT_INFO='Display Information'
MENU_DISPLAT_CMDLINE='Display Command Line'
MENU_DISPLAT_NETWORK_IFACE='Display Network Interface'
MENU_DISPLAT_USERS='Display Users'

# Default: disable create user menu
has_menu_adduser=
# Default: disable network config
has_menu_network_config=

height=0
width=0
menu_height=15
# Full screen
full_screen_height=$(stty size | awk '{print $1}')
full_screen_width=$(stty size | awk '{print $2}')
#  Borders on the four sides
full_screen_height=$[ $full_screen_height - 10 ]
full_screen_width=$[ $full_screen_width - 10 ]

# For kickstart 'user'
admin_username=ccadmin
admin_password=
user_name=()
user_password=()

# Network
net_hostname=$(buildstamp_product | tr '[A-Z]' '[a-z]')
net_ip_address=10.253.0.7
net_netmask=255.255.254.0
net_gateway=10.253.0.254

# Disk
target_disk=
smallest_disk=$(get_smallest_disk)

# When switching TTY during the installation process (switching from TTY1
# to TTY9), the printed information of TTY1 may remain on TTY9, so clean
# the screen output here to prevent the screen output from being dialogged.
clear
trap clear EXIT
# Ignore SIGINT SIGQUIT SIGTSTP. In the interactive dialog interface,
# some keyboard signals should be ignored
trap "" INT QUIT TSTP

############################################
## Select target disk
############################################
__target_disk__()
{
	local ret_status
	local disks=( $(lsblk -l -p -o name,type | grep disk | grep "^/dev" | awk '{print $1}') )
	local sizes=( $(lsblk -l -p -o name,size,type | grep disk | grep "^/dev" | awk '{print $2}') )

	local selection
	local items=()

	# Filter out some impossible Disk
	local nr_disks=${#disks[@]}
	for ((i = 0; i < ${nr_disks}; i++ ))
	do
		local name=${disks[$i]}

		# No need:
		# - /dev/zram[0-9]*
		# - /dev/mapper/[a-z0-9_-]*
		# - /dev/loop[0-9]*
		if [[ ! -z "$(echo $name | grep "\/dev\/zram" || true )" ]] || \
			[[ ! -z "$(echo $name | grep "\/dev\/mapper" || true )" ]] || \
			[[ ! -z "$(echo $name | grep "\/dev\/loop" || true )" ]]
		then
			unset disks[$i]
			unset sizes[$i]
		fi
	done

	# Update array, unset make disks[$i]=''
	disks=( ${disks[@]} )
	sizes=( ${sizes[@]} )

	# Make item
	for ((i = 0; i < ${#disks[@]}; i++ ))
	do
		local select_status="status"

		# Indicate which entry is currently selected, by setting its
		# status to on. If we have selected a disk, when we enter the
		# selection menu again, the smallest disk should no longer be
		# displayed, but the selected disk should be selected.
		if [[ ! -z ${target_disk} ]]; then
			if [[ $(basename ${disks[$i]}) == ${target_disk} ]]; then
				select_status=on
			fi
		elif [[ $(basename ${disks[$i]}) == ${smallest_disk} ]]; then
			select_status=on
		fi

		items+=( "${disks[$i]} ${sizes[$i]} ${select_status}" )
	done

	exec 3>&1
	selection=$(dialog \
		--backtitle "${backtitle}" \
		--title "${MENU_SELECT_TARGET_DISK}" \
		--radiolist \
"Please select a target disk from the \n
following block devices for installing \n
the system, please note that after \n
selection, the original files on the \n
disk will be overwritten. \n
 \n
If you're not sure which one to choose, \n
go back to the menu and use [${MENU_DISPLAT_DISK}] \n
to view. \n
 \n
Press [space] to select:" \
		${height} ${width} 10 \
		${items[@]} \
		2>&1 1>&3)

	# Error happened
	ret_status=$?
	exec 3>&-
	case $ret_status in
	$DIALOG_CANCEL)
		selection=
		echo "Select target disk terminated."
		return 0
		;;
	$DIALOG_ESC)
		selection=
		echo "Select target disk aborted." >&2
		return 0
		;;
	esac

	# Select nothing
	if [[ -z ${selection} ]]; then
		result=\
"Do not select any disk, use Smallest one instead."
		display_result "WARNING"
		result=
		selection=
		return 0
	fi

	# Ensure and Go on
	exec 3>&1
	dialog \
		--backtitle "${backtitle}" \
		--title "Selected disk: ${selection}" \
		--yesno \
"You have selected Disk ${selection}, \n
whether to continue with the configuration." \
		${height} ${width} \
		2>&1 1>&3

	# Error happened
	ret_status=$?
	exec 3>&-
	case $ret_status in
	$DIALOG_OK)
		# /dev/sda -> sda
		target_disk=$(basename ${selection})
		return 0
		;;
	$DIALOG_CANCEL)
		selection=
		echo "terminated."
		return 1
		;;
	esac
}

############################################
## Network Config
############################################
__network_config__()
{
	local returncode=0
	local returntext

	local hostname=${net_hostname}
	local ip_address=${net_ip_address}
	local netmask=${net_netmask}
	local gateway=${net_gateway}


	while test $returncode != 1 && test $returncode != 250
	do
		exec 3>&1
		returntext=$(dialog \
			--backtitle "$backtitle" \
			--title "${MENU_NETWORK_CONFIG}" \
			--insecure \
			--mixedform " \n
 Network config. \n
 \n
 How to do it:\n
   [Tab]  Submit \n
 [Enter]  Confirm and exit \n
    [Up]  Move the input box up \n
  [Down]  Move the input box down \n
 \n" \
			${height} ${width} 0 \
			"IP Address : " 1 1	"${ip_address}"  1 15  16 0 0 \
			"   Netmask : " 2 1	"${netmask}"  2 15  16 0 0 \
			"   Gateway : " 3 1	"${gateway}"  3 15  16 0 0 \
			"  Hostname : " 4 1	"${hostname}"  4 15  32 0 0 \
			2>&1 1>&3)
		returncode=$?
		exec 3>&-

		case $returncode in
		$DIALOG_OK)
			# Temp file store ip address
			local result_file=$(mktemp tmp-XXXXXX)
			echo "$returntext" > $result_file

			ip_address=$(cat $result_file | sed -n 1p)
			netmask=$(cat $result_file | sed -n 2p)
			gateway=$(cat $result_file | sed -n 3p)
			hostname=$(cat $result_file | sed -n 4p)

			# Remove temp file
			rm -f $result_file

			# Check ip address format
			local error_happen=""
			for ip in ${ip_address} ${netmask} ${gateway}
			do
				if [[ $(check_ipv4_address $ip) != OK ]]; then
					result="Illegal ipv4 address: ${ip}"
					display_result "ERROR"
					result=
					error_happen=YES
					break
				fi
			done
			if [[ -z ${hostname} ]]; then
				result="Illegal hostname: ${hostname}"
				display_result "ERROR"
				result=
				error_happen=YES
			fi

			[[ ! -z ${error_happen} ]] && continue

			# Success
			net_hostname=${hostname}
			net_ip_address=${ip_address}
			net_netmask=${netmask}
			net_gateway=${gateway}

			result="\n
 Network Config \n
 \n
   Hostname:  ${net_hostname} \n
 IP Address:  ${net_ip_address} \n
    Netmask:  ${net_netmask} \n
    Gateway:  ${net_gateway} \n
 \n"
			display_result "${MENU_NETWORK_CONFIG} Success"
			result=

			return 0
			;;
		$DIALOG_CANCEL)
			return 0
			;;
		*)
			continue
			;;
		esac
	done
}

############################################
## Create User
############################################
echo_users()
{
	echo "Admin user: ${admin_username} \n"

	[[ ! -z ${user_name} ]] && \
	echo "Other user: ${user_name[@]}"
}

declare result_username
declare result_password

# Resule store in result_username,result_password
#
# --title        set dialog title
# -n,--name      specify username, if empty, create new user
# --no-cancel    Forbidden cancel, must success
get_password_form()
{
	TEMP=$(getopt \
		--options n: \
		--long title: \
		--long name: \
		--long no-cancel \
		-n get_password_form -- "$@")

	test $? != 0 && (
		result="Wrong exec getopt"
		display_result "MAIN dialog Program fatal"
		result=
		return 0
	)

	eval set -- "$TEMP"

	local username orig_username no_cancel flag_create
	local title="Set User"

	while true; do
		case $1 in
		--title)
			shift
			title="$1"
			shift
			;;
		-n | --name)
			shift
			username=$1
			shift
			;;
		--no-cancel)
			shift
			no_cancel=YES
			;;
		--)
			shift
			break
			;;
		esac
	done

	[[ -z $username ]] && flag_create=TRUE

	local returncode=0
	local returntext=
	result_username="${username}"
	orig_username="${username}"

	local username_spec="support 'a-zA-Z0-9_', start with 'a-zA-Z_'"

	while test $returncode != 1 && test $returncode != 250
	do
		exec 3>&1
		returntext=$(dialog \
			--ok-label "Submit" \
			--backtitle "$backtitle" \
			--title "$title" \
			${no_cancel:+--no-cancel} \
			--insecure \
			--mixedform " \n
 Set/create a new user${username:+ \"$username\"} and set password. \n
 If you are in the Settings Admin user window, you \n
 can rename the Admin username here. \n
 \n
 Username ${username_spec} \n
 \n
 Created users: \n
$(echo_users | sed 's/^/ - /g') \n
 \n
 How to do it:\n
   [Tab]  Submit \n
 [Enter]  Confirm and exit \n
    [Up]  Move the input box up \n
  [Down]  Move the input box down \n" \
			${height} ${width} 0 \
			"Username:" 1 1	"$username"   1 10  40 0 0 \
			"Password:" 2 1	""  2 10  40 0 1 \
			"  Verify:" 3 1	""  3 10  40 0 1 \
			2>&1 1>&3)
		returncode=$?
		exec 3>&-

		case $returncode in
		$DIALOG_OK)
			# Make temp file store result text
			local result_file=$(mktemp tmp-XXXXXX)
			echo "$returntext" > $result_file

			local nr_words=$(echo $returntext | awk '{print NF}')
			local tmp_username=$(cat $result_file | sed -n 1p)
			local tmp_password1=$(cat $result_file | sed -n 2p)
			local tmp_password2=$(cat $result_file | sed -n 3p)

			# Remove temp file
			rm -f $result_file

			if [[ $nr_words -gt 3 ]]; then
				result="Forbidden space character in password"
				display_result "ERROR"
				result=
				continue
			fi

			############################################
			## Check username
			############################################
			username=$tmp_username

			if [[ -z "$(echo "${username}" | grep "^[a-zA-Z_][a-zA-Z0-9_]*$" || true)" ]]
			then
				result=" \n
User name contains illegal characters, \n
${username_spec} \n"
				display_result "WARNING"
				result=
				username="${orig_username}"
				continue
			fi

			if [[ -z $username ]]; then
				result="Empty user name.\n"
				display_result "WARNING"
				result=
				continue
			fi

			# If create new user, we should check username exist or not.
			if [[ ! -z $flag_create ]]; then
				# Conflict with Admin
				if [[ "${username}" == "${admin_username}" ]]; then
					result=\
"User name '$username' conflict with Admin. \n
return directly.\n"
					display_result "WARNING"
					result=
					return 0
				fi
				# Conflict with ordinary user
				for ((iu = 0; iu < ${#user_name[@]}; iu++ ))
				do
					# Username already exist
					if [[ $username == ${user_name[$iu]} ]]; then
						result=\
"User name '$username' already exist. \n
return directly.\n"
						display_result "WARNING"
						result=
						return 0
					fi
				done
			fi

			############################################
			## password = password_ensure ?
			############################################
			if [[ -z "${tmp_password1}" ]] || [[ -z "${tmp_password2}" ]]; then
				result=\
"Input Password string for ${tmp_username} is empty."
				display_result "ERROR"
				result=

				continue
			elif [[ "$tmp_password1" != "$tmp_password2" ]]; then
				result=\
"If the password entered twice is \n
different, the creation of the user \n
will be interrupted this time, and \n
if you need to create a user, please \n
recreate it."
				display_result "ERROR"
				result=

				continue
			elif [[ $(has_space "${tmp_password1}") != 1 ]] || \
				[[ $(has_space "${tmp_password2}") != 1 ]]
			then
				result="Forbidden space character in password."
				display_result "ERROR"
				result=

				continue
			fi

			result_username="${tmp_username}"
			result_password="${tmp_password1}"
			return 0
			;;
		$DIALOG_CANCEL)
			result_username=
			result_password=
			if [[ ! -z "$no_cancel" ]]; then
				continue
			else
				return 0
			fi
			;;
		*)
			continue
			;;
		esac
	done
}

# Set admin username and password
set_admin_user()
{
	[[ ! -z ${admin_password} ]] && return 0

	result_username=
	result_password=

	get_password_form \
		--title "Set Admin User" \
		--name "${admin_username}" \
		--no-cancel

	admin_username="$result_username"
	admin_password="$result_password"
}

__create_user__()
{
	local ret_status username password

	############################################
	## Get password
	############################################
	get_password_form --title "Create New User"
	username=${result_username}
	password=${result_password}
	result_password=
	result_username=
	if [[ -z $username ]] || \
		[[ -z $password ]]; then
		# No need WARNING again, direct return 0
		return 0
	fi

	# Username already exist
	for ((i = 0; i < ${#user_name[@]}; i++ ))
	do
		if [[ $username == ${user_name[$i]} ]]; then
			result=\
"User name '$username' already exist. \n
return directly.\n"
			display_result "WARNING"
			result=
			return 0
		fi
	done

	############################################
	## Create user
	############################################
	exec 3>&1
	dialog \
		--backtitle "${backtitle}" \
		--title "Are you sure?" \
		--yesno \
"You are about to create User '${username}', \n
please double-check that the user will \n
appear on the installation destination \n
system." \
		${height} ${width} \
		2>&1 1>&3

	# Error happened
	ret_status=$?
	exec 3>&-
	case $ret_status in
	$DIALOG_CANCEL)
		echo "Ensure create user terminated."
		return 0
		;;
	$DIALOG_ESC)
		echo "Ensure Create User aborted." >&2
		return 0
		;;
	esac

	user_name+=( "$username" )
	user_password+=( "$password" )
}

############################################
## Save and Continue
############################################
__save_continue__()
{
	local ret_status

	# Make sure admin has correct password setting
	set_admin_user

	exec 3>&1
	dialog \
		--backtitle "${backtitle}" \
		--title "${MENU_SAVE_AND_CONTINUE}" \
		--yesno \
"If you click YES, a kickstart profile \n
will be generated and the installation \n
will begin, and if you click NO, you \n
will be returned to the main menu. \n
 \n
Save and Continue? \n
 \n
[Yes] - start install \n
[No]  - go back to menu" \
		${height} ${width} \
		2>&1 1>&3

	# Error happened
	ret_status=$?
	exec 3>&-
	case $ret_status in
	$DIALOG_OK)
		return 0
		;;
	$DIALOG_CANCEL)
		echo "terminated."
		return 1
		;;
	esac
}

############################################
## Display Functions
############################################
__display_disk__()
{
	result=$(df -h)
	display_result "Display disk"
	result=$(lsblk -l -p -o name,rm,ro,hotplug,size,type,serial,mountpoint)
	display_result "Display block"
	result=
}

__display_users__()
{
	result=$(echo_users)
	display_result "Display Users"
	result=
}

__display_cmdline__()
{
	result=$(get_cmdline)
	display_result "CMDLINE"
	result=
}

__display_network_iface__()
{
	result=$(ip a)
	display_result "Network Interface"
	result=
}

############################################
## Display Information Menu
############################################
__display_menu_select__()
{
	local selection ret_status

	# Main loop
	while :;
	do
		exec 3>&1
		selection=$(dialog \
			--backtitle "${backtitle}" \
			--title "Display" \
			--clear \
			--menu "\
$(buildstamp_product) Information Menu \n
\n
[Cancel] return" \
			${height} ${width} ${menu_height} \
			"${MENU_DISPLAT_CMDLINE}" "Show cmdline" \
			"${MENU_DISPLAT_NETWORK_IFACE}" "Show network interface" \
			"${MENU_DISPLAT_USERS}" "Show users" \
			"${MENU_DISPLAT_DISK}" "Show disk" \
			2>&1 1>&3)

		# Error happened
		ret_status=$?
		exec 3>&-
		case $ret_status in
		$DIALOG_CANCEL | $DIALOG_ESC)
			echo "Program terminated." >&2
			break
			;;
		esac

		# Handle selection
		case ${selection} in
		$MENU_DISPLAT_CMDLINE)
			__display_cmdline__
			;;
		$MENU_DISPLAT_NETWORK_IFACE)
			__display_network_iface__
			;;
		$MENU_DISPLAT_USERS)
			__display_users__
			;;
		$MENU_DISPLAT_DISK)
			__display_disk__
			;;
		esac

		result=""
	done
}

############################################
## Main Menu
############################################
__menu_select__()
{
	local selection ret_status

	local _menu_extras

	if [[ ! -z $has_menu_network_config ]]; then
		_menu_extras+=( "${MENU_NETWORK_CONFIG}" )
		_menu_extras+=( "" )
	fi
	if [[ ! -z $has_menu_adduser ]]; then
		_menu_extras+=( "${MENU_ADDUSER}" )
		_menu_extras+=( "Default: ${admin_username}" )
	fi

	# Main loop
	while :;
	do
		exec 3>&1
		selection=$(dialog \
			--backtitle "${backtitle}" \
			--title "Main Menu" \
			--default-item "${MENU_SAVE_AND_CONTINUE}" \
			--clear \
			--cancel-label "Exit" \
			--menu "$(buildstamp_product) Installer Menu" \
			${height} ${width} ${menu_height} \
			"${MENU_SELECT_TARGET_DISK}" 'Default: Smallest one' \
			"${_menu_extras[@]}" \
			"${MENU_DISPLAT_DISK}" '' \
			"${MENU_DISPLAT_INFO}" '' \
			"${MENU_SAVE_AND_CONTINUE}" '' \
			2>&1 1>&3)

		# Error happened
		ret_status=$?
		exec 3>&-
		case $ret_status in
		$DIALOG_CANCEL | $DIALOG_ESC)
			clear
			# We can't 'exit' anyway, and we MUST be sure Admin password be
			# setted.
			set_admin_user
			echo "Program terminated." >&2
			break
			;;
		esac

		# Handle selection
		case ${selection} in
		$MENU_SAVE_AND_CONTINUE)
			__save_continue__
			case $? in
			# Success, save and continue
			0)
				break
				;;
			# Back to main menu
			*)
				continue
				;;
			esac
			;;
		$MENU_SELECT_TARGET_DISK)
			__target_disk__
			;;
		$MENU_NETWORK_CONFIG)
			__network_config__
			;;
		$MENU_ADDUSER)
			__create_user__
			;;
		$MENU_DISPLAT_DISK)
			__display_disk__
			;;
		$MENU_DISPLAT_INFO)
			__display_menu_select__
			;;
		esac

		result=""
	done
}

is_my_ks()
{
	local _ks=$1
	grep "${KS_HDR_MAGIC}" ${_ks} 2>/dev/null
}

generate_network_ks()
{
	# FIXME: DHCP ad default
	kickstart_network \
		--kickstart ${KS_NETWORK} \
		--hostname $(buildstamp_product | tr '[A-Z]' '[a-z]') \
		--bootproto-dhcp
}

generate_repos_ks()
{
	# TODO: Add DNF repo with kickstart_repo()
	cat > ${KS_REPOS} <<-END
# ${KS_HDR_MAGIC}
# DNF Repos
END
}

generate_packages_ks()
{
	# Packages installation from kickstart
	kickstart_packages \
		--kickstart ${KS_PACKAGES}
}

generate_partition_ks()
{
	cat > ${KS_PARTITION} <<-END
# ${KS_HDR_MAGIC}
# Partition
END
	kickstart_partition \
		--kickstart ${KS_PARTITION} \
		--target-disk ${target_disk}
}

# This function will generate a series of kickstart files, which will be
# included in the /run/install/ks.cfg.
#
# If Kickstart is generated by anaconda-pre-dialog, then it will be
# regenerated(overwritten if exist), and if not, then directly use the
# currently existing Kickstart(may product has own kickstart),
# anaconda-pre-dialog may require some replacement work, such as the
# destination disk.
generate_kickstart()
{
	# Network
	if [[ -e ${KS_NETWORK} ]]; then
		if [[ ! -z "$(is_my_ks ${KS_NETWORK})" ]]; then
			# Overwrite exist one
			generate_network_ks
		fi
		# Skip if product custom
	else
		generate_network_ks
	fi

	# DNF Repo
	if [[ -e ${KS_REPOS} ]]; then
		if [[ ! -z "$(is_my_ks ${KS_REPOS})" ]]; then
			# Overwrite exist one
			generate_repos_ks
		fi
		# Skip if product custom
	else
		generate_repos_ks
	fi

	# Packages/Groups
	if [[ -e ${KS_PACKAGES} ]]; then
		if [[ ! -z "$(is_my_ks ${KS_PACKAGES})" ]]; then
			# Overwrite exist one
			generate_packages_ks
		fi
		# Skip if product custom
	else
		generate_packages_ks
	fi

	# Create user in kickstart
	cat > ${KS_USER} <<-END
# ${KS_HDR_MAGIC}
# Create users
END
	#  Admin
	#   Make sure again
	set_admin_user
	#   Create kickstart
	kickstart_user \
		--kickstart ${KS_USER} \
		--name ${admin_username} \
		--password ${admin_password}

	#  Other users
	for ((i = 0; i < ${#user_name[@]}; i++ ))
	do
		kickstart_user \
			--kickstart ${KS_USER} \
			--name ${user_name[$i]} \
			--password ${user_password[$i]}
	done

	# Create partition kickstart
	[[ -z $target_disk ]] && target_disk=${smallest_disk}
	if [[ -e ${KS_PARTITION} ]]; then
		if [[ ! -z "$(is_my_ks ${KS_PARTITION})" ]]; then
			# Overwrite exist one
			generate_partition_ks
		fi
		# Replace TARGET_DISK
		sed -i "s|TARGET_DISK|${target_disk}|g" ${KS_PARTITION}
	else
		generate_partition_ks
	fi
}

__usage_dialog__()
{
	result=" \n
 anaconda-pre-dialog [OPT] [params] \n
 \n
 -p,--product       specify a product name(could use to testing) \n
 \n
 -u,--admin-name    specify admin user name, default: ${admin_username} \n
 \n
 --admin-password   specify admin user password \n
 \n
 --menu-network-config \n
                    have \"${MENU_NETWORK_CONFIG}\" \n
 \n
 --menu-adduser     have \"${MENU_ADDUSER}\" \n
 \n
 --append-arg       add arg to cmdline, see get_cmdline() \n
                    (may be listed multiple times) \n
 \n
 -h,--help          show this help info "

	display_result "Usage"
	result=

	exit ${1-0}
}

parse_args()
{
	TEMP=$(getopt \
		--options p:u:h \
		--long product: \
		--long admin-name: \
		--long admin-password: \
		--long menu-adduser \
		--long menu-network-config \
		--long append-arg: \
		--long help \
		-n pre-dialog-ks -- "$@")

	local product

	test $? != 0 && (
		result="Wrong exec getopt"
		display_result "MAIN dialog Program fatal"
		result=
	)

	eval set -- "$TEMP"

	while true; do
		case $1 in
		-p | --product)
			shift
			product=$1
			shift
			;;
		-u | --admin-name)
			shift
			admin_username=$1
			shift
			;;
		--admin-password)
			shift
			admin_password="$1"
			# Check space
			if [[ $(has_space "${admin_password}") != 1 ]]; then
				result="Forbidden space character in password '${admin_password}'."
				display_result "ERROR"
				result=
				exit 1
			fi
			shift
			;;
		--append-arg)
			shift
			add_cmdline $1
			shift
			;;
		--menu-adduser)
			shift
			has_menu_adduser=YES
			;;
		--menu-network-config)
			shift
			has_menu_network_config=YES
			;;
		-h | --help)
			shift
			__usage_dialog__
			;;
		--)
			shift
			break
			;;
		esac
	done

	[[ ! -z ${product} ]] && export BUILDSTAMP_PRODUCT=${product}
}

# Dialog execution must exist
if [[ ! -e /usr/bin/dialog ]]; then
	echo "ERROR: Not found dialog command"
	exit 1
fi

parse_args "$@"

if [[ $(get_cmdline) == *dialog.type=auto* ]]; then
	backtitle=${backtitle}" Auto Mode"
	set_admin_user
else
	__menu_select__
fi

generate_kickstart

apply_modules
