#!/bin/env bpftrace

uretprobe:./plotcake:new_timerfd
{
	printf("%-16ld %-8d %-16s %s\n", nsecs, retval, "new_timerfd()",
	       ustack);
}

uprobe:./plotcake:exec_key_handler
{
	printf("%-16ld %-4c|%-4d %-16s %s\n", nsecs, arg1, arg1,
	       "exec_key_handler()", ustack);
}

uprobe:./plotcake:sig_handler,
uprobe:./plotcake:sig_rd_handler,
uprobe:./plotcake:handle_id
{
	printf("%s %s %d\n", probe, comm, arg0);
}

uretprobe:./plotcake:main,
uretprobe:./plotcake:sig_handler,
uretprobe:./plotcake:sig_rd_handler,
uretprobe:./plotcake:handle_id
{
	printf("%s %s %d\n", probe, comm, retval);
}

tracepoint:syscalls:sys_enter_close
{
	if (comm == "plotcake") {
		printf("%-16ld %-8d %-16s %s\n", nsecs, args->fd, "close()",
		       ustack);
	}
}
