#!/usr/bin/expect -f
set timeout 5

# start program
spawn top

# set window size
trap {
    set rows 30
    set cols 100
    stty rows $rows columns $cols
} WINCH

# wait
expect "top"

# send key
send "1"
expect {
    "%Cpu0" { send_user "Found %Cpu0\n" }
    timeout { send_user "FAIL: for key 1 \n"; exit 1 }
}

# send q
send "q"
expect eof
puts "PASS"
