#!/usr/bin/env bpftrace
/**
 * sudo sysctl kernel.printk
 */

BEGIN
{
	$console_printk = kaddr("console_printk");
	$console_loglevel = *$console_printk;
	$default_message_loglevel = *($console_printk + 4);
	$minimum_console_loglevel = *($console_printk + 8);
	$default_console_loglevel = *($console_printk + 12);

	printf("kernel.printk = %d\t%d\t%d\t%d\n",
		$console_loglevel, $default_message_loglevel,
		$minimum_console_loglevel, $default_console_loglevel);
	exit();
}
