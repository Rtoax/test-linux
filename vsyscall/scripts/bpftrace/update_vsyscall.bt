#!/usr/bin/env bpftrace
/**
 * File: update_vsyscall.bt
 *
 * Author: Rong Tao
 * Date: 2022.05.10
 */
BEGIN
{
	printf("Tracing update_vsyscall, hit ctrl-C to end.\n");
}

kprobe:update_vsyscall
{
	@start[pid] = nsecs;
	// See kernel stack of update_vsyscall().
	//@[kstack] = count();
}

kretprobe:update_vsyscall
/@start[pid]/
{
	@latency_us = hist((nsecs - @start[pid]) / 1000);
	delete(@start[pid]);
}

END
{
	clear(@start);
}

