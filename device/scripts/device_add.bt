#ifndef BPFTRACE_HAVE_BTF
#include <linux/bus.h>
#include <linux/device.h>
#endif

BEGIN
{
	printf("Tracing device_add(), hit ctrl-c to end.\n");
	printf("$ sudo ./device_add.bt [1] to print kstack\n");
	printf("%-8s %-8s %-16s %-16s %-8s\n",
		"TIME", "PID", "COMM", "NAME", "BUS");
}

kprobe:device_add
{
	$dev = (struct device *)arg0;
	$bus = $dev->bus;

	/* If add virtio blk device to VM, init_name is NULL. */
	$name = $dev->init_name;

	if ($name == 0) {
		$name = $dev->kobj.name;
	}

	time("%H:%M:%S ");
	printf("%-8d %-16s %-16s %-8s\n", pid, comm, str($name),
		str($bus->name));

	if ($1 == 1) {
		printf("%s\n", kstack);
	}

	@kstacks[kstack] = count();
}

END
{
	printf("Bye.\n");
}
