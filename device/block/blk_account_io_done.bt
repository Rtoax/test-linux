#ifndef BPFTRACE_HAVE_BTF
#include <linux/blkdev.h>
#endif

BEGIN
{
	printf("Tracing block request, hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s\n", "TIME", "PID", "COMM");
}

kprobe:blk_account_io_done
{
	$req = (struct request *)arg0;
	$cmd_flags = $req->cmd_flags;

	if ($cmd_flags == REQ_OP_READ) {
		@read[comm] = count();
	}
	if ($cmd_flags == REQ_OP_WRITE) {
		@write[comm] = count();
	}
	if ($cmd_flags == REQ_OP_FLUSH) {
		@flush[comm] = count();
	}
	time("%H:%M:%S ");
	printf("%-8d %-16s %-8x\n", pid, comm, $cmd_flags);
}

END
{
	printf("Bye.\n");
}
