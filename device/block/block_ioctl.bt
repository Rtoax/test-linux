	@S_CMD[0x00000000c0484e43] = "NVME_IOCTL_IO_CMD";
	@S_CMD[0x0000000000004e44] = "NVME_IOCTL_RESET";
	@S_CMD[0x0000000000004e45] = "NVME_IOCTL_SUBSYS_RESET";
	@S_CMD[0x0000000000004e46] = "NVME_IOCTL_RESCAN";
