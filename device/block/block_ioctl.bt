	@S_CMD[0x00000000c0504e48] = "NVME_IOCTL_IO64_CMD";

	printf("Tracing block dev ioctl, hit ctrl-c to end.\n");
	printf("%-8s %-16s %-16s %-16s\n", "PID", "COMM", "BLK/DISK", "CMD");
}

/**
 * kernel >= 6.7.0 not support block_ioctl()
 */
kprobe:block_ioctl
{
	$file = (struct file *)arg0;
	$cmd = arg1;

	$dentry = $file->f_path.dentry;
	$name = $dentry->d_name.name;

	if (@S_CMD[$cmd] != "") {
		printf("%-8d %-16s %-16s %-16s\n", pid, comm, str($name), @S_CMD[$cmd]);
		@cnt_cmds_s[comm, str($name), @S_CMD[$cmd]] = count();
	} else {
		printf("%-8d %-16s %-16s %-16lx\n", pid, comm, str($name), $cmd);
		@cnt_cmds[comm, str($name), $cmd] = count();
	}
}

END
{
	clear(@S_CMD);
	printf("Bye.\n");
}
