	@S_CMD[0x000000000000127d] = "BLKSECDISCARD";
	@S_CMD[0x000000000000127e] = "BLKROTATIONAL";
	@S_CMD[0x000000000000127f] = "BLKZEROOUT";
	@S_CMD[0x0000000080081280] = "BLKGETDISKSEQ";
	@S_CMD[0x00000000c0101282] = "BLKREPORTZONE";
	@S_CMD[0x0000000040101283] = "BLKRESETZONE";
	@S_CMD[0x0000000080041284] = "BLKGETZONESZ";
