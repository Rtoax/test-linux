	@S_CMD[0x0000000000005381] = "SCSI_IOCTL_DOORUNLOCK";
	@S_CMD[0x0000000000002285] = "SG_IO";
	@S_CMD[0x0000000000002282] = "SG_GET_VERSION_NUM";
	@S_CMD[0x0000000080086601] = "FS_IOC_GETFLAGS";
	@S_CMD[0x0000000040086602] = "FS_IOC_SETFLAGS";
	@S_CMD[0x0000000080087601] = "FS_IOC_GETVERSION";
	@S_CMD[0x0000000040087602] = "FS_IOC_SETVERSION";
	@S_CMD[0x00000000c020660b] = "FS_IOC_FIEMAP";
	@S_CMD[0x0000000080046601] = "FS_IOC32_GETFLAGS";
