#!/bin/env bpftrace
/**
 * block_ioctl.bt - Tracing block ioctl
 *
 * Copyright (C) Rong Tao 2022-2024
 *
 * 2024-03-27	Rong Tao	Create this.
 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/blkdev.h>
#endif

BEGIN
{
	@S_CMD[0x000000000000125d] = "BLKROSET";
	@S_CMD[0x000000000000125e] = "BLKROGET";
	@S_CMD[0x000000000000125f] = "BLKRRPART";
	@S_CMD[0x0000000000001260] = "BLKGETSIZE";
	@S_CMD[0x0000000000001261] = "BLKFLSBUF";
	@S_CMD[0x0000000000001262] = "BLKRASET";
	@S_CMD[0x0000000000001263] = "BLKRAGET";
	@S_CMD[0x0000000000001264] = "BLKFRASET";
	@S_CMD[0x0000000000001265] = "BLKFRAGET";
	@S_CMD[0x0000000000001266] = "BLKSECTSET";
	@S_CMD[0x0000000000001267] = "BLKSECTGET";
	@S_CMD[0x0000000000001268] = "BLKSSZGET";
	@S_CMD[0x0000000080081270] = "BLKBSZGET";
	@S_CMD[0x0000000040081271] = "BLKBSZSET";
	@S_CMD[0x0000000080081272] = "BLKGETSIZE64";
	@S_CMD[0x00000000c0481273] = "BLKTRACESETUP";
	@S_CMD[0x0000000000001274] = "BLKTRACESTART";
	@S_CMD[0x0000000000001275] = "BLKTRACESTOP";
	@S_CMD[0x0000000000001276] = "BLKTRACETEARDOWN";
	@S_CMD[0x0000000000001277] = "BLKDISCARD";
	@S_CMD[0x0000000000001278] = "BLKIOMIN";
	@S_CMD[0x0000000000001279] = "BLKIOOPT";
	@S_CMD[0x000000000000127a] = "BLKALIGNOFF";
	@S_CMD[0x000000000000127b] = "BLKPBSZGET";
	@S_CMD[0x000000000000127c] = "BLKDISCARDZEROES";
	@S_CMD[0x000000000000127d] = "BLKSECDISCARD";
	@S_CMD[0x000000000000127e] = "BLKROTATIONAL";
	@S_CMD[0x000000000000127f] = "BLKZEROOUT";
	@S_CMD[0x0000000080081280] = "BLKGETDISKSEQ";
	@S_CMD[0x0000000000005382] = "SCSI_IOCTL_GET_IDLUN";
	@S_CMD[0x0000000000005383] = "SCSI_IOCTL_TAGGED_ENABLE";
	@S_CMD[0x0000000000005384] = "SCSI_IOCTL_TAGGED_DISABLE";
	@S_CMD[0x0000000000005385] = "SCSI_IOCTL_PROBE_HOST";
	@S_CMD[0x0000000000005386] = "SCSI_IOCTL_GET_BUS_NUMBER";
	@S_CMD[0x0000000000002285] = "SG_IO";
	@S_CMD[0x0000000000002282] = "SG_GET_VERSION_NUM";

	printf("Tracing block dev ioctl, hit ctrl-c to end.\n");
	printf("%-16s %-16s\n", "BLK/DISK", "CMD");
}

/**
 * kernel >= 6.7.0 not support block_ioctl()
 */
kprobe:block_ioctl
{
	$file = (struct file *)arg0;
	$cmd = arg1;

	$dentry = $file->f_path.dentry;
	$name = $dentry->d_name.name;

	if (@S_CMD[$cmd] != "") {
		printf("%-16s %-16s\n", str($name), @S_CMD[$cmd]);
		@cnt_cmds_s[comm, str($name), @S_CMD[$cmd]] = count();
	} else {
		printf("%-16s %-16lx\n", str($name), $cmd);
		@cnt_cmds[comm, str($name), $cmd] = count();
	}
}

END
{
	clear(@S_CMD);
	printf("Bye.\n");
}
