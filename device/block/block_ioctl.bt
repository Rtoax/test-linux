	@S_CMD[0x0000000040101287] = "BLKCLOSEZONE";
	@S_CMD[0x0000000040101288] = "BLKFINISHZONE";
	@S_CMD[0x0000000000005382] = "SCSI_IOCTL_GET_IDLUN";
	@S_CMD[0x0000000000005383] = "SCSI_IOCTL_TAGGED_ENABLE";
	@S_CMD[0x0000000000005384] = "SCSI_IOCTL_TAGGED_DISABLE";
	@S_CMD[0x0000000000005385] = "SCSI_IOCTL_PROBE_HOST";
	@S_CMD[0x0000000000005386] = "SCSI_IOCTL_GET_BUS_NUMBER";
