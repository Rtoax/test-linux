 */
#ifndef BPFTRACE_HAVE_BTF
#include <linux/binfmts.h>
#endif

BEGIN
{
	printf("Tracing bprm_change_interp(), hit ctrl-c to end.\n");
	printf("%-8s %-8s %-16s %-16s %-16s\n",
		"TIME", "PID", "COMM", "FROM", "TO");
}

kprobe:bprm_change_interp
{
	$bprm = (struct linux_binprm *)arg1;
	$from = str($bprm->interp);
	$to = str(arg0);

	time("%H:%M:%S ");
	printf("%-8d %-16s %-16s %-16s\n", pid, comm, $from, $to);
}

END
{
	printf("Bye.\n");
}
